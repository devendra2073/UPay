<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pay with Upay</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .qr-gradient { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); }
        .modal-overlay { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); }

        /* ---------- Popup entrance ---------- */
        .popup-in { animation: popIn .35s cubic-bezier(.2, 1.2, .4, 1) both; }
        @keyframes popIn { from { opacity: 0; transform: scale(.92) translateY(10px); } to { opacity: 1; transform: none; } }

        /* ---------- Animated badge (success / error) ---------- */
        .badge { width: 96px; height: 96px; margin: 0 auto 16px; }
        .badge svg { width: 100%; height: 100%; overflow: visible; display: block; }
        .b-disc { transform-origin: 50% 50%; animation: discPop .5s cubic-bezier(.2, 1.4, .4, 1) .1s both; }
        .b-ring { fill: none; stroke-width: 2; transform-origin: 50% 50%; opacity: 0; animation: ringPulse 1.3s ease-out .7s 1; }
        .b-draw { fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round;
                  stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw .45s ease-out .5s forwards; }
        .b-draw.d2 { animation-delay: .75s; }
        @keyframes discPop { from { transform: scale(0); } to { transform: scale(1); } }
        @keyframes draw { to { stroke-dashoffset: 0; } }
        @keyframes ringPulse { 0% { opacity: .6; transform: scale(1); } 100% { opacity: 0; transform: scale(1.7); } }

        /* ---------- Success extras ---------- */
        .fade-up { opacity: 0; transform: translateY(6px); animation: fadeUp .4s ease-out forwards; }
        @keyframes fadeUp { to { opacity: 1; transform: none; } }
        .redirect-bar { height: 4px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
        .redirect-bar > span { display: block; height: 100%; width: 0; background: #16a34a; border-radius: 99px; }
        .redirect-bar.run > span { animation: fill 3s linear forwards; }
        @keyframes fill { to { width: 100%; } }

        .bit { position: absolute; top: 90px; left: 50%; width: 8px; height: 12px; border-radius: 2px; opacity: 0; pointer-events: none;
               animation: fall var(--t) cubic-bezier(.15, .7, .4, 1) var(--d) forwards; }
        @keyframes fall { 0% { opacity: 1; transform: translate(0, 0) rotate(0); }
                          100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)); } }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01s !important; animation-delay: 0s !important; }
            .bit { display: none; }
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">

    <div id="payment-card" class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-gray-100 relative">

        <!-- Header Info -->
        <div class="p-4 text-center border-b border-gray-50">
            <div class="flex justify-between items-center mb-4">
                <span class="text-xs font-bold tracking-widest text-indigo-600 uppercase">Upay Gateway</span>
                <span class="text-xs text-gray-400 uppercase tracking-tighter">ID: #<%=tid%></span>
            </div>
            <div class="relative w-15 h-15 mx-auto mb-3">
                <div class="absolute inset-0 bg-indigo-100 rounded-full animate-pulse opacity-50"></div>
                <div class="relative w-15 h-15 bg-white rounded-full flex items-center justify-center border-4 border-white shadow-md overflow-hidden">
                    <img src="<%=logo%>" alt="<%=company%>" class="w-full h-full object-contain" onerror="this.src='https://ui-avatars.com/api/?name=<%=company%>&background=6366f1&color=fff'" />
                </div>
            </div>
            <h2 class="text-lg font-bold text-gray-800 tracking-tight"><%=company%></h2>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">â¹<%=amount.toLocaleString("en-IN",{minimumFractionDigits:2})%></p>
        </div>

        <!-- QR & App Selection Section -->
        <div class="p-4 text-center">
            <p class="text-sm font-medium text-gray-500 mb-3">Scan QR or select an app to pay</p>
            <div class="qr-gradient p-1 inline-block rounded-2xl shadow-lg mb-2">
                <div class="bg-white p-3 rounded-xl">
                    <img id="qr-image" src="<%=obj%>" alt="UPI QR Code" class="w-35 h-35" crossorigin="anonymous">
                </div>
            </div>

            <button onclick="downloadQR()" class="flex items-center justify-center mx-auto mb-6 text-[10px] font-bold text-indigo-500 hover:text-indigo-700 uppercase tracking-widest transition-all active:scale-95 cursor-pointer">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Save QR to Gallery
            </button>

            <div class="space-y-3 text-left">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest text-center mb-4">Select UPI App</p>
                <div class="grid grid-cols-2 gap-3">
                    <a href="<%=intent%>" class="flex items-center p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition active:scale-95">
                        <img src="/assets/gpay.png" class="w-6 h-6 mr-3" alt="GPay">
                        <span class="text-sm font-medium">GPay</span>
                    </a>
                    <a href="<%=phonepe%>" class="flex items-center p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition active:scale-95">
                        <img src="/assets/phonepe.jpeg" class="w-6 h-6 mr-3" alt="PhonePe">
                        <span class="text-sm font-medium">PhonePe</span>
                    </a>
                    <a href="<%=paytmp%>" class="flex items-center p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition active:scale-95">
                        <img src="/assets/paytm.png" class="w-6 h-6 mr-3" alt="Paytm">
                        <span class="text-sm font-medium">Paytm</span>
                    </a>
                    <a href="<%=intent%>" class="flex items-center p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition active:scale-95">
                        <img src="/assets/bhim.png" class="w-6 h-6 mr-3" alt="BHIM">
                        <span class="text-sm font-medium">BHIM</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer / Timer -->
        <div class="bg-gray-50 p-4 flex justify-between items-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">
            <div class="flex items-center">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                Secure Transaction
            </div>
            <div class="flex items-center text-red-500">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Expires in <span id="timer" class="ml-1">05:00</span>
            </div>
        </div>

        <!-- Overlays (Success / Timeout / Failed) -->
        <div id="popup-overlay" class="hidden absolute inset-0 modal-overlay z-50 flex items-center justify-center p-6" role="dialog" aria-live="assertive">

            <!-- Success Popup -->
            <div id="success-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full shadow-2xl relative overflow-hidden">
                <div id="confetti"></div>
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#16a34a"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#16a34a"/>
                        <path class="b-draw" d="M30 50 L43 63 L67 36"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Payment successful</h3>
                <p class="text-3xl font-extrabold text-gray-900 mt-3 tabular-nums">â¹<span id="success-amount">0.00</span></p>
                <p class="text-gray-500 text-sm mt-2 fade-up" style="animation-delay:.9s">Transfer verified. Taking you back to <%=company%>â¦</p>
                <p class="text-gray-400 text-xs mt-3 fade-up" style="animation-delay:1.1s"><b>UTR:</b> <span id="utr" class="font-mono text-gray-700"></span></p>
                <div id="redirect-bar" class="redirect-bar mt-5"><span></span></div>
            </div>

            <!-- Timeout Popup -->
            <div id="timeout-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M32 32 L64 64"/>
                        <path class="b-draw d2" d="M64 32 L32 64"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Time's up</h3>
                <p class="text-gray-500 text-sm mt-2">For your security, this session has expired. Refresh to get a new QR code.</p>
                <button onclick="location.reload()" class="mt-6 w-full py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition cursor-pointer">Refresh page</button>
            </div>

            <!-- Failed Popup -->
            <div id="failed-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M48 28 L48 52"/>
                        <path class="b-draw d2" d="M48 65 L48 66"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Payment failed</h3>
                <p id="failed-message" class="text-gray-500 text-sm mt-2">Transaction could not be completed.</p>
                <button onclick="location.reload()" class="mt-6 w-full py-3 bg-gray-800 text-white rounded-xl font-bold hover:bg-gray-900 transition cursor-pointer">Try again</button>
            </div>

        </div>
    </div>

    <script>
        let pollTimer = null;
        let isPollingStopped = false;
        let timeInSeconds = 300;

        const AMOUNT = Number("<%=amount%>") || 0;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const doneSound = new Audio("/assets/done.mp3");

        const timerElement = document.getElementById('timer');
        const overlay = document.getElementById('popup-overlay');
        const popups = {
            timeout: document.getElementById('timeout-popup'),
            success: document.getElementById('success-popup'),
            failed: document.getElementById('failed-popup')
        };

        // 1. Timer Countdown
        const countdown = setInterval(() => {
            const minutes = Math.floor(timeInSeconds / 60);
            const seconds = timeInSeconds % 60;
            timerElement.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            if (timeInSeconds <= 0) {
                stopPolling();
                showPopup('timeout');
                return;
            }
            timeInSeconds--;
        }, 1000);

        function showPopup(type) {
            Object.values(popups).forEach(p => p.classList.add('hidden'));
            overlay.classList.remove('hidden');
            popups[type].classList.remove('hidden');
            if (type === 'success') playSuccess();
        }

        function stopPolling() {
            isPollingStopped = true;
            if (pollTimer) clearTimeout(pollTimer);
            clearInterval(countdown);
        }

        // Success animation: count-up amount, confetti, redirect progress bar
        function playSuccess() {
            const out = document.getElementById('success-amount');
            const fmt = v => v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('redirect-bar').classList.add('run');

            if (reduceMotion) { out.textContent = fmt(AMOUNT); return; }

            const start = performance.now(), delay = 500, dur = 1000;
            (function tick(now) {
                const p = Math.min(Math.max((now - start - delay) / dur, 0), 1);
                out.textContent = fmt(AMOUNT * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(tick);
            })(start);

            const box = document.getElementById('confetti');
            const colors = ['#16a34a', '#4ade80', '#f59e0b', '#6366f1', '#ef4444'];
            for (let i = 0; i < 26; i++) {
                const b = document.createElement('span');
                b.className = 'bit';
                const a = (Math.PI * 2 * i / 26) + Math.random() * .4;
                const d = 90 + Math.random() * 110;
                b.style.background = colors[i % colors.length];
                b.style.setProperty('--x', Math.cos(a) * d + 'px');
                b.style.setProperty('--y', (Math.sin(a) * d * .8 + 60) + 'px');
                b.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
                b.style.setProperty('--t', (1.1 + Math.random() * .6) + 's');
                b.style.setProperty('--d', (.6 + Math.random() * .1) + 's');
                box.appendChild(b);
            }
        }

        // 2. QR Code Image Download
        async function downloadQR() {
            const img = document.getElementById('qr-image');
            try {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = img.naturalWidth || 500;
                canvas.height = img.naturalHeight || 500;
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                const link = document.createElement('a');
                link.href = canvas.toDataURL('image/png');
                link.download = `Upay_QR_${Date.now()}.png`;
                link.click();
            } catch (err) {
                const link = document.createElement('a');
                link.href = img.src;
                link.download = 'payment_qr.png';
                link.click();
            }
        }

        // 3. Reliable Recursive Polling
        const checkPaymentStatus = async () => {
            if (isPollingStopped) return;

            try {
                const response = await fetch("/pay/status/<%=tid%>");
                const data = await response.json();

                // Payment SUCCESS
                if (data.status === true || data.state === "SUCCESS") {
                    stopPolling();
                    document.getElementById("utr").innerText = data.utr || "Verified";
                    showPopup("success");
                    doneSound.play().catch(() => {}); // browsers may block autoplay

                    setTimeout(() => {
                        location.href = "<%=redirect%>";
                    }, 3000);
                    return;
                }

                // Payment FAILED
                if (data.state === "FAILED") {
                    stopPolling();
                    document.getElementById("failed-message").innerText = data.message || "Payment was rejected or cancelled.";
                    showPopup("failed");
                    return;
                }

            } catch (e) {
                console.error("Polling network error:", e);
            }

            // Next call only fires after the previous one has completed
            if (!isPollingStopped) {
                pollTimer = setTimeout(checkPaymentStatus, 3000);
            }
        };

        // Start polling 2 seconds after page load
        pollTimer = setTimeout(checkPaymentStatus, 2000);
    </script>
</body>
</html>
