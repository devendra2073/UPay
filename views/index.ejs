<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pay with Upay</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f1f5f9; }
        .qr-gradient { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); }
        .modal-overlay { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); }

        /* ---------- Popup entrance ---------- */
        .popup-in { animation: popIn .35s cubic-bezier(.2, 1.2, .4, 1) both; }
        @keyframes popIn { 
            from { opacity: 0; transform: scale(.92) translateY(10px); } 
            to { opacity: 1; transform: none; } 
        }

        /* ---------- Animated badge (success / error) ---------- */
        .badge { width: 96px; height: 96px; margin: 0 auto 16px; }
        .badge svg { width: 100%; height: 100%; overflow: visible; display: block; }
        .b-disc { transform-origin: 50% 50%; animation: discPop .5s cubic-bezier(.2, 1.4, .4, 1) .1s both; }
        .b-ring { fill: none; stroke-width: 2; transform-origin: 50% 50%; opacity: 0; animation: ringPulse 1.3s ease-out .7s 1; }
        .b-draw { 
            fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round;
            stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw .45s ease-out .5s forwards; 
        }
        .b-draw.d2 { animation-delay: .75s; }
        @keyframes discPop { from { transform: scale(0); } to { transform: scale(1); } }
        @keyframes draw { to { stroke-dashoffset: 0; } }
        @keyframes ringPulse { 0% { opacity: .6; transform: scale(1); } 100% { opacity: 0; transform: scale(1.7); } }

        /* ---------- Success extras ---------- */
        .fade-up { opacity: 0; transform: translateY(6px); animation: fadeUp .4s ease-out forwards; }
        @keyframes fadeUp { to { opacity: 1; transform: none; } }
        .redirect-bar { height: 4px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
        .redirect-bar > span { display: block; height: 100%; width: 0; background: #16a34a; border-radius: 99px; }
        .redirect-bar.run > span { animation: fill 3s linear forwards; }
        @keyframes fill { to { width: 100%; } }

        .bit { 
            position: absolute; top: 90px; left: 50%; width: 8px; height: 12px; border-radius: 2px; opacity: 0; pointer-events: none;
            animation: fall var(--t) cubic-bezier(.15, .7, .4, 1) var(--d) forwards; 
        }
        @keyframes fall { 
            0% { opacity: 1; transform: translate(0, 0) rotate(0); }
            100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)); } 
        }

        /* ---------- Custom Illustration Animations ---------- */
        .float-anim { animation: floatSlow 4s ease-in-out infinite; }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .pulse-subtle { animation: pulseGlow 3s ease-in-out infinite; }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        .signal-wave {
            stroke-dasharray: 8;
            animation: dashWave 1.8s linear infinite;
        }
        @keyframes dashWave {
            to { stroke-dashoffset: -16; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01s !important; animation-delay: 0s !important; }
            .bit { display: none; }
            .float-anim, .pulse-subtle, .signal-wave { animation: none !important; }
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-3 sm:p-6 lg:p-10">

    <!-- Payment Container: Single card on mobile, Split side-by-side on lg: desktop -->
    <div id="payment-card" class="bg-white w-full max-w-md lg:max-w-4xl rounded-3xl shadow-2xl overflow-hidden border border-gray-100 relative transition-all">

        <div class="lg:grid lg:grid-cols-12 min-h-[580px]">

            <!-- Left Panel / Desktop Context & Illustration Column -->
            <div class="lg:col-span-5 bg-gradient-to-b from-slate-50 via-indigo-50/30 to-purple-50/20 p-6 sm:p-8 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-gray-100">
                <div>
                    <!-- Header Info -->
                    <div class="flex justify-between items-center mb-6">
                        <span class="text-xs font-bold tracking-widest text-indigo-600 uppercase">Upay Gateway</span>
                        <span class="text-xs text-gray-400 uppercase tracking-tight">ID: #<%=tid%></span>
                    </div>

                    <div class="text-center lg:text-left">
                        <div class="relative w-16 h-16 mx-auto lg:mx-0 mb-3">
                            <div class="absolute inset-0 bg-indigo-100 rounded-full animate-pulse opacity-50"></div>
                            <div class="relative w-16 h-16 bg-white rounded-full flex items-center justify-center border-2 border-indigo-50 shadow-sm overflow-hidden">
                                <img 
                                    src="<%=logo%>" 
                                    alt="<%=company%>" 
                                    class="w-full h-full object-contain p-1" 
                                    onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('<%=company%>') + '&background=6366f1&color=fff'" 
                                />
                            </div>
                        </div>

                        <h2 class="text-lg font-bold text-gray-800 tracking-tight"><%=company%></h2>
                        <p class="text-3xl font-extrabold text-gray-900 mt-1">
                            &#8377;<%= Number(amount).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </p>
                    </div>
                </div>

                <!-- Animated Payment Illustration (Visible prominently on desktop) -->
                <div class="hidden lg:flex flex-col items-center justify-center my-6 relative py-4">
                    <svg class="w-56 h-44 drop-shadow-md" viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background glow aura -->
                        <ellipse class="pulse-subtle" cx="140" cy="115" rx="85" ry="40" fill="#e0e7ff"/>
                        
                        <!-- Floating Base / Card -->
                        <g class="float-anim">
                            <rect x="40" y="55" width="130" height="85" rx="12" fill="#4f46e5" fill-opacity="0.95"/>
                            <rect x="40" y="75" width="130" height="18" fill="#3730a3"/>
                            <circle cx="65" cy="112" r="7" fill="#fcd34d"/>
                            <circle cx="80" cy="112" r="7" fill="#f87171" fill-opacity="0.8"/>
                            <rect x="105" y="108" width="45" height="7" rx="3.5" fill="#c7d2fe"/>
                        </g>

                        <!-- Mobile Device Floating -->
                        <g transform="translate(130, 20)">
                            <rect x="0" y="0" width="90" height="145" rx="16" fill="#1e1b4b"/>
                            <rect x="5" y="6" width="80" height="133" rx="12" fill="#ffffff"/>
                            <rect x="35" y="9" width="20" height="3" rx="1.5" fill="#cbd5e1"/>
                            
                            <!-- Scanner target on screen -->
                            <rect x="18" y="28" width="54" height="54" rx="8" fill="#f8fafc" stroke="#818cf8" stroke-width="1.5" stroke-dasharray="3 3"/>
                            <path class="signal-wave" d="M24 55 H66" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                            
                            <!-- Success indicator pill -->
                            <rect x="15" y="94" width="60" height="16" rx="8" fill="#dcfce7"/>
                            <circle cx="24" cy="102" r="4" fill="#16a34a"/>
                            <rect x="33" y="100" width="34" height="4" rx="2" fill="#15803d"/>
                        </g>

                        <!-- Floating Shield Badge -->
                        <g transform="translate(100, 95)" class="float-anim" style="animation-delay: -1.8s;">
                            <circle cx="20" cy="20" r="18" fill="#ffffff" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.1))"/>
                            <path d="M20 10 L28 14 V20 C28 25 24 28 20 30 C16 28 12 25 12 20 V14 L20 10 Z" fill="#6366f1"/>
                            <path d="M17 20 L19 22 L23 18" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </g>
                    </svg>
                    <span class="text-xs font-semibold text-slate-500 mt-2">End-to-end UPI encrypted</span>
                </div>

                <!-- Desktop Helper Notes -->
                <div class="hidden lg:block text-xs text-gray-500 space-y-2 pt-4 border-t border-gray-200/60">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        <span>Verified Merchant Gateway</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                        <span>Instant auto-confirmation</span>
                    </div>
                </div>
            </div>

            <!-- Right Panel / Interactive Action Section -->
            <div class="lg:col-span-7 flex flex-col justify-between">
                
                <!-- QR & App Selection Section -->
                <div class="p-6 sm:p-8 text-center flex-1 flex flex-col justify-center">
                    <p class="text-sm font-medium text-gray-500 mb-4">Scan QR code or open a payment app</p>
                    
                    <div class="qr-gradient p-1.5 inline-block rounded-2xl shadow-lg mb-3 mx-auto">
                        <div class="bg-white p-3 rounded-xl">
                            <img id="qr-image" src="<%=obj%>" alt="UPI QR Code" class="w-36 h-36 sm:w-44 sm:h-44 object-contain" crossorigin="anonymous">
                        </div>
                    </div>

                    <button type="button" onclick="downloadQR()" class="flex items-center justify-center mx-auto mb-6 text-[11px] font-bold text-indigo-600 hover:text-indigo-800 uppercase tracking-wider transition-all active:scale-95 cursor-pointer">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        Save QR to Gallery
                    </button>

                    <div class="space-y-3 text-left max-w-sm mx-auto w-full">
                        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest text-center mb-3">Select UPI App</p>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="<%=intent%>" class="flex items-center p-3 border border-gray-200/80 rounded-xl hover:bg-gray-50/80 hover:border-indigo-200 transition active:scale-95">
                                <img src="/assets/gpay.png" class="w-6 h-6 mr-3 object-contain" alt="GPay" onerror="this.style.display='none'">
                                <span class="text-sm font-medium text-gray-700">GPay</span>
                            </a>
                            <a href="<%=phonepe%>" class="flex items-center p-3 border border-gray-200/80 rounded-xl hover:bg-gray-50/80 hover:border-indigo-200 transition active:scale-95">
                                <img src="/assets/phonepe.jpeg" class="w-6 h-6 mr-3 object-contain" alt="PhonePe" onerror="this.style.display='none'">
                                <span class="text-sm font-medium text-gray-700">PhonePe</span>
                            </a>
                            <a href="<%=paytmp%>" class="flex items-center p-3 border border-gray-200/80 rounded-xl hover:bg-gray-50/80 hover:border-indigo-200 transition active:scale-95">
                                <img src="/assets/paytm.png" class="w-6 h-6 mr-3 object-contain" alt="Paytm" onerror="this.style.display='none'">
                                <span class="text-sm font-medium text-gray-700">Paytm</span>
                            </a>
                            <a href="<%=intent%>" class="flex items-center p-3 border border-gray-200/80 rounded-xl hover:bg-gray-50/80 hover:border-indigo-200 transition active:scale-95">
                                <img src="/assets/bhim.png" class="w-6 h-6 mr-3 object-contain" alt="BHIM" onerror="this.style.display='none'">
                                <span class="text-sm font-medium text-gray-700">BHIM</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Footer / Timer -->
                <div class="bg-gray-50 px-6 sm:px-8 py-4 flex justify-between items-center text-[11px] font-semibold text-gray-500 uppercase tracking-wider border-t border-gray-100">
                    <div class="flex items-center">
                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                        Secure Transaction
                    </div>
                    <div class="flex items-center text-rose-500">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Expires in <span id="timer" class="ml-1 font-mono">05:00</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Overlays (Success / Timeout / Failed) -->
        <div id="popup-overlay" class="hidden absolute inset-0 modal-overlay z-50 flex items-center justify-center p-6" role="dialog" aria-modal="true" aria-live="assertive">

            <!-- Success Popup -->
            <div id="success-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl relative overflow-hidden">
                <div id="confetti"></div>
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#16a34a"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#16a34a"/>
                        <path class="b-draw" d="M30 50 L43 63 L67 36"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Payment Successful</h3>
                <p class="text-3xl font-extrabold text-gray-900 mt-3 tabular-nums">&#8377;<span id="success-amount">0.00</span></p>
                <p class="text-gray-500 text-sm mt-2 fade-up" style="animation-delay:.9s">Transfer verified. Taking you back to <%=company%>…</p>
                <p class="text-gray-400 text-xs mt-3 fade-up" style="animation-delay:1.1s"><b>UTR:</b> <span id="utr" class="font-mono text-gray-700"></span></p>
                <div id="redirect-bar" class="redirect-bar mt-5"><span></span></div>
            </div>

            <!-- Timeout Popup -->
            <div id="timeout-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M32 32 L64 64"/>
                        <path class="b-draw d2" d="M64 32 L32 64"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Time's Up</h3>
                <p class="text-gray-500 text-sm mt-2">For your security, this session has expired. Refresh to generate a new QR code.</p>
                <button type="button" onclick="location.reload()" class="mt-6 w-full py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition cursor-pointer">Refresh Page</button>
            </div>

            <!-- Failed Popup -->
            <div id="failed-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M48 28 L48 52"/>
                        <path class="b-draw d2" d="M48 65 L48 66"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Payment Failed</h3>
                <p id="failed-message" class="text-gray-500 text-sm mt-2">Transaction could not be completed.</p>
                <button type="button" onclick="location.reload()" class="mt-6 w-full py-3 bg-gray-800 text-white rounded-xl font-bold hover:bg-gray-900 transition cursor-pointer">Try Again</button>
            </div>

        </div>
    </div>

    <script>
        let pollTimer = null;
        let isPollingStopped = false;
        let timeInSeconds = 300;

        const AMOUNT = Number("<%=amount%>") || 0;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const doneSound = new Audio("/assets/done.mp3");

        const timerElement = document.getElementById('timer');
        const overlay = document.getElementById('popup-overlay');
        const popups = {
            timeout: document.getElementById('timeout-popup'),
            success: document.getElementById('success-popup'),
            failed: document.getElementById('failed-popup')
        };

        // Unlock audio on first user gesture (satisfies mobile Safari/Chrome autoplay policies)
        const unlockAudio = () => {
            doneSound.load();
            window.removeEventListener('click', unlockAudio);
            window.removeEventListener('touchstart', unlockAudio);
        };
        window.addEventListener('click', unlockAudio, { once: true });
        window.addEventListener('touchstart', unlockAudio, { once: true });

        // 1. Timer Countdown
        const countdown = setInterval(() => {
            const minutes = Math.floor(timeInSeconds / 60);
            const seconds = timeInSeconds % 60;
            timerElement.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            if (timeInSeconds <= 0) {
                stopPolling();
                showPopup('timeout');
                return;
            }
            timeInSeconds--;
        }, 1000);

        function showPopup(type) {
            Object.values(popups).forEach(p => p.classList.add('hidden'));
            overlay.classList.remove('hidden');
            popups[type].classList.remove('hidden');
            if (type === 'success') playSuccess();
        }

        function stopPolling() {
            isPollingStopped = true;
            if (pollTimer) clearTimeout(pollTimer);
            clearInterval(countdown);
        }

        // Success animation: count-up amount, confetti, redirect progress bar
        function playSuccess() {
            const out = document.getElementById('success-amount');
            const fmt = v => v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('redirect-bar').classList.add('run');

            if (reduceMotion) {
                out.textContent = fmt(AMOUNT);
                return;
            }

            const start = performance.now(), delay = 500, dur = 1000;
            (function tick(now) {
                const p = Math.min(Math.max((now - start - delay) / dur, 0), 1);
                out.textContent = fmt(AMOUNT * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(tick);
            })(start);

            const box = document.getElementById('confetti');
            const colors = ['#16a34a', '#4ade80', '#f59e0b', '#6366f1', '#ef4444'];
            for (let i = 0; i < 26; i++) {
                const b = document.createElement('span');
                b.className = 'bit';
                const a = (Math.PI * 2 * i / 26) + Math.random() * .4;
                const d = 90 + Math.random() * 110;
                b.style.background = colors[i % colors.length];
                b.style.setProperty('--x', Math.cos(a) * d + 'px');
                b.style.setProperty('--y', (Math.sin(a) * d * .8 + 60) + 'px');
                b.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
                b.style.setProperty('--t', (1.1 + Math.random() * .6) + 's');
                b.style.setProperty('--d', (.6 + Math.random() * .1) + 's');
                box.appendChild(b);
            }
        }

        // 2. Cross-origin Safe QR Download
        async function downloadQR() {
            const img = document.getElementById('qr-image');
            const fileName = `Payment_QR_${Date.now()}.png`;

            try {
                const response = await fetch(img.src);
                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(blobUrl);
            } catch (err) {
                // Fallback for strict CORS headers on image source
                const link = document.createElement('a');
                link.href = img.src;
                link.target = '_blank';
                link.download = fileName;
                link.click();
            }
        }

        // 3. Reliable Recursive Polling
        const checkPaymentStatus = async () => {
            if (isPollingStopped) return;

            try {
                const response = await fetch("/pay/status/<%=tid%>");
                const data = await response.json();

                // Payment SUCCESS
                if (data.status === true || data.state === "SUCCESS") {
                    stopPolling();
                    document.getElementById("utr").innerText = data.utr || "Verified";
                    showPopup("success");
                    doneSound.play().catch(() => {});

                    setTimeout(() => {
                        location.href = "<%=redirect%>";
                    }, 3000);
                    return;
                }

                // Payment FAILED
                if (data.state === "FAILED") {
                    stopPolling();
                    document.getElementById("failed-message").innerText = data.message || "Payment was rejected or cancelled.";
                    showPopup("failed");
                    return;
                }

            } catch (e) {
                console.warn("Polling network retry:", e);
            }

            if (!isPollingStopped) {
                pollTimer = setTimeout(checkPaymentStatus, 3000);
            }
        };

        // Initialize polling after 2 seconds
        pollTimer = setTimeout(checkPaymentStatus, 2000);
    </script>
</body>
</html>
