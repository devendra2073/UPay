<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <%- include('partials/seo', {
        pageTitle: `Pay ₹${Number(amount).toLocaleString('en-IN')} to ${company} | UPay 2.0 Secure UPI Checkout`,
        pageDesc: `Complete your instant UPI payment of ₹${Number(amount).toLocaleString('en-IN')} to ${company} (Order #${tid}) via UPay 2.0 256-bit encrypted QR.`,
        canonicalUrl: `https://u-pay-seven.vercel.app/pay/${tid}`
    }) %>
    <!-- Minimal Animated Money Loader (No Voice Announcement!) -->
    <script src="/js/money-loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.6.1/toastify.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

    <%
      const cfg = typeof checkoutConfig !== 'undefined' ? checkoutConfig : {};
      const cTheme = cfg.customTheme || { primary: '#5f259f', secondary: '#7c3aed', surface: '#ffffff', background: '#f5f0ff', text: '#0f172a', radius: '24px' };
      const rawTheme = typeof selectedTheme !== 'undefined' ? selectedTheme : (cfg.defaultTheme || 'upay2');
      const initTheme = rawTheme === 'phonepe' ? 'upay2' : rawTheme;
    %>

    <style>
        :root {
            --theme-primary: #5f259f;
            --theme-secondary: #7c3aed;
            --theme-bg: #f5f0ff;
            --theme-surface: #ffffff;
            --theme-text: #0f172a;
            --theme-muted: #64748b;
            --theme-border: rgba(95, 37, 159, 0.14);
            --theme-radius: 24px;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--theme-bg);
            color: var(--theme-text);
            min-height: 100vh;
            transition: background 0.35s ease, color 0.35s ease;
        }

        .mono { font-family: 'JetBrains Mono', monospace; }

        .theme-card {
            background: var(--theme-surface);
            color: var(--theme-text);
            border: 1px solid var(--theme-border);
            border-radius: var(--theme-radius);
            box-shadow: 0 24px 60px -15px rgba(15, 23, 42, 0.14), 0 0 0 1px rgba(95, 37, 159, 0.05);
            transition: background 0.35s ease, color 0.35s ease, border-radius 0.3s ease, border-color 0.3s ease;
        }

        .theme-header-banner {
            background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
            color: #ffffff;
        }

        .theme-btn-primary {
            background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
            color: #ffffff;
            box-shadow: 0 12px 28px -8px var(--theme-primary);
            transition: all 0.22s ease;
        }
        .theme-btn-primary:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }
        .theme-btn-primary:active {
            transform: scale(0.98);
        }

        .theme-qr-frame {
            background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
            padding: 10px;
            border-radius: 28px;
            box-shadow: 0 18px 40px -12px rgba(95, 37, 159, 0.35);
        }

        .theme-badge-soft {
            background: color-mix(in srgb, var(--theme-primary) 10%, transparent);
            color: var(--theme-primary);
            border: 1px solid color-mix(in srgb, var(--theme-primary) 22%, transparent);
        }

        .scan-laser {
            position: absolute;
            left: 12px;
            right: 12px;
            height: 2.5px;
            background: linear-gradient(90deg, transparent, var(--theme-primary), #10b981, var(--theme-secondary), transparent);
            box-shadow: 0 0 12px var(--theme-primary);
            animation: laserSweep 2.6s ease-in-out infinite;
            pointer-events: none;
        }
        @keyframes laserSweep {
            0%, 100% { top: 14px; opacity: 0.75; }
            50% { top: calc(100% - 16px); opacity: 1; }
        }

        .popup-in { animation: popIn .35s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }
        @keyframes popIn {
            from { opacity: 0; transform: scale(.92) translateY(12px); }
            to { opacity: 1; transform: none; }
        }

        .redirect-bar { height: 5px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
        .redirect-bar > span { display: block; height: 100%; width: 0; background: #00b970; border-radius: 99px; }
        .redirect-bar.run > span { animation: fillBar 3.5s linear forwards; }
        @keyframes fillBar { to { width: 100%; } }

        .bit {
            position: absolute; top: 80px; left: 50%; width: 8px; height: 12px; border-radius: 2px; opacity: 0; pointer-events: none;
            animation: fall var(--t) cubic-bezier(.15, .7, .4, 1) var(--d) forwards;
        }
        @keyframes fall {
            0% { opacity: 1; transform: translate(0, 0) rotate(0); }
            100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)); }
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-3 sm:p-5 lg:p-8 relative overflow-x-hidden">

    <!-- ================================================================= -->
    <!-- TOP FLOATING UPay 2.0 TOOLBAR: THEME SWITCHER (7 THEMES) + LANG   -->
    <!-- ================================================================= -->
    <div class="w-full max-w-4xl mb-3 flex flex-wrap items-center justify-between gap-2 z-20 px-1">
        <!-- Brand & Security Pill -->
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl theme-header-banner flex items-center justify-center font-black text-sm shadow-sm">
                &#8377;
            </div>
            <div>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-extrabold tracking-tight">UPay 2.0</span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-emerald-500/15 text-emerald-600 border border-emerald-500/25">Verified Gateway</span>
                </div>
                <p class="text-[10px] opacity-65"><%= (cfg.tagline || 'UPay 2.0 • 100% Safe & Instant UPI Checkout').replace(/PhonePe/gi, 'UPay 2.0') %></p>
            </div>
        </div>

        <!-- Theme Bar (7 Presets + Customizer Button) & Language Selector -->
        <div class="flex flex-wrap items-center gap-1.5 bg-white/85 backdrop-blur-md px-2.5 py-1.5 rounded-2xl border border-black/5 shadow-xs">
            <% if (cfg.allowCustomerThemeChange !== false) { %>
            <div class="flex items-center gap-1 pr-1.5 border-r border-slate-200" title="Switch Payment Page Theme">
                <button type="button" onclick="CheckoutApp.applyTheme('upay2')" class="w-5 h-5 rounded-full bg-[#5f259f] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="UPay 2.0 Royal Purple"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('midnight')" class="w-5 h-5 rounded-full bg-[#0f172a] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Midnight Dark"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('emerald')" class="w-5 h-5 rounded-full bg-[#059669] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Emerald Mint"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('gold')" class="w-5 h-5 rounded-full bg-[#d97706] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Royal Gold"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('ocean')" class="w-5 h-5 rounded-full bg-[#0284c7] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Oceanic Cyan"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('rose')" class="w-5 h-5 rounded-full bg-[#e11d48] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Rose Sunset"></button>
                <button type="button" onclick="CheckoutApp.applyTheme('monochrome')" class="w-5 h-5 rounded-full bg-[#27272a] border-2 border-white shadow-xs hover:scale-110 transition cursor-pointer" title="Minimal Monochrome"></button>
            </div>
            <% } %>

            <% if (cfg.allowCustomTheme !== false) { %>
            <button type="button" onclick="CheckoutApp.toggleModal('custom-theme-modal', true)" class="px-2.5 py-1 rounded-xl text-[11px] font-extrabold text-[#5f259f] bg-purple-50 hover:bg-purple-100 transition cursor-pointer flex items-center gap-1">
                <span>🎨 Customize</span>
            </button>
            <% } %>

            <!-- Multi-Language Toggle (EN / HI / Hinglish) -->
            <select id="lang-select" onchange="CheckoutApp.setLanguage(this.value)" class="text-[11px] font-extrabold bg-slate-100 text-slate-700 rounded-xl px-2 py-1 outline-none cursor-pointer">
                <option value="en">EN</option>
                <option value="hi">हिन्दी</option>
                <option value="hinglish">Hinglish</option>
            </select>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- MAIN UPay 2.0 CHECKOUT CARD                                       -->
    <!-- ================================================================= -->
    <main class="w-full max-w-4xl theme-card overflow-hidden relative z-10">

        <!-- UPay 2.0 Top Merchant Header Banner -->
        <div class="theme-header-banner p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-2xl bg-white p-1.5 shadow-lg shrink-0 flex items-center justify-center overflow-hidden">
                    <img src="<%=logo%>" alt="<%=company%>" class="w-full h-full object-contain"
                        onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('<%=company%>') + '&background=5f259f&color=fff'" />
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white"><%=company%></h1>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-400/20 text-emerald-200 text-[10px] font-extrabold border border-emerald-300/30">
                            ✓ UPay 2.0 Verified
                        </span>
                    </div>
                    <p class="text-xs text-white/80 font-mono mt-0.5">Order ID: #<%=tid%> • Payer: <span id="header-payer-name" class="font-bold text-white"><%=customerName%></span></p>
                </div>
            </div>

            <!-- Live Total Payable Display -->
            <div class="sm:text-right bg-black/15 backdrop-blur-xs px-4 py-2.5 rounded-2xl border border-white/15">
                <span data-i18n="totalPayable" class="text-[10px] font-extrabold uppercase tracking-widest text-white/75 block">Total Payable</span>
                <div class="flex items-baseline sm:justify-end gap-1">
                    <span class="text-2xl sm:text-3xl font-black text-white tabular-nums">&#8377;<span id="live-amount-display"><%= Number(amount).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span></span>
                </div>
                <button type="button" onclick="CheckoutApp.toggleBreakdown()" class="text-[10px] font-bold text-white/85 underline hover:text-white cursor-pointer">
                    View Price & Multi-Currency Breakdown &darr;
                </button>
            </div>
        </div>

        <!-- Expandable Price & Multi-Currency Transparency Breakdown Bar -->
        <div id="price-breakdown-drawer" class="hidden bg-slate-900 text-slate-200 px-6 py-3.5 text-xs border-b border-slate-800">
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block">Base Order</span>
                    <span class="font-bold mono">&#8377;<span id="brk-base"><%=Number(baseAmount || amount).toFixed(2)%></span></span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block">Promo Savings</span>
                    <span class="font-bold mono text-emerald-400">-&#8377;<span id="brk-discount"><%=Number(discountAmount || 0).toFixed(2)%></span></span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block">Gratuity / Tip</span>
                    <span class="font-bold mono text-amber-300">+&#8377;<span id="brk-tip"><%=Number(tipAmount || 0).toFixed(2)%></span></span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block">Gateway Fee</span>
                    <span class="font-bold mono">+&#8377;<span id="brk-fee"><%=Number(feeAmount || 0).toFixed(2)%></span></span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block">Intl Approx (USD/EUR)</span>
                    <span class="font-bold mono text-purple-300" id="brk-fx">$<%=(Number(amount) / 84).toFixed(2)%> / €<%=(Number(amount) / 91).toFixed(2)%></span>
                </div>
            </div>
        </div>

        <!-- 2-Column Checkout Body -->
        <div class="grid grid-cols-1 lg:grid-cols-12">

            <!-- LEFT COLUMN: QR SCANNER + SUPPORTED UPI APP LOGOS + DISPUTE/UTR (7 COLS) -->
            <div class="lg:col-span-7 p-5 sm:p-7 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-slate-200/60">

                <!-- Top Status & Timer Pill -->
                <div class="flex items-center justify-between gap-2 mb-5">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold theme-badge-soft">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        <span data-i18n="scanPrompt">Scan QR with Any UPI App to Pay</span>
                    </span>

                    <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 text-rose-600 border border-rose-200/70 text-xs font-extrabold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span id="timer" class="mono">05:00</span>
                        <button type="button" onclick="CheckoutApp.refreshQrSession()" title="Extend Session / Regenerate QR without Reload" class="ml-1 text-[10px] underline hover:text-rose-800 cursor-pointer">Extend</button>
                    </div>
                </div>

                <!-- Centerpiece Dynamic QR with Animated Laser Sweep -->
                <div class="flex flex-col items-center my-2">
                    <div class="theme-qr-frame relative transform hover:scale-[1.01] transition duration-300">
                        <div class="bg-white p-3.5 rounded-2xl relative overflow-hidden">
                            <div class="scan-laser"></div>
                            <img id="qr-image" src="<%=obj%>" alt="UPay 2.0 Dynamic UPI QR Code" class="w-48 h-48 sm:w-52 sm:h-52 object-contain mx-auto" crossorigin="anonymous">
                        </div>
                    </div>

                    <!-- QR Utility Buttons: Download QR, Copy UPI ID, Copy Amount -->
                    <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
                        <button type="button" onclick="CheckoutApp.downloadQR()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-extrabold flex items-center gap-1.5 transition cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            <span data-i18n="downloadQr">Save QR</span>
                        </button>
                        <button type="button" onclick="CheckoutApp.copyText('<%=upi%>', 'Merchant UPI ID Copied!')" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-extrabold mono transition cursor-pointer">
                            Copy VPA: <%=upi%>
                        </button>
                        <button type="button" onclick="CheckoutApp.copyText(CheckoutApp.state.amount, 'Exact Amount Copied!')" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-extrabold transition cursor-pointer">
                            Copy &#8377;<span id="copy-amt-btn"><%=amount%></span>
                        </button>
                    </div>
                </div>

                <!-- Supported UPI Apps Small Logos Strip (No Intent Launch Buttons) -->
                <div class="mt-6 pt-4 border-t border-slate-200/60 text-center">
                    <span data-i18n="supportedApps" class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 block mb-2.5">Supported UPI Applications</span>
                    <div class="flex flex-wrap items-center justify-center gap-2.5">
                        <!-- GPay Small Logo Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200/70">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                            <span class="text-[11px] font-extrabold text-slate-700">GPay</span>
                        </div>
                        <!-- PhonePe Small Logo Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200/70">
                            <span class="w-4 h-4 rounded-md bg-[#5f259f] text-white text-[9px] font-black flex items-center justify-center shrink-0">पे</span>
                            <span class="text-[11px] font-extrabold text-slate-700">PhonePe</span>
                        </div>
                        <!-- Paytm Small Logo Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200/70">
                            <span class="w-4 h-4 rounded-md bg-[#00baf2] text-white text-[9px] font-black flex items-center justify-center shrink-0">P</span>
                            <span class="text-[11px] font-extrabold text-slate-700">Paytm</span>
                        </div>
                        <!-- BHIM Small Logo Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200/70">
                            <span class="w-4 h-4 rounded-md bg-emerald-600 text-white text-[9px] font-black flex items-center justify-center shrink-0">B</span>
                            <span class="text-[11px] font-extrabold text-slate-700">BHIM</span>
                        </div>
                        <!-- CRED / Amazon Pay Small Logo Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 border border-slate-200/70">
                            <span class="w-4 h-4 rounded-md bg-amber-500 text-white text-[9px] font-black flex items-center justify-center shrink-0">A</span>
                            <span class="text-[11px] font-extrabold text-slate-700">Amazon Pay</span>
                        </div>
                    </div>
                </div>

                <!-- Raise Dispute / Submit UTR with Screenshot Callout -->
                <div class="mt-6 pt-4 border-t border-slate-200/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <p class="text-xs font-extrabold text-slate-700">Paid but waiting for confirmation?</p>
                        <p class="text-[11px] text-slate-500">Upload your payment screenshot, 12-digit UTR & query for Admin verification.</p>
                    </div>
                    <button type="button" onclick="CheckoutApp.toggleModal('dispute-modal', true)" class="theme-btn-primary px-4 py-2.5 rounded-xl text-xs font-extrabold cursor-pointer shrink-0">
                        Upload Screenshot & UTR
                    </button>
                </div>
            </div>

            <!-- RIGHT COLUMN: PROMO COUPONS, TIPS, SPLIT BILL, PAYER DETAILS, SUPPORT (5 COLS) -->
            <div class="lg:col-span-5 p-5 sm:p-7 bg-slate-50/60 flex flex-col justify-between space-y-5">

                <div class="space-y-5">
                    <!-- 1. Promo Code / Discount Coupon Widget -->
                    <% if (cfg.enableCoupons !== false) { %>
                    <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-800 flex items-center gap-1.5">
                                <span>🏷️ Apply Promo / Offer Code</span>
                            </span>
                            <button type="button" onclick="CheckoutApp.quickFillCoupon('UPAY10')" class="text-[10px] font-extrabold text-[#5f259f] hover:underline cursor-pointer">
                                Try UPAY10
                            </button>
                        </div>
                        <form onsubmit="CheckoutApp.applyPromo(event)" class="flex gap-2">
                            <input type="text" id="coupon-input" value="<%=couponCode || ''%>" placeholder="e.g. UPAY10 or UPAY20"
                                class="flex-1 px-3 py-2 rounded-xl border border-slate-200 text-xs font-extrabold uppercase mono text-slate-900 outline-none focus:border-[#5f259f]">
                            <button type="submit" class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-extrabold cursor-pointer">
                                Apply
                            </button>
                        </form>
                        <p id="coupon-feedback" class="text-[11px] font-bold text-emerald-600 <%=discountAmount > 0 ? '' : 'hidden'%>">
                            ✓ Promo applied! Saving &#8377;<%=discountAmount%>
                        </p>
                    </div>
                    <% } %>

                    <!-- 2. Add Gratitude Tip / Support Widget -->
                    <% if (cfg.enableTips !== false) { %>
                    <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-800">💜 Add a Tip for <%=company%></span>
                            <button type="button" onclick="CheckoutApp.setTip(0)" class="text-[10px] font-bold text-slate-400 hover:text-rose-600 cursor-pointer">Clear</button>
                        </div>
                        <div class="grid grid-cols-4 gap-2">
                            <% [10, 25, 50, 100].forEach(t => { %>
                            <button type="button" onclick="CheckoutApp.setTip(<%=t%>)" data-tip-btn="<%=t%>"
                                class="tip-pill py-2 rounded-xl border text-xs font-extrabold transition cursor-pointer <%=Number(tipAmount) === t ? 'border-[#5f259f] bg-purple-50 text-[#5f259f]' : 'border-slate-200 text-slate-700 hover:border-purple-300'%>">
                                +&#8377;<%=t%>
                            </button>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>

                    <!-- 3. Split Bill Calculator Widget -->
                    <% if (cfg.enableSplitBill !== false) { %>
                    <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-800">👥 Split Bill with Friends</span>
                            <span id="split-per-person" class="text-xs font-black text-[#5f259f] mono">&#8377;<%=(Number(amount)/2).toFixed(2)%>/person</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <input type="range" id="split-slider" min="2" max="10" value="2" oninput="CheckoutApp.updateSplit(this.value)" class="flex-1 accent-[#5f259f] cursor-pointer">
                            <span id="split-count-label" class="text-xs font-extrabold text-slate-700 w-16 text-right">2 People</span>
                        </div>
                        <button type="button" onclick="CheckoutApp.shareSplitBill()" class="w-full py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-[#5f259f] text-[11px] font-extrabold transition cursor-pointer">
                            Copy Split Payment Request for WhatsApp
                        </button>
                    </div>
                    <% } %>

                    <!-- 4. Payer Info, Custom Note & Email Receipt Card -->
                    <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-800">📩 Payer Details & Digital Receipt</span>
                            <button type="button" onclick="CheckoutApp.toggleModal('payer-modal', true)" class="text-[11px] font-extrabold text-[#5f259f] hover:underline cursor-pointer">
                                Edit Details
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-500 truncate" id="payer-summary-line">
                            <%=customerName%> • <%=customerEmail !== 'Not Given' ? customerEmail : 'Add email for instant receipt'%>
                        </p>
                        <% if (customerNote) { %>
                        <p class="text-[11px] text-purple-700 bg-purple-50 px-2.5 py-1 rounded-lg" id="payer-note-line">Note: <%=customerNote%></p>
                        <% } else { %>
                        <p class="text-[11px] text-purple-700 bg-purple-50 px-2.5 py-1 rounded-lg hidden" id="payer-note-line"></p>
                        <% } %>
                    </div>
                </div>

                <!-- Bottom Action Bar: Receipt Download, Rating & Dispute Help -->
                <div class="pt-4 border-t border-slate-200/80 space-y-2.5">
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" onclick="CheckoutApp.toggleModal('feedback-modal', true)" class="py-2.5 px-3 rounded-xl bg-white border border-slate-200 hover:border-purple-300 text-slate-700 text-[11px] font-extrabold transition cursor-pointer flex items-center justify-center gap-1">
                            <span>⭐ Rate Checkout</span>
                        </button>
                        <button type="button" onclick="CheckoutApp.toggleModal('dispute-modal', true)" class="py-2.5 px-3 rounded-xl bg-white border border-slate-200 hover:border-rose-300 text-slate-700 text-[11px] font-extrabold transition cursor-pointer flex items-center justify-center gap-1">
                            <span>🛡️ Raise Dispute</span>
                        </button>
                    </div>
                    <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold px-1">
                        <span>🔒 UPay 2.0 • 256-Bit Encrypted</span>
                        <button type="button" onclick="CheckoutApp.downloadReceiptSummary()" class="text-[#5f259f] font-extrabold hover:underline cursor-pointer">Download Summary</button>
                    </div>
                </div>

            </div>
        </div>

        <!-- ============================================================= -->
        <!-- OVERLAYS: SUCCESS / TIMEOUT (ONLY WHEN TIMER EXPIRES)         -->
        <!-- ============================================================= -->
        <div id="popup-overlay" class="hidden absolute inset-0 bg-slate-950/75 backdrop-blur-md z-50 flex items-center justify-center p-5" role="dialog" aria-modal="true">

            <!-- Success Popup -->
            <div id="success-popup" class="hidden popup-in bg-white rounded-3xl p-7 text-center w-full max-w-sm shadow-2xl relative overflow-hidden text-slate-900">
                <div id="confetti"></div>
                <div class="w-20 h-20 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto mb-4 text-4xl font-black shadow-lg shadow-emerald-500/30">
                    ✓
                </div>
                <h3 class="text-xl font-extrabold text-slate-900">Payment Successful!</h3>
                <p class="text-3xl font-black text-slate-900 mt-2 tabular-nums">&#8377;<span id="success-amount">0.00</span></p>
                <p class="text-slate-500 text-xs mt-2">Verified by UPay 2.0 Node. Redirecting to <%=company%>…</p>
                <p class="text-slate-600 text-xs mt-3 bg-slate-100 py-1.5 px-3 rounded-xl inline-block"><b>UTR:</b> <span id="utr" class="mono font-bold"></span></p>
                <div id="redirect-bar" class="redirect-bar mt-5"><span></span></div>
            </div>

            <!-- Timeout Popup (Shown ONLY when the 5-minute countdown expires) -->
            <div id="timeout-popup" class="hidden popup-in bg-white rounded-3xl p-7 text-center w-full max-w-sm shadow-2xl text-slate-900">
                <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto mb-4 text-2xl font-black">
                    ⏳
                </div>
                <h3 class="text-xl font-extrabold text-slate-900">QR Session Timed Out</h3>
                <p class="text-slate-500 text-xs mt-2">The 5-minute countdown has ended. Click below to generate a fresh QR code and extend your session without reloading the page.</p>
                <button type="button" onclick="CheckoutApp.refreshQrSession()" class="mt-5 w-full py-3.5 theme-btn-primary rounded-2xl font-extrabold text-xs cursor-pointer">
                    Generate Fresh QR (No Reload)
                </button>
            </div>
        </div>
    </main>

    <!-- ================================================================= -->
    <!-- MODAL 1: CUSTOM THEME STUDIO DRAWER                               -->
    <!-- ================================================================= -->
    <div id="custom-theme-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 popup-in">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#5f259f]">UPay 2.0 Theme Customizer</span>
                    <h3 class="text-base font-extrabold">Customize Payment Page Theme</h3>
                </div>
                <button type="button" onclick="CheckoutApp.toggleModal('custom-theme-modal', false)" class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold cursor-pointer">&times;</button>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Primary Brand Color</label>
                    <input type="color" id="user-color-primary" value="<%=cTheme.primary || '#5f259f'%>" oninput="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer">
                </div>
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Secondary Accent</label>
                    <input type="color" id="user-color-secondary" value="<%=cTheme.secondary || '#7c3aed'%>" oninput="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer">
                </div>
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Page Background</label>
                    <input type="color" id="user-color-bg" value="<%=cTheme.background || '#f5f0ff'%>" oninput="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer">
                </div>
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Card Surface</label>
                    <input type="color" id="user-color-surface" value="<%=cTheme.surface || '#ffffff'%>" oninput="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer">
                </div>
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Text Color</label>
                    <input type="color" id="user-color-text" value="<%=cTheme.text || '#0f172a'%>" oninput="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer">
                </div>
                <div>
                    <label class="font-bold text-slate-600 block mb-1">Corner Roundness</label>
                    <select id="user-color-radius" onchange="CheckoutApp.previewCustomTheme()" class="w-full h-10 rounded-xl border border-slate-200 px-2 font-bold">
                        <option value="14px">Sharp (14px)</option>
                        <option value="24px" selected>UPay 2.0 (24px)</option>
                        <option value="34px">Super Rounded (34px)</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button type="button" onclick="CheckoutApp.applyTheme('upay2'); CheckoutApp.toggleModal('custom-theme-modal', false)" class="flex-1 py-3 rounded-xl bg-slate-100 text-slate-700 font-extrabold text-xs cursor-pointer">
                    Reset to Default
                </button>
                <button type="button" onclick="CheckoutApp.saveCustomTheme()" class="flex-1 py-3 rounded-xl theme-btn-primary font-extrabold text-xs cursor-pointer">
                    Save My Theme
                </button>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- MODAL 2: EDIT PAYER DETAILS & CUSTOM NOTE                         -->
    <!-- ================================================================= -->
    <div id="payer-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 popup-in">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-base font-extrabold">Payer Details & Email Receipt</h3>
                <button type="button" onclick="CheckoutApp.toggleModal('payer-modal', false)" class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold cursor-pointer">&times;</button>
            </div>
            <form onsubmit="CheckoutApp.savePayerDetails(event)" class="space-y-3 text-xs">
                <div>
                    <label class="font-bold text-slate-600">Your Name</label>
                    <input type="text" id="inp-cust-name" value="<%=customerName%>" required class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 font-semibold">
                </div>
                <div>
                    <label class="font-bold text-slate-600">Email Address (For Instant Payment Receipt)</label>
                    <input type="email" id="inp-cust-email" value="<%=customerEmail !== 'Not Given' ? customerEmail : ''%>" placeholder="you@example.com" class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 font-semibold">
                </div>
                <div>
                    <label class="font-bold text-slate-600">Mobile Number</label>
                    <input type="tel" id="inp-cust-phone" value="<%=customerPhone !== 'Not Given' ? customerPhone : ''%>" placeholder="9876543210" class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 font-semibold">
                </div>
                <div>
                    <label class="font-bold text-slate-600">Payment Note / Order Remark</label>
                    <input type="text" id="inp-cust-note" value="<%=customerNote%>" placeholder="Optional message for merchant" class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 font-semibold">
                </div>
                <button type="submit" class="w-full py-3 rounded-xl theme-btn-primary font-extrabold text-xs cursor-pointer">
                    Save Details (Zero Reload)
                </button>
            </form>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- MODAL 3: RATE CHECKOUT EXPERIENCE                                 -->
    <!-- ================================================================= -->
    <div id="feedback-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl max-w-sm w-full p-6 shadow-2xl space-y-4 popup-in text-center">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-base font-extrabold">Rate UPay 2.0 Checkout</h3>
                <button type="button" onclick="CheckoutApp.toggleModal('feedback-modal', false)" class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold cursor-pointer">&times;</button>
            </div>
            <div class="flex justify-center gap-2 text-2xl py-2" id="star-selector">
                <% [1,2,3,4,5].forEach(s => { %>
                <button type="button" onclick="CheckoutApp.setRating(<%=s%>)" data-star="<%=s%>" class="star-btn text-amber-400 hover:scale-125 transition cursor-pointer">★</button>
                <% }) %>
            </div>
            <input type="text" id="feedback-comment" placeholder="What did you like about UPay 2.0?" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold">
            <button type="button" onclick="CheckoutApp.submitFeedback()" class="w-full py-3 rounded-xl theme-btn-primary font-extrabold text-xs cursor-pointer">
                Submit Rating
            </button>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- MODAL 4: RAISE DISPUTE WITH SCREENSHOT + UTR + QUERY              -->
    <!-- ================================================================= -->
    <div id="dispute-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 popup-in">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <span class="text-[10px] font-extrabold uppercase text-rose-600">Manual Admin Verification Desk</span>
                    <h3 class="text-base font-extrabold">Raise Dispute / Submit Payment Proof</h3>
                </div>
                <button type="button" onclick="CheckoutApp.toggleModal('dispute-modal', false)" class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold cursor-pointer">&times;</button>
            </div>
            <form onsubmit="CheckoutApp.submitDispute(event)" class="space-y-3 text-xs">
                <div>
                    <label class="font-bold text-slate-600">12-Digit Bank UTR / UPI Reference Number *</label>
                    <input type="text" id="dispute-utr" required maxlength="12" pattern="\d{12}" placeholder="Enter 12-digit numeric UTR (e.g. 412890123456)" class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 mono font-semibold">
                </div>
                <div>
                    <label class="font-bold text-slate-600">Upload Payment Screenshot *</label>
                    <input type="file" id="dispute-screenshot-file" accept="image/*" required onchange="CheckoutApp.previewDisputeScreenshot(event)" class="w-full mt-1 px-3 py-2 rounded-xl border border-dashed border-purple-300 bg-purple-50/40 text-xs font-semibold cursor-pointer">
                    <div id="dispute-screenshot-preview-wrap" class="hidden mt-2 p-2 rounded-xl bg-slate-50 border border-slate-200 text-center">
                        <img id="dispute-screenshot-preview" src="" alt="Screenshot Preview" class="max-h-32 mx-auto rounded-lg object-contain">
                    </div>
                </div>
                <div>
                    <label class="font-bold text-slate-600">Your Query / Issue Details *</label>
                    <textarea id="dispute-reason" required rows="3" placeholder="Describe your query (e.g. Paid via UPI app, amount deducted, please verify attached screenshot and UTR)..." class="w-full mt-1 px-3.5 py-2.5 rounded-xl border border-slate-200 font-semibold"></textarea>
                </div>
                <p class="text-[11px] text-slate-500 bg-amber-50 border border-amber-200/70 p-2.5 rounded-xl">
                    Note: Disputes are reviewed manually by the Merchant Admin before settlement approval.
                </p>
                <button type="submit" class="w-full py-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-xs cursor-pointer">
                    Submit Screenshot, UTR & Query to Admin
                </button>
            </form>
        </div>
    </div>

    <script>
        const THEME_PRESETS = {
            upay2: {
                primary: '#5f259f',
                secondary: '#7c3aed',
                bg: 'radial-gradient(circle at top center, #ede9fe 0%, #f5f0ff 55%, #f8fafc 100%)',
                surface: '#ffffff',
                text: '#0f172a',
                radius: '24px'
            },
            midnight: {
                primary: '#6366f1',
                secondary: '#8b5cf6',
                bg: 'radial-gradient(circle at top center, #1e1b4b 0%, #090d16 70%)',
                surface: '#111827',
                text: '#f8fafc',
                radius: '24px'
            },
            emerald: {
                primary: '#059669',
                secondary: '#10b981',
                bg: 'radial-gradient(circle at top center, #d1fae5 0%, #ecfdf5 60%, #f8fafc 100%)',
                surface: '#ffffff',
                text: '#064e3b',
                radius: '24px'
            },
            gold: {
                primary: '#b45309',
                secondary: '#f59e0b',
                bg: 'radial-gradient(circle at top center, #fef3c7 0%, #fffbeb 60%, #fafaf9 100%)',
                surface: '#ffffff',
                text: '#451a03',
                radius: '20px'
            },
            ocean: {
                primary: '#0284c7',
                secondary: '#06b6d4',
                bg: 'radial-gradient(circle at top center, #e0f2fe 0%, #f0f9ff 60%, #f8fafc 100%)',
                surface: '#ffffff',
                text: '#0c4a6e',
                radius: '24px'
            },
            rose: {
                primary: '#e11d48',
                secondary: '#f43f5e',
                bg: 'radial-gradient(circle at top center, #ffe4e6 0%, #fff1f2 60%, #f8fafc 100%)',
                surface: '#ffffff',
                text: '#4c0519',
                radius: '28px'
            },
            monochrome: {
                primary: '#18181b',
                secondary: '#52525b',
                bg: '#f4f4f5',
                surface: '#ffffff',
                text: '#09090b',
                radius: '16px'
            },
            custom: {
                primary: '<%=cTheme.primary || "#5f259f"%>',
                secondary: '<%=cTheme.secondary || "#7c3aed"%>',
                bg: '<%=cTheme.background || "#f5f0ff"%>',
                surface: '<%=cTheme.surface || "#ffffff"%>',
                text: '<%=cTheme.text || "#0f172a"%>',
                radius: '<%=cTheme.radius || "24px"%>'
            }
        };

        const I18N_DICT = {
            en: {
                totalPayable: "Total Payable",
                scanPrompt: "Scan QR with Any UPI App to Pay",
                downloadQr: "Save QR",
                supportedApps: "Supported UPI Applications"
            },
            hi: {
                totalPayable: "कुल देय राशि",
                scanPrompt: "भुगतान करने के लिए किसी भी UPI ऐप से QR स्कैन करें",
                downloadQr: "QR सेव करें",
                supportedApps: "समर्थित UPI ऐप्स"
            },
            hinglish: {
                totalPayable: "Total Payable Amount",
                scanPrompt: "Kisi bhi UPI App se QR Scan karke Pay karein",
                downloadQr: "Download QR",
                supportedApps: "Supported UPI Apps"
            }
        };

        const CheckoutApp = {
            state: {
                tid: "<%=tid%>",
                amount: Number("<%=amount%>") || 0,
                baseAmount: Number("<%=baseAmount || amount%>") || 0,
                discountAmount: Number("<%=discountAmount || 0%>") || 0,
                tipAmount: Number("<%=tipAmount || 0%>") || 0,
                feeAmount: Number("<%=feeAmount || 0%>") || 0,
                timeInSeconds: 300,
                isPollingStopped: false,
                pollTimer: null,
                countdownTimer: null,
                rating: 5,
                currentTheme: "<%=initTheme%>",
                disputeScreenshotBase64: ""
            },

            init() {
                let savedTheme = this.state.currentTheme;
                try {
                    const localTheme = localStorage.getItem('upay_checkout_theme');
                    const localCustom = localStorage.getItem('upay_custom_theme_vars');
                    if (localCustom) {
                        THEME_PRESETS.custom = JSON.parse(localCustom);
                    }
                    if (localTheme && THEME_PRESETS[localTheme]) {
                        savedTheme = localTheme;
                    }
                } catch (e) {}

                this.applyTheme(savedTheme, false);
                this.startCountdown();
                this.state.pollTimer = setTimeout(() => this.checkPaymentStatus(), 2200);
            },

            applyTheme(themeKey, persist = true) {
                const normalizedKey = themeKey === 'phonepe' ? 'upay2' : themeKey;
                const t = THEME_PRESETS[normalizedKey] || THEME_PRESETS.upay2;
                const root = document.documentElement;
                root.style.setProperty('--theme-primary', t.primary);
                root.style.setProperty('--theme-secondary', t.secondary);
                root.style.setProperty('--theme-bg', t.bg);
                root.style.setProperty('--theme-surface', t.surface);
                root.style.setProperty('--theme-text', t.text);
                root.style.setProperty('--theme-radius', t.radius || '24px');

                this.state.currentTheme = normalizedKey;
                if (persist) {
                    try { localStorage.setItem('upay_checkout_theme', normalizedKey); } catch (e) {}
                    fetch(`/pay/api/${this.state.tid}/theme`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: normalizedKey }),
                        silent: true
                    }).catch(() => {});
                    this.toast(`Theme switched to ${normalizedKey.toUpperCase()}`);
                }
            },

            previewCustomTheme() {
                const customVars = {
                    primary: document.getElementById('user-color-primary').value,
                    secondary: document.getElementById('user-color-secondary').value,
                    bg: document.getElementById('user-color-bg').value,
                    surface: document.getElementById('user-color-surface').value,
                    text: document.getElementById('user-color-text').value,
                    radius: document.getElementById('user-color-radius').value
                };
                THEME_PRESETS.custom = customVars;
                this.applyTheme('custom', false);
            },

            saveCustomTheme() {
                this.previewCustomTheme();
                try {
                    localStorage.setItem('upay_checkout_theme', 'custom');
                    localStorage.setItem('upay_custom_theme_vars', JSON.stringify(THEME_PRESETS.custom));
                } catch (e) {}
                this.applyTheme('custom', true);
                this.toggleModal('custom-theme-modal', false);
            },

            setLanguage(lang) {
                const dict = I18N_DICT[lang] || I18N_DICT.en;
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    if (dict[key]) el.textContent = dict[key];
                });
                this.toast(`Language updated: ${lang.toUpperCase()}`);
            },

            toggleBreakdown() {
                document.getElementById('price-breakdown-drawer').classList.toggle('hidden');
            },

            toggleModal(id, show) {
                const el = document.getElementById(id);
                if (!el) return;
                if (show) {
                    el.classList.remove('hidden');
                    el.classList.add('flex');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                }
            },

            updateOrderDOM(data) {
                if (typeof data.amount === 'number') {
                    this.state.amount = data.amount;
                    document.getElementById('live-amount-display').textContent = data.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    document.getElementById('copy-amt-btn').textContent = data.amount;
                    document.getElementById('brk-base').textContent = Number(data.baseAmount || data.amount).toFixed(2);
                    document.getElementById('brk-discount').textContent = Number(data.discountAmount || 0).toFixed(2);
                    document.getElementById('brk-tip').textContent = Number(data.tipAmount || 0).toFixed(2);
                    document.getElementById('brk-fee').textContent = Number(data.feeAmount || 0).toFixed(2);
                    document.getElementById('brk-fx').textContent = `$${(data.amount / 84).toFixed(2)} / €${(data.amount / 91).toFixed(2)}`;
                    this.updateSplit(document.getElementById('split-slider')?.value || 2);
                }
                if (data.qrDataUrl) {
                    document.getElementById('qr-image').src = data.qrDataUrl;
                }
            },

            quickFillCoupon(code) {
                const inp = document.getElementById('coupon-input');
                if (inp) {
                    inp.value = code;
                    this.applyPromo(new Event('submit'));
                }
            },

            async applyPromo(e) {
                if (e && e.preventDefault) e.preventDefault();
                const code = document.getElementById('coupon-input')?.value || '';
                const res = await fetch(`/pay/api/${this.state.tid}/coupon`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await res.json();
                if (data.status) {
                    this.updateOrderDOM(data);
                    const fb = document.getElementById('coupon-feedback');
                    if (fb) {
                        if (data.discountAmount > 0) {
                            fb.classList.remove('hidden');
                            fb.textContent = `✓ Promo ${data.couponCode} applied! Saving ₹${data.discountAmount.toFixed(2)}`;
                        } else {
                            fb.classList.add('hidden');
                        }
                    }
                    this.toast(data.message);
                } else {
                    this.toast(data.message, true);
                }
            },

            async setTip(amount) {
                const res = await fetch(`/pay/api/${this.state.tid}/tip`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tip: amount })
                });
                const data = await res.json();
                if (data.status) {
                    this.updateOrderDOM(data);
                    document.querySelectorAll('.tip-pill').forEach(btn => {
                        if (Number(btn.getAttribute('data-tip-btn')) === Number(amount) && amount > 0) {
                            btn.className = 'tip-pill py-2 rounded-xl border text-xs font-extrabold transition cursor-pointer border-[#5f259f] bg-purple-50 text-[#5f259f]';
                        } else {
                            btn.className = 'tip-pill py-2 rounded-xl border text-xs font-extrabold transition cursor-pointer border-slate-200 text-slate-700 hover:border-purple-300';
                        }
                    });
                    this.toast(data.message);
                }
            },

            updateSplit(count) {
                const n = Math.max(2, Number(count || 2));
                const lbl = document.getElementById('split-count-label');
                const per = document.getElementById('split-per-person');
                if (lbl) lbl.textContent = `${n} People`;
                if (per) per.textContent = `₹${(this.state.amount / n).toFixed(2)}/person`;
            },

            shareSplitBill() {
                const n = Number(document.getElementById('split-slider')?.value || 2);
                const share = (this.state.amount / n).toFixed(2);
                const text = `Hey! Let's split the ₹${this.state.amount} payment to <%=company%> (${n} ways = ₹${share} each). Pay securely via UPay 2.0: ${window.location.href}`;
                this.copyText(text, `Split Bill summary (₹${share}/person) copied!`);
            },

            previewDisputeScreenshot(event) {
                const file = event.target.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    this.state.disputeScreenshotBase64 = e.target.result;
                    const img = document.getElementById('dispute-screenshot-preview');
                    const wrap = document.getElementById('dispute-screenshot-preview-wrap');
                    if (img && wrap) {
                        img.src = e.target.result;
                        wrap.classList.remove('hidden');
                    }
                };
                reader.readAsDataURL(file);
            },

            async submitDispute(e) {
                e.preventDefault();
                const utr = document.getElementById('dispute-utr').value.trim();
                const reason = document.getElementById('dispute-reason').value.trim();
                const screenshot = this.state.disputeScreenshotBase64;
                if (!/^\d{12}$/.test(utr)) {
                    return this.toast('Please enter a valid 12-digit numeric UTR', true);
                }
                if (!screenshot) {
                    return this.toast('Please upload your payment screenshot', true);
                }

                const res = await fetch(`/pay/api/${this.state.tid}/dispute`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ utr, reason, screenshot })
                });
                const data = await res.json();
                if (data.status) {
                    this.toggleModal('dispute-modal', false);
                    this.toast(data.message);
                } else {
                    this.toast(data.message, true);
                }
            },

            async refreshQrSession() {
                const res = await fetch(`/pay/api/${this.state.tid}/refresh-qr`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.status) {
                    document.getElementById('popup-overlay').classList.add('hidden');
                    this.updateOrderDOM(data);
                    this.state.timeInSeconds = data.timeInSeconds || 300;
                    this.state.isPollingStopped = false;
                    this.startCountdown();
                    this.checkPaymentStatus();
                    this.toast(data.message);
                } else {
                    this.toast(data.message || 'Could not extend session', true);
                }
            },

            async savePayerDetails(e) {
                e.preventDefault();
                const payload = {
                    customerName: document.getElementById('inp-cust-name').value,
                    customerEmail: document.getElementById('inp-cust-email').value,
                    customerPhone: document.getElementById('inp-cust-phone').value,
                    customerNote: document.getElementById('inp-cust-note').value
                };
                const res = await fetch(`/pay/api/${this.state.tid}/customer-info`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.status) {
                    document.getElementById('header-payer-name').textContent = data.customerName;
                    document.getElementById('payer-summary-line').textContent = `${data.customerName} • ${data.customerEmail || 'Receipt Ready'}`;
                    const noteLine = document.getElementById('payer-note-line');
                    if (data.customerNote) {
                        noteLine.textContent = `Note: ${data.customerNote}`;
                        noteLine.classList.remove('hidden');
                    }
                    this.toggleModal('payer-modal', false);
                    this.toast(data.message);
                }
            },

            setRating(stars) {
                this.state.rating = stars;
                document.querySelectorAll('.star-btn').forEach(btn => {
                    const s = Number(btn.getAttribute('data-star'));
                    btn.className = s <= stars ? 'star-btn text-amber-400 scale-110 transition cursor-pointer' : 'star-btn text-slate-300 transition cursor-pointer';
                });
            },

            async submitFeedback() {
                const comment = document.getElementById('feedback-comment').value;
                const res = await fetch(`/pay/api/${this.state.tid}/feedback`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating: this.state.rating, comment })
                });
                const data = await res.json();
                this.toggleModal('feedback-modal', false);
                this.toast(data.message || 'Feedback submitted!');
            },

            downloadReceiptSummary() {
                const receiptText = [
                    "==========================================",
                    "        UPAY 2.0 VERIFIED SUMMARY         ",
                    "==========================================",
                    `Merchant     : <%=company%>`,
                    `Order ID     : #${this.state.tid}`,
                    `Payable Amt  : INR ${this.state.amount.toFixed(2)}`,
                    `Merchant UPI : <%=upi%>`,
                    `Timestamp    : ${new Date().toLocaleString()}`,
                    "=========================================="
                ].join('\n');
                const blob = new Blob([receiptText], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `UPay2_Order_${this.state.tid}.txt`;
                a.click();
                URL.revokeObjectURL(url);
                this.toast('Order Summary Downloaded!');
            },

            startCountdown() {
                if (this.state.countdownTimer) clearInterval(this.state.countdownTimer);
                const timerEl = document.getElementById('timer');
                this.state.countdownTimer = setInterval(() => {
                    const m = Math.floor(this.state.timeInSeconds / 60);
                    const s = this.state.timeInSeconds % 60;
                    if (timerEl) timerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                    if (this.state.timeInSeconds <= 0) {
                        this.stopPolling();
                        this.showPopup('timeout');
                        return;
                    }
                    this.state.timeInSeconds--;
                }, 1000);
            },

            stopPolling() {
                this.state.isPollingStopped = true;
                if (this.state.pollTimer) clearTimeout(this.state.pollTimer);
                if (this.state.countdownTimer) clearInterval(this.state.countdownTimer);
            },

            showPopup(type) {
                ['timeout-popup', 'success-popup'].forEach(id => {
                    document.getElementById(id)?.classList.add('hidden');
                });
                document.getElementById('popup-overlay').classList.remove('hidden');
                document.getElementById(`${type}-popup`)?.classList.remove('hidden');
                if (type === 'success') this.playSuccessConfetti();
            },

            handlePaymentVerified(utr) {
                this.stopPolling();
                document.getElementById('utr').innerText = utr || 'VERIFIED';
                this.showPopup('success');
                setTimeout(() => {
                    location.href = "<%=redirect%>";
                }, 3400);
            },

            playSuccessConfetti() {
                const out = document.getElementById('success-amount');
                out.textContent = this.state.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('redirect-bar').classList.add('run');

                const box = document.getElementById('confetti');
                const colors = ['#00b970', '#5f259f', '#f59e0b', '#6366f1', '#ec4899'];
                for (let i = 0; i < 24; i++) {
                    const b = document.createElement('span');
                    b.className = 'bit';
                    const a = (Math.PI * 2 * i / 24) + Math.random() * .4;
                    const d = 80 + Math.random() * 100;
                    b.style.background = colors[i % colors.length];
                    b.style.setProperty('--x', Math.cos(a) * d + 'px');
                    b.style.setProperty('--y', (Math.sin(a) * d * .8 + 50) + 'px');
                    b.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
                    b.style.setProperty('--t', (1.1 + Math.random() * .5) + 's');
                    b.style.setProperty('--d', (.2 + Math.random() * .15) + 's');
                    box.appendChild(b);
                }
            },

            async downloadQR() {
                const img = document.getElementById('qr-image');
                const fileName = `UPay2_QR_${this.state.tid}.png`;
                try {
                    const response = await fetch(img.src, { silent: true });
                    const blob = await response.blob();
                    const blobUrl = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = blobUrl;
                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(blobUrl);
                    this.toast('QR Code Saved!');
                } catch (err) {
                    const link = document.createElement('a');
                    link.href = img.src;
                    link.download = fileName;
                    link.click();
                }
            },

            // Continuous Polling until Countdown Timer Expires (Never expires QR on Invalid Order ID)
            async checkPaymentStatus() {
                if (this.state.isPollingStopped || this.state.timeInSeconds <= 0) return;
                try {
                    const response = await fetch(`/pay/status/${this.state.tid}`, { silent: true });
                    const data = await response.json();

                    if (data.status === true || data.state === "SUCCESS") {
                        this.handlePaymentVerified(data.utr);
                        return;
                    }
                    // For any other state (including PENDING or Invalid Order ID from Paytm),
                    // continue polling silently until timeInSeconds reaches 0.
                } catch (e) {}

                if (!this.state.isPollingStopped && this.state.timeInSeconds > 0) {
                    this.state.pollTimer = setTimeout(() => this.checkPaymentStatus(), 3000);
                }
            },

            copyText(text, msg = 'Copied to clipboard!') {
                navigator.clipboard.writeText(String(text));
                this.toast(msg);
            },

            toast(text, isError = false) {
                Toastify({
                    text,
                    duration: 2600,
                    gravity: "top",
                    position: "center",
                    style: {
                        background: isError ? "#e11d48" : "linear-gradient(135deg, var(--theme-primary), var(--theme-secondary))",
                        borderRadius: "12px",
                        fontSize: "12px",
                        fontWeight: "700"
                    }
                }).showToast();
            }
        };

        window.onload = () => CheckoutApp.init();
    </script>
</body>
</html>
