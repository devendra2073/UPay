<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>पेमेंट करें | <%= company %></title>

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --ink: #111827;
      --muted: #6b7280;
      --border: #e5e7eb;
      --surface: #ffffff;
      --background: #f3f6fb;
      --success: #15803d;
      --danger: #b91c1c;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 16px;
      min-height: 100vh;
      min-height: 100svh;
      background: var(--background);
      color: var(--ink);
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .page {
      width: 100%;
      max-width: 980px;
      margin: 0 auto;
    }

    .checkout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    /* शुरुआती Proceed बॉक्स */
    .intro {
      max-width: 480px;
      margin: 8vh auto 0;
      padding: 28px 22px;
      text-align: center;
    }

    .intro-logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      margin-bottom: 12px;
    }

    .intro h1 {
      margin: 0 0 8px;
      font-size: 24px;
    }

    .intro p {
      margin: 0 0 22px;
      color: var(--muted);
      line-height: 1.5;
    }

    .primary-btn {
      width: 100%;
      min-height: 52px;
      border: 0;
      border-radius: 14px;
      background: var(--primary);
      color: white;
      font-weight: 700;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .primary-btn:hover {
      background: var(--primary-dark);
    }

    .primary-btn:active {
      transform: scale(0.99);
    }

    /* पेमेंट इंटरफेस */
    .payment-view {
      display: none;
    }

    .payment-card {
      padding: 18px;
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 14px;
      text-align: center;
    }

    .brand img {
      width: 44px;
      height: 44px;
      object-fit: contain;
      border-radius: 10px;
    }

    .brand-name {
      font-size: 18px;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .amount-box {
      margin: 0 auto 14px;
      text-align: center;
    }

    .amount-label {
      margin-bottom: 4px;
      color: var(--muted);
      font-size: 13px;
    }

    .amount {
      font-size: clamp(30px, 8vw, 40px);
      font-weight: 850;
      line-height: 1.15;
      letter-spacing: -1px;
    }

    .qr-section {
      width: 100%;
      max-width: 340px;
      margin: 0 auto;
      padding: 14px;
      border: 2px solid #dbeafe;
      border-radius: 20px;
      background: #f8fbff;
      text-align: center;
    }

    .qr-heading {
      margin: 0 0 10px;
      font-size: 15px;
      font-weight: 800;
    }

    .qr-image {
      display: block;
      width: min(100%, 260px);
      aspect-ratio: 1 / 1;
      object-fit: contain;
      margin: 0 auto;
      border-radius: 12px;
      background: white;
    }

    .qr-help {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    .status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin: 14px 0 0;
      padding: 12px 14px;
      border-radius: 12px;
      background: #f9fafb;
      font-size: 13px;
    }

    .status-text {
      font-weight: 700;
    }

    .timer {
      color: var(--primary-dark);
      font-weight: 800;
      white-space: nowrap;
    }

    .instructions {
      margin-top: 16px;
      padding: 18px;
    }

    .instructions h2 {
      margin: 0 0 10px;
      font-size: 16px;
    }

    .instructions ol {
      margin: 0;
      padding-left: 20px;
      color: #4b5563;
      font-size: 13px;
      line-height: 1.7;
    }

    .transaction-id {
      margin-top: 12px;
      color: var(--muted);
      font-size: 11px;
      overflow-wrap: anywhere;
    }

    .secondary-btn {
      width: 100%;
      min-height: 46px;
      margin-top: 12px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: white;
      color: var(--ink);
      font-weight: 700;
    }

    /* Success / failure overlay */
    .result-overlay {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(15, 23, 42, 0.62);
    }

    .result-card {
      width: 100%;
      max-width: 380px;
      padding: 28px 22px;
      border-radius: 22px;
      background: white;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
    }

    .result-icon {
      display: grid;
      place-items: center;
      width: 66px;
      height: 66px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: #dcfce7;
      color: var(--success);
      font-size: 32px;
      font-weight: 900;
    }

    .result-card.failed .result-icon {
      background: #fee2e2;
      color: var(--danger);
    }

    .result-card h2 {
      margin: 0 0 8px;
      font-size: 23px;
    }

    .result-card p {
      margin: 0;
      color: var(--muted);
      line-height: 1.5;
    }

    .sound-fallback {
      display: none;
      width: 100%;
      margin-top: 14px;
      padding: 12px;
      border: 0;
      border-radius: 12px;
      background: #eff6ff;
      color: #1d4ed8;
      font-weight: 700;
    }

    .hidden {
      display: none !important;
    }

    @media (min-width: 760px) {
      body {
        padding: 28px;
      }

      .checkout {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
        gap: 20px;
      }

      .payment-card,
      .instructions {
        padding: 24px;
      }

      .qr-image {
        width: min(100%, 290px);
      }

      .instructions {
        margin-top: 0;
      }

      .intro {
        margin-top: 12vh;
      }
    }

    @media (max-width: 380px) {
      body {
        padding: 10px;
      }

      .payment-card {
        padding: 14px;
      }

      .qr-section {
        padding: 10px;
      }

      .qr-image {
        width: min(100%, 225px);
      }

      .status-row {
        padding: 10px;
        font-size: 12px;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <!-- पहला स्क्रीन: Proceed to Pay -->
    <section class="panel intro" id="introView">
      <% if (logo) { %>
        <img class="intro-logo" src="<%= logo %>" alt="<%= company %> logo" />
      <% } %>

      <h1><%= company %></h1>
      <p>पेमेंट जारी रखने के लिए नीचे दिए गए बटन पर क्लिक करें।</p>

      <button class="primary-btn" id="proceedBtn" type="button">
        Proceed to Pay
      </button>
    </section>

    <!-- Proceed पर क्लिक करने के बाद पेमेंट स्क्रीन -->
    <section class="payment-view" id="paymentView">
      <div class="checkout">
        <section class="panel payment-card">
          <header class="brand">
            <% if (logo) { %>
              <img src="<%= logo %>" alt="<%= company %> logo" />
            <% } %>
            <div class="brand-name"><%= company %></div>
          </header>

          <div class="amount-box">
            <div class="amount-label">भुगतान की राशि</div>
            <div class="amount">₹<%= amount %></div>
          </div>

          <div class="qr-section">
            <h2 class="qr-heading">स्कैन करके पेमेंट करें</h2>
            <img class="qr-image" src="<%= obj %>" alt="Payment QR code" />
            <p class="qr-help">
              अपने UPI ऐप से QR कोड स्कैन करें और पेमेंट पूरा करें।
            </p>
          </div>

          <div class="status-row">
            <span class="status-text" id="statusText">पेमेंट का इंतज़ार है…</span>
            <span class="timer" id="timer">05:00</span>
          </div>

          <div class="transaction-id">
            Transaction ID: <%= tid %>
          </div>
        </section>

        <section class="panel instructions">
          <h2>पेमेंट करने के निर्देश</h2>
          <ol>
            <li>अपने UPI ऐप को खोलें।</li>
            <li>ऊपर दिख रहे QR कोड को स्कैन करें।</li>
            <li>राशि चेक करके पेमेंट पूरा करें।</li>
            <li>पेमेंट पूरा होने तक यह पेज बंद न करें।</li>
          </ol>

          <button class="secondary-btn" id="checkPaymentBtn" type="button">
            पेमेंट स्टेटस चेक करें
          </button>
        </section>
      </div>
    </section>
  </main>

  <!-- पेमेंट सफल / असफल होने का popup -->
  <div class="result-overlay" id="resultOverlay" role="dialog" aria-modal="true">
    <div class="result-card" id="resultCard">
      <div class="result-icon" id="resultIcon">✓</div>
      <h2 id="resultTitle">पेमेंट सफल</h2>
      <p id="resultMessage">आपका पेमेंट सफलतापूर्वक पूरा हो गया है।</p>

      <button class="sound-fallback" id="playSoundFallback" type="button">
        🔊 पेमेंट की आवाज़ सुनें
      </button>

      <button class="primary-btn" id="continueBtn" type="button" style="margin-top: 14px;">
        आगे बढ़ें
      </button>
    </div>
  </div>

  <!-- पेमेंट सफल होने पर चलने वाला ऑडियो -->
  <audio
    id="paymentSuccessAudio"
    src="/audio/payment-success.mp3"
    preload="auto">
  </audio>

  <script>
    const proceedBtn = document.getElementById("proceedBtn");
    const introView = document.getElementById("introView");
    const paymentView = document.getElementById("paymentView");
    const statusText = document.getElementById("statusText");
    const timerElement = document.getElementById("timer");
    const checkPaymentBtn = document.getElementById("checkPaymentBtn");

    const resultOverlay = document.getElementById("resultOverlay");
    const resultCard = document.getElementById("resultCard");
    const resultIcon = document.getElementById("resultIcon");
    const resultTitle = document.getElementById("resultTitle");
    const resultMessage = document.getElementById("resultMessage");
    const continueBtn = document.getElementById("continueBtn");
    const paymentSuccessAudio = document.getElementById("paymentSuccessAudio");
    const playSoundFallback = document.getElementById("playSoundFallback");

    const transactionId = <%- JSON.stringify(String(tid)) %>;
    const redirectUrl = <%- JSON.stringify(String(redirect || "")) %>;

    let pollingInterval = null;
    let countdownInterval = null;
    let remainingSeconds = 300;
    let paymentFinished = false;

    proceedBtn.addEventListener("click", () => {
      introView.style.display = "none";
      paymentView.style.display = "block";

      // Proceed बटन पर यूज़र के टैप से ऑडियो की अनुमति लेने की कोशिश।
      // यह अभी ऑडियो नहीं बजाता; सफलता पर play() किया जाएगा।
      paymentSuccessAudio.load();

      startCountdown();
      checkPaymentStatus();
      pollingInterval = setInterval(checkPaymentStatus, 4000);
    });

    checkPaymentBtn.addEventListener("click", checkPaymentStatus);

    function startCountdown() {
      updateTimer();

      countdownInterval = setInterval(() => {
        if (remainingSeconds > 0) {
          remainingSeconds--;
          updateTimer();
        } else {
          clearInterval(countdownInterval);

          if (!paymentFinished) {
            statusText.textContent = "पेमेंट की समय-सीमा समाप्त हुई";
            showResult(
              "timeout",
              "समय समाप्त",
              "पेमेंट स्टेटस की पुष्टि नहीं हो सकी। यदि आपने पेमेंट किया है, तो कृपया स्टेटस दोबारा चेक करें।"
            );
          }
        }
      }, 1000);
    }

    function updateTimer() {
      const minutes = String(Math.floor(remainingSeconds / 60)).padStart(2, "0");
      const seconds = String(remainingSeconds % 60).padStart(2, "0");
      timerElement.textContent = `${minutes}:${seconds}`;
    }

    async function checkPaymentStatus() {
      if (paymentFinished) return;

      try {
        const response = await fetch(
          `/pay/status/${encodeURIComponent(transactionId)}`,
          {
            method: "GET",
            headers: { "Accept": "application/json" },
            cache: "no-store"
          }
        );

        if (!response.ok) return;

        const data = await response.json();
        const status = String(data.status || "").toLowerCase();

        if (["success", "paid", "completed", "complete"].includes(status)) {
          paymentFinished = true;
          stopPaymentChecks();
          statusText.textContent = "पेमेंट सफल";
          showResult("success", "पेमेंट सफल!", "आपका पेमेंट सफलतापूर्वक पूरा हो गया है।");
          playPaymentSuccessAudio();
        } else if (["failed", "failure", "cancelled", "canceled"].includes(status)) {
          paymentFinished = true;
          stopPaymentChecks();
          statusText.textContent = "पेमेंट असफल";
          showResult("failed", "पेमेंट असफल", "पेमेंट पूरा नहीं हो पाया। कृपया अपने पेमेंट ऐप में स्टेटस चेक करें।");
        } else {
          statusText.textContent = "पेमेंट का इंतज़ार है…";
        }
      } catch (error) {
        console.error("Payment status check failed:", error);
      }
    }

    function stopPaymentChecks() {
      if (pollingInterval) clearInterval(pollingInterval);
      if (countdownInterval) clearInterval(countdownInterval);
    }

    function showResult(type, title, message) {
      resultCard.classList.toggle("failed", type !== "success");
      resultIcon.textContent = type === "success" ? "✓" : "!";
      resultTitle.textContent = title;
      resultMessage.textContent = message;
      resultOverlay.style.display = "flex";
    }

    function playPaymentSuccessAudio() {
      paymentSuccessAudio.currentTime = 0;

      paymentSuccessAudio.play().then(() => {
        playSoundFallback.style.display = "none";
      }).catch(() => {
        // कुछ मोबाइल ब्राउज़र async payment success पर autoplay रोक सकते हैं।
        playSoundFallback.style.display = "block";
      });
    }

    playSoundFallback.addEventListener("click", () => {
      paymentSuccessAudio.play().catch(error => {
        console.error("Audio playback failed:", error);
      });
    });

    continueBtn.addEventListener("click", () => {
      if (redirectUrl) {
        window.location.href = redirectUrl;
      } else {
        resultOverlay.style.display = "none";
      }
    });
  </script>
</body>
</html>
