
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">

    <title>Secure Payment | Upay</title>

    <script src="/js/speak.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            color: #0f172a;
        }

        .payment-card {
            animation: cardEnter .65s cubic-bezier(.16, 1, .3, 1);
        }

        @keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(24px) scale(.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .qr-frame {
            background: linear-gradient(135deg, #6366f1, #a855f7, #6366f1);
            background-size: 200% 200%;
            animation: gradientMove 5s ease infinite;
        }

        @keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .qr-image {
            animation: qrEnter .6s cubic-bezier(.16, 1, .3, 1);
        }

        @keyframes qrEnter {
            from {
                opacity: 0;
                transform: scale(.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .scan-line {
            position: absolute;
            left: 10%;
            right: 10%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #6366f1, transparent);
            box-shadow: 0 0 12px #818cf8;
            animation: scan 3s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes scan {
            0%, 100% { top: 12%; opacity: 0; }
            20% { opacity: .8; }
            80% { opacity: .8; }
            90% { top: 88%; opacity: 0; }
        }

        .secure-dot {
            animation: securePulse 2s infinite;
        }

        @keyframes securePulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, .25); }
            50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        }

        .popup-overlay {
            background: rgba(15, 23, 42, .65);
            backdrop-filter: blur(10px);
        }

        .popup-enter {
            animation: popupEnter .4s cubic-bezier(.2, 1.2, .4, 1);
        }

        @keyframes popupEnter {
            from { opacity: 0; transform: scale(.92) translateY(12px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .success-circle {
            animation: successPop .6s cubic-bezier(.2, 1.4, .4, 1);
        }

        @keyframes successPop {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }

        .progress-fill {
            width: 0;
            animation: progressFill 3s linear forwards;
        }

        @keyframes progressFill {
            to { width: 100%; }
        }

        .stage-hidden {
            display: none !important;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4 sm:p-6">

    <main id="payment-card" class="payment-card w-full max-w-5xl">

        <!-- Header -->
        <div class="flex items-center justify-between mb-5 px-1">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                              d="M12 3v18m9-9H3"/>
                    </svg>
                </div>

                <div>
                    <h1 class="text-xl font-extrabold tracking-tight text-slate-900">
                        Upay<span class="text-indigo-600">.</span>
                    </h1>
                    <p class="text-xs text-slate-500">Secure Checkout</p>
                </div>
            </div>

            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-100 px-3 py-2 rounded-full">
                <span class="secure-dot w-2 h-2 bg-emerald-500 rounded-full"></span>
                Secure Payment
            </div>
        </div>

        <!-- Main Card -->
        <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/70 border border-slate-200/70 overflow-hidden">

            <div class="grid lg:grid-cols-12">

                <!-- Left: Payment Summary -->
                <section class="lg:col-span-5 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white p-7 sm:p-9 flex flex-col justify-between">

                    <div>
                        <div class="flex items-center justify-between mb-8">
                            <span class="text-xs font-bold uppercase tracking-widest text-indigo-200">
                                Payment Summary
                            </span>

                            <span class="text-xs font-mono text-slate-400">
                                #<%= tid %>
                            </span>
                        </div>

                        <div class="flex items-center gap-4 mb-8">
                            <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center overflow-hidden">
                                <img
                                    src="<%= logo %>"
                                    alt="<%= company %>"
                                    class="w-full h-full object-contain p-2"
                                    onerror="this.style.display='none'"
                                >
                            </div>

                            <div>
                                <h2 class="font-bold text-lg">
                                    <%= company %>
                                </h2>
                                <p class="text-sm text-indigo-200">
                                    Merchant
                                </p>
                            </div>
                        </div>

                        <p class="text-sm text-slate-400 mb-2">
                            Total amount payable
                        </p>

                        <div class="flex items-baseline gap-1">
                            <span class="text-2xl font-semibold text-indigo-200">₹</span>

                            <span class="text-5xl sm:text-6xl font-extrabold tracking-tight">
                                <%= Number(amount).toLocaleString("en-IN", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                            </span>
                        </div>

                        <div class="mt-8 border-t border-white/10 pt-5 space-y-4">

                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Payment ID</span>
                                <span class="font-mono text-slate-200">#<%= tid %></span>
                            </div>

                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Payment method</span>
                                <span class="font-semibold text-white">UPI</span>
                            </div>

                            <div class="flex justify-between text-sm">
                                <span class="text-slate-400">Convenience fee</span>
                                <span class="text-emerald-300 font-semibold">₹0.00</span>
                            </div>
                        </div>
                    </div>

                    <!-- Security Information -->
                    <div class="mt-10 pt-5 border-t border-white/10">
                        <div class="flex items-center gap-3 mb-3">
                            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4"/>
                            </svg>

                            <span class="text-sm font-semibold text-white">
                                Protected Checkout
                            </span>
                        </div>

                        <p class="text-xs leading-relaxed text-slate-400">
                            Complete your payment using your preferred UPI app.
                            Never share your UPI PIN or OTP with anyone.
                        </p>
                    </div>

                </section>

                <!-- Right: QR Payment -->
                <section class="lg:col-span-7 p-6 sm:p-10 flex flex-col items-center">

                    <div class="w-full max-w-md text-center">

                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold mb-5">
                            <span class="w-2 h-2 bg-indigo-500 rounded-full animate-pulse"></span>
                            Scan & Pay
                        </div>

                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                            Complete your payment
                        </h2>

                        <p class="text-sm text-slate-500 mt-2">
                            Scan the QR code using any UPI payment app
                        </p>

                        <!-- QR Code -->
                        <div class="qr-frame p-1.5 rounded-3xl shadow-xl shadow-indigo-200/50 mt-7 inline-block">
                            <div class="relative bg-white p-4 rounded-[20px]">
                                <img
                                    id="qr-image"
                                    src="<%= obj %>"
                                    alt="UPI Payment QR Code"
                                    class="qr-image w-52 h-52 sm:w-60 sm:h-60 object-contain"
                                    crossorigin="anonymous"
                                >

                                <div class="scan-line"></div>
                            </div>
                        </div>

                        <div class="flex items-center justify-center gap-2 mt-4 text-xs text-slate-500">
                            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>

                            <span>Secure UPI payment</span>
                        </div>

                        <!-- Download QR -->
                        <button
                            type="button"
                            id="download-qr"
                            class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-indigo-200 transition active:scale-95"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                            </svg>

                            Save QR Code
                        </button>

                        <!-- Instructions -->
                        <div class="mt-8 bg-slate-50 rounded-2xl border border-slate-100 p-4 text-left">

                            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-4">
                                How to pay
                            </h3>

                            <div class="space-y-4">

                                <div class="flex gap-3 items-start">
                                    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold flex items-center justify-center">
                                        1
                                    </span>

                                    <p class="text-sm text-slate-600">
                                        Open Google Pay, PhonePe, Paytm or any UPI app.
                                    </p>
                                </div>

                                <div class="flex gap-3 items-start">
                                    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold flex items-center justify-center">
                                        2
                                    </span>

                                    <p class="text-sm text-slate-600">
                                        Scan the QR code and verify the amount.
                                    </p>
                                </div>

                                <div class="flex gap-3 items-start">
                                    <span class="flex-shrink-0 w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold flex items-center justify-center">
                                        3
                                    </span>

                                    <p class="text-sm text-slate-600">
                                        Complete the payment in your UPI app.
                                    </p>
                                </div>

                            </div>
                        </div>

                        <!-- Waiting Status -->
                        <div class="mt-6 flex items-center justify-center gap-2 text-sm text-slate-500">
                            <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse"></span>
                            Waiting for payment confirmation...
                        </div>

                    </div>
                </section>
            </div>

            <!-- Footer -->
            <footer class="bg-slate-50 border-t border-slate-100 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">

                <div class="flex items-center gap-2 text-xs text-slate-500">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/>
                    </svg>

                    Secure transaction
                </div>

                <div class="flex items-center gap-2 text-xs font-semibold text-rose-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 7v5l3 2"/>
                    </svg>

                    Expires in
                    <span id="timer" class="font-mono tabular-nums">05:00</span>
                </div>

            </footer>

        </div>

        <p class="text-center text-xs text-slate-400 mt-5">
            Powered by Upay Checkout
        </p>

    </main>

    <!-- Popup Overlay -->
    <div
        id="popup-overlay"
        class="stage-hidden fixed inset-0 z-50 popup-overlay flex items-center justify-center p-5"
        role="dialog"
        aria-modal="true"
        aria-live="assertive"
    >

        <!-- Success -->
        <div id="success-popup" class="stage-hidden popup-enter bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">

            <div class="success-circle w-20 h-20 rounded-full bg-emerald-500 flex items-center justify-center mx-auto mb-5 shadow-lg shadow-emerald-200">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                          d="M6 12l4 4 8-8"/>
                </svg>
            </div>

            <h2 class="text-2xl font-extrabold text-slate-900">
                Payment Successful!
            </h2>

            <p class="text-sm text-slate-500 mt-2">
                Your payment has been verified.
            </p>

            <p class="text-3xl font-extrabold text-slate-900 mt-5">
                ₹<span id="success-amount">0.00</span>
            </p>

            <div class="mt-5 bg-slate-50 rounded-xl p-3 text-left">
                <p class="text-xs text-slate-400">Transaction Reference</p>
                <p id="utr" class="text-sm font-mono font-semibold text-slate-700 mt-1 break-all"></p>
            </div>

            <p class="text-xs text-slate-400 mt-5">
                Redirecting you to merchant...
            </p>

            <div class="h-1 bg-slate-100 rounded-full overflow-hidden mt-4">
                <div class="progress-fill h-full bg-emerald-500 rounded-full"></div>
            </div>

        </div>

        <!-- Timeout -->
        <div id="timeout-popup" class="stage-hidden popup-enter bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">

            <div class="w-20 h-20 rounded-full bg-rose-100 flex items-center justify-center mx-auto mb-5">
                <svg class="w-10 h-10 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>

            <h2 class="text-2xl font-extrabold text-slate-900">
                Session Expired
            </h2>

            <p class="text-sm text-slate-500 mt-3">
                This payment session has expired. Refresh the page to generate a new QR code.
            </p>

            <button
                type="button"
                onclick="location.reload()"
                class="mt-6 w-full py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition"
            >
                Refresh Page
            </button>

        </div>

        <!-- Failed -->
        <div id="failed-popup" class="stage-hidden popup-enter bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">

            <div class="w-20 h-20 rounded-full bg-rose-100 flex items-center justify-center mx-auto mb-5">
                <svg class="w-10 h-10 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v4m0 4h.01M10.3 3.9l-8 14A2 2 0 004 21h16a2 2 0 001.7-3.1l-8-14a2 2 0 00-3.4 0z"/>
                </svg>
            </div>

            <h2 class="text-2xl font-extrabold text-slate-900">
                Payment Failed
            </h2>

            <p id="failed-message" class="text-sm text-slate-500 mt-3">
                Transaction could not be completed.
            </p>

            <button
                type="button"
                onclick="location.reload()"
                class="mt-6 w-full py-3 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition"
            >
                Try Again
            </button>

        </div>

    </div>

    <script>
        // --------------------------------------------------
        // Payment configuration
        // --------------------------------------------------

        const AMOUNT = Number("<%= amount %>") || 0;
        const TID = "<%= tid %>";

        let pollTimer = null;
        let countdownTimer = null;

        let isPollingStopped = false;
        let timeInSeconds = 300;

        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        ).matches;

        const doneSound = new Audio("/assets/done.mp3");

        const timerElement = document.getElementById("timer");
        const overlay = document.getElementById("popup-overlay");

        const popups = {
            success: document.getElementById("success-popup"),
            timeout: document.getElementById("timeout-popup"),
            failed: document.getElementById("failed-popup")
        };

        // --------------------------------------------------
        // Payment status popup
        // --------------------------------------------------

        function showPopup(type) {
            Object.values(popups).forEach(popup => {
                popup.classList.add("stage-hidden");
            });

            overlay.classList.remove("stage-hidden");
            popups[type].classList.remove("stage-hidden");

            if (type === "success") {
                playSuccess();
            }
        }

        function stopPolling() {
            isPollingStopped = true;

            if (pollTimer) {
                clearTimeout(pollTimer);
                pollTimer = null;
            }

            if (countdownTimer) {
                clearInterval(countdownTimer);
                countdownTimer = null;
            }
        }

        // --------------------------------------------------
        // Countdown timer
        // --------------------------------------------------

        function startCountdown() {
            updateTimer();

            countdownTimer = setInterval(() => {
                if (timeInSeconds <= 0) {
                    stopPolling();
                    showPopup("timeout");
                    return;
                }

                timeInSeconds--;
                updateTimer();

            }, 1000);
        }

        function updateTimer() {
            const minutes = Math.floor(timeInSeconds / 60);
            const seconds = timeInSeconds % 60;

            timerElement.textContent =
                String(minutes).padStart(2, "0") + ":" +
                String(seconds).padStart(2, "0");
        }

        // --------------------------------------------------
        // Payment success animation
        // --------------------------------------------------

        function playSuccess() {
            const amountElement = document.getElementById("success-amount");

            amountElement.textContent = AMOUNT.toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            if (!reduceMotion) {
                doneSound.play().catch(() => {});
            }
        }

        // --------------------------------------------------
        // Download QR Code
        // --------------------------------------------------

        async function downloadQR() {
            const img = document.getElementById("qr-image");

            if (!img.src) {
                alert("QR code is not available.");
                return;
            }

            try {
                const response = await fetch(img.src);

                if (!response.ok) {
                    throw new Error("QR download failed");
                }

                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);

                const link = document.createElement("a");

                link.href = blobUrl;
                link.download = `Payment_QR_${TID}.png`;

                document.body.appendChild(link);
                link.click();
                link.remove();

                setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);

            } catch (error) {
                window.open(img.src, "_blank", "noopener");
            }
        }

        document.getElementById("download-qr").addEventListener(
            "click",
            downloadQR
        );

        // --------------------------------------------------
        // Payment status polling
        // --------------------------------------------------

        async function checkPaymentStatus() {
            if (isPollingStopped) return;

            try {
                const response = await fetch(
                    "/pay/status/" + encodeURIComponent(TID),
                    {
                        method: "GET",
                        cache: "no-store",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error("Payment status request failed");
                }

                const data = await response.json();

                if (
                    data.status === true ||
                    data.state === "SUCCESS"
                ) {
                    stopPolling();

                    document.getElementById("utr").textContent =
                        data.utr || "Verified";

                    showPopup("success");

                    if (typeof speak === "function") {
                        speak("Payment received successfully.");
                    }

                    setTimeout(() => {
                        window.location.href = "<%= redirect %>";
                    }, 3000);

                    return;
                }

                if (data.state === "FAILED") {
                    stopPolling();

                    document.getElementById("failed-message").textContent =
                        data.message ||
                        "Transaction was rejected or cancelled.";

                    showPopup("failed");

                    return;
                }

            } catch (error) {
                console.warn("Payment status retry:", error);
            }

            if (!isPollingStopped) {
                pollTimer = setTimeout(checkPaymentStatus, 3000);
            }
        }

        // --------------------------------------------------
        // Start payment session
        // --------------------------------------------------

        startCountdown();

        pollTimer = setTimeout(checkPaymentStatus, 2000);

    </script>

</body>
</html>
