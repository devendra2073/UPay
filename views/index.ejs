<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pay with Upay</title>
    <script src="/js/speak.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: radial-gradient(circle at top center, #e0e7ff 0%, #f8fafc 60%, #f1f5f9 100%);
            min-height: 100vh;
        }
        .qr-gradient { 
            background: linear-gradient(135deg, #4f46e5 0%, #9333ea 50%, #c084fc 100%);
            box-shadow: 0 20px 40px -15px rgba(79, 70, 229, 0.35);
        }
        .modal-overlay { 
            background: rgba(15, 23, 42, 0.75); 
            backdrop-filter: blur(12px); 
        }

        /* ---------- Smooth Card Transition & Glassmorphism ---------- */
        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.03);
        }

        .stage-transition {
            transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), 
                        transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), 
                        filter 0.5s ease;
        }
        .stage-hidden {
            opacity: 0;
            transform: scale(0.95) translateY(16px);
            pointer-events: none;
            position: absolute;
            filter: blur(6px);
        }
        .stage-visible {
            opacity: 1;
            transform: scale(1) translateY(0);
            pointer-events: auto;
            position: relative;
            filter: blur(0);
        }

        /* ---------- Glowing Elements ---------- */
        .btn-glow {
            box-shadow: 0 12px 30px -6px rgba(79, 70, 229, 0.5);
        }
        .btn-glow:hover {
            box-shadow: 0 16px 36px -6px rgba(79, 70, 229, 0.7);
        }

        .qr-glow {
            box-shadow: 0 0 35px rgba(99, 102, 241, 0.2);
        }

        /* ---------- Popup entrance ---------- */
        .popup-in { animation: popIn .4s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }
        @keyframes popIn { 
            from { opacity: 0; transform: scale(.9) translateY(15px); } 
            to { opacity: 1; transform: none; } 
        }

        /* ---------- Animated badge (success / error) ---------- */
        .badge { width: 96px; height: 96px; margin: 0 auto 16px; }
        .badge svg { width: 100%; height: 100%; overflow: visible; display: block; }
        .b-disc { transform-origin: 50% 50%; animation: discPop .5s cubic-bezier(.2, 1.4, .4, 1) .1s both; }
        .b-ring { fill: none; stroke-width: 2.5; transform-origin: 50% 50%; opacity: 0; animation: ringPulse 1.4s ease-out .7s 1; }
        .b-draw { 
            fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round;
            stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw .45s ease-out .5s forwards; 
        }
        .b-draw.d2 { animation-delay: .75s; }
        @keyframes discPop { from { transform: scale(0); } to { transform: scale(1); } }
        @keyframes draw { to { stroke-dashoffset: 0; } }
        @keyframes ringPulse { 0% { opacity: .6; transform: scale(1); } 100% { opacity: 0; transform: scale(1.8); } }

        /* ---------- Success extras ---------- */
        .fade-up { opacity: 0; transform: translateY(6px); animation: fadeUp .4s ease-out forwards; }
        @keyframes fadeUp { to { opacity: 1; transform: none; } }
        .redirect-bar { height: 4px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
        .redirect-bar > span { display: block; height: 100%; width: 0; background: #16a34a; border-radius: 99px; }
        .redirect-bar.run > span { animation: fill 3s linear forwards; }
        @keyframes fill { to { width: 100%; } }

        .bit { 
            position: absolute; top: 90px; left: 50%; width: 8px; height: 12px; border-radius: 2px; opacity: 0; pointer-events: none;
            animation: fall var(--t) cubic-bezier(.15, .7, .4, 1) var(--d) forwards; 
        }
        @keyframes fall { 
            0% { opacity: 1; transform: translate(0, 0) rotate(0); }
            100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)); } 
        }

        /* ---------- Custom Illustration Animations ---------- */
        .float-anim { animation: floatSlow 4s ease-in-out infinite; }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .pulse-subtle { animation: pulseGlow 3s ease-in-out infinite; }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        .signal-wave {
            stroke-dasharray: 8;
            animation: dashWave 1.8s linear infinite;
        }
        @keyframes dashWave {
            to { stroke-dashoffset: -16; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01s !important; animation-delay: 0s !important; }
            .bit { display: none; }
            .float-anim, .pulse-subtle, .signal-wave { animation: none !important; }
            .stage-transition { transition: none !important; }
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4 sm:p-6 lg:p-10 relative overflow-x-hidden">

    <!-- Ambient Glow Background Blobs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-400/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-purple-400/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- STEP 1: Animated Soft Intro Screen -->
    <div id="intro-card" class="stage-transition stage-visible w-full max-w-md glass-card rounded-3xl p-8 text-center relative z-10">
        <!-- Brand / Header -->
        <div class="flex items-center justify-between mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold tracking-wider bg-indigo-50 text-indigo-600 uppercase border border-indigo-100/50">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 animate-pulse"></span>
                Secure Checkout
            </span>
            <span class="text-xs font-mono text-slate-400 font-semibold">#<%=tid%></span>
        </div>

        <!-- Logo Container -->
        <div class="relative w-24 h-24 mx-auto mb-5">
            <div class="absolute inset-0 bg-indigo-200/50 rounded-full animate-ping opacity-30"></div>
            <div class="relative w-24 h-24 bg-white rounded-2xl flex items-center justify-center border-2 border-indigo-50 shadow-xl overflow-hidden p-3 transform hover:scale-105 transition duration-300">
                <img 
                    src="<%=logo%>" 
                    alt="<%=company%>" 
                    class="w-full h-full object-contain" 
                    onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('<%=company%>') + '&background=6366f1&color=fff'" 
                />
            </div>
        </div>

        <h3 class="text-lg font-bold text-slate-800 tracking-tight"><%=company%></h3>
        <p class="text-xs font-medium text-slate-400 mt-0.5">Verified Merchant Payment</p>

        <!-- Amount Box -->
        <div class="my-6 py-6 px-5 bg-gradient-to-br from-slate-50/90 to-indigo-50/40 rounded-2xl border border-slate-200/60 shadow-inner">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-1">Total Amount Payable</span>
            <span class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">
                &#8377;<%= Number(amount).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </span>
        </div>

        <!-- Proceed Button -->
        <button 
            type="button" 
            id="btn-proceed" 
            onclick="revealMainGateway()"
            class="btn-glow w-full py-4 px-6 bg-gradient-to-r from-indigo-600 via-indigo-700 to-purple-600 text-white font-bold rounded-2xl flex items-center justify-center gap-3 hover:opacity-95 active:scale-[0.98] transition-all cursor-pointer group">
            <span class="text-base tracking-wide">Proceed to Pay</span>
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </button>

        <div class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-500 font-medium">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>256-Bit Bank Grade UPI Encryption</span>
        </div>
    </div>

    <!-- STEP 2: Main Payment Container (Hidden initially) -->
    <div id="payment-card" class="stage-transition stage-hidden glass-card w-full max-w-md lg:max-w-4xl rounded-3xl overflow-hidden relative z-10">

        <div class="lg:grid lg:grid-cols-12 min-h-[580px]">

            <!-- Left Panel -->
            <div class="lg:col-span-5 bg-gradient-to-b from-slate-50/80 via-indigo-50/20 to-purple-50/10 p-6 sm:p-8 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-slate-200/60">
                <div>
                    <!-- Header Info -->
                    <div class="flex justify-between items-center mb-6">
                        <span class="text-xs font-extrabold tracking-widest text-indigo-600 uppercase">Upay Gateway</span>
                        <span class="text-xs font-mono text-slate-400 uppercase tracking-tight">#<%=tid%></span>
                    </div>

                    <div class="text-center lg:text-left">
                        <div class="relative w-20 h-20 mx-auto lg:mx-0 mb-4">
                            <div class="absolute inset-0 bg-indigo-100 rounded-2xl animate-pulse opacity-60"></div>
                            <div class="relative w-20 h-20 bg-white rounded-2xl flex items-center justify-center border-2 border-indigo-50 shadow-md overflow-hidden p-2">
                                <img 
                                    src="<%=logo%>" 
                                    alt="<%=company%>" 
                                    class="w-full h-full object-contain" 
                                    onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('<%=company%>') + '&background=6366f1&color=fff'" 
                                />
                            </div>
                        </div>

                        <h2 class="text-xl font-bold text-slate-900 tracking-tight"><%=company%></h2>
                        <p class="text-3xl sm:text-4xl font-black text-slate-900 mt-2">
                            &#8377;<%= Number(amount).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </p>
                    </div>
                </div>

                <!-- Animated Payment Illustration -->
                <div class="hidden lg:flex flex-col items-center justify-center my-6 relative py-4">
                    <svg class="w-56 h-44 drop-shadow-lg" viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <ellipse class="pulse-subtle" cx="140" cy="115" rx="85" ry="40" fill="#e0e7ff"/>
                        <g class="float-anim">
                            <rect x="40" y="55" width="130" height="85" rx="12" fill="#4f46e5" fill-opacity="0.95"/>
                            <rect x="40" y="75" width="130" height="18" fill="#3730a3"/>
                            <circle cx="65" cy="112" r="7" fill="#fcd34d"/>
                            <circle cx="80" cy="112" r="7" fill="#f87171" fill-opacity="0.8"/>
                            <rect x="105" y="108" width="45" height="7" rx="3.5" fill="#c7d2fe"/>
                        </g>
                        <g transform="translate(130, 20)">
                            <rect x="0" y="0" width="90" height="145" rx="16" fill="#1e1b4b"/>
                            <rect x="5" y="6" width="80" height="133" rx="12" fill="#ffffff"/>
                            <rect x="35" y="9" width="20" height="3" rx="1.5" fill="#cbd5e1"/>
                            <rect x="18" y="28" width="54" height="54" rx="8" fill="#f8fafc" stroke="#818cf8" stroke-width="1.5" stroke-dasharray="3 3"/>
                            <path class="signal-wave" d="M24 55 H66" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                            <rect x="15" y="94" width="60" height="16" rx="8" fill="#dcfce7"/>
                            <circle cx="24" cy="102" r="4" fill="#16a34a"/>
                            <rect x="33" y="100" width="34" height="4" rx="2" fill="#15803d"/>
                        </g>
                        <g transform="translate(100, 95)" class="float-anim" style="animation-delay: -1.8s;">
                            <circle cx="20" cy="20" r="18" fill="#ffffff" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.1))"/>
                            <path d="M20 10 L28 14 V20 C28 25 24 28 20 30 C16 28 12 25 12 20 V14 L20 10 Z" fill="#6366f1"/>
                            <path d="M17 20 L19 22 L23 18" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </g>
                    </svg>
                    <span class="text-xs font-semibold text-slate-500 mt-2">Instant UPI Settlement</span>
                </div>

                <!-- Desktop Helper Notes -->
                <div class="hidden lg:block text-xs text-slate-500 space-y-2 pt-4 border-t border-slate-200/60">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        <span>Verified Merchant Gateway</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                        <span>Instant auto-confirmation</span>
                    </div>
                </div>
            </div>

            <!-- Right Panel (QR Centerpiece) -->
            <div class="lg:col-span-7 flex flex-col justify-between">
                
                <!-- QR Code Section -->
                <div class="p-6 sm:p-10 text-center flex-1 flex flex-col justify-center items-center">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100/60 text-indigo-700 text-xs font-bold mb-6">
                        <svg class="w-4 h-4 text-indigo-600 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Scan with any UPI App to Pay</span>
                    </div>
                    
                    <div class="qr-gradient p-2.5 inline-block rounded-3xl qr-glow mb-4 transform hover:scale-[1.02] transition duration-300">
                        <div class="bg-white p-4 rounded-2xl shadow-inner">
                            <img id="qr-image" src="<%=obj%>" alt="UPI QR Code" class="w-48 h-48 sm:w-56 sm:h-56 object-contain mx-auto" crossorigin="anonymous">
                        </div>
                    </div>

                    <button type="button" onclick="downloadQR()" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold text-indigo-600 bg-indigo-50/80 hover:bg-indigo-100 border border-indigo-100 uppercase tracking-wider transition-all active:scale-95 cursor-pointer">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        Download QR Code
                    </button>

                    <!-- Supported Apps Badges -->
                    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 opacity-80">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider w-full mb-1">Supported Applications</span>
                        <span class="px-3 py-1 bg-slate-100 rounded-lg text-xs font-semibold text-slate-600 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span> Google Pay
                        </span>
                        <span class="px-3 py-1 bg-slate-100 rounded-lg text-xs font-semibold text-slate-600 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-purple-500"></span> PhonePe
                        </span>
                        <span class="px-3 py-1 bg-slate-100 rounded-lg text-xs font-semibold text-slate-600 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-cyan-500"></span> Paytm
                        </span>
                        <span class="px-3 py-1 bg-slate-100 rounded-lg text-xs font-semibold text-slate-600 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> BHIM & More
                        </span>
                    </div>
                </div>

                <!-- Footer / Timer -->
                <div class="bg-slate-50/80 px-6 sm:px-8 py-4 flex justify-between items-center text-xs font-bold text-slate-500 uppercase tracking-wider border-t border-slate-200/60">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse shadow-sm shadow-emerald-500/50"></span>
                        <span class="text-slate-700">Live Status Active</span>
                    </div>
                    <div class="flex items-center text-rose-600 bg-rose-50 px-3 py-1 rounded-lg border border-rose-100">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Expires in <span id="timer" class="font-mono font-extrabold ml-0.5">05:00</span></span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Overlays (Success / Timeout / Failed) -->
        <div id="popup-overlay" class="hidden absolute inset-0 modal-overlay z-50 flex items-center justify-center p-6" role="dialog" aria-modal="true" aria-live="assertive">

            <!-- Success Popup -->
            <div id="success-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl relative overflow-hidden">
                <div id="confetti"></div>
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#16a34a"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#16a34a"/>
                        <path class="b-draw" d="M30 50 L43 63 L67 36"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800">Payment Successful</h3>
                <p class="text-3xl font-black text-slate-900 mt-3 tabular-nums">&#8377;<span id="success-amount">0.00</span></p>
                <p class="text-slate-500 text-sm mt-2 fade-up" style="animation-delay:.9s">Transfer verified. Taking you back to <%=company%>…</p>
                <p class="text-slate-400 text-xs mt-3 fade-up" style="animation-delay:1.1s"><b>UTR:</b> <span id="utr" class="font-mono text-slate-700"></span></p>
                <div id="redirect-bar" class="redirect-bar mt-5"><span></span></div>
            </div>

            <!-- Timeout Popup -->
            <div id="timeout-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M32 32 L64 64"/>
                        <path class="b-draw d2" d="M64 32 L32 64"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800">Time's Up</h3>
                <p class="text-slate-500 text-sm mt-2">For your security, this session has expired. Refresh to generate a new QR code.</p>
                <button type="button" onclick="location.reload()" class="mt-6 w-full py-3.5 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 transition cursor-pointer shadow-lg shadow-indigo-600/30">Refresh Page</button>
            </div>

            <!-- Failed Popup -->
            <div id="failed-popup" class="hidden popup-in bg-white rounded-3xl p-8 text-center w-full max-w-sm shadow-2xl">
                <div class="badge" aria-hidden="true">
                    <svg viewBox="0 0 96 96">
                        <circle class="b-ring" cx="48" cy="48" r="44" stroke="#dc2626"/>
                        <circle class="b-disc" cx="48" cy="48" r="42" fill="#dc2626"/>
                        <path class="b-draw" d="M48 28 L48 52"/>
                        <path class="b-draw d2" d="M48 65 L48 66"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800">Payment Failed</h3>
                <p id="failed-message" class="text-slate-500 text-sm mt-2">Transaction could not be completed.</p>
                <button type="button" onclick="location.reload()" class="mt-6 w-full py-3.5 bg-slate-900 text-white rounded-2xl font-bold hover:bg-slate-800 transition cursor-pointer">Try Again</button>
            </div>

        </div>
    </div>

    <script>
        // --- Core Application State & Timers ---
        let pollTimer = null;
        let countdownTimer = null;
        let isPollingStopped = false;
        let timeInSeconds = 300;

        const AMOUNT = Number("<%=amount%>") || 0;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const doneSound = new Audio("/assets/done.mp3");

        const timerElement = document.getElementById('timer');
        const overlay = document.getElementById('popup-overlay');
        const popups = {
            timeout: document.getElementById('timeout-popup'),
            success: document.getElementById('success-popup'),
            failed: document.getElementById('failed-popup')
        };

        // Unlock audio on first user gesture
        const unlockAudio = () => {
            doneSound.load();
            window.removeEventListener('click', unlockAudio);
            window.removeEventListener('touchstart', unlockAudio);
        };
        window.addEventListener('click', unlockAudio, { once: true });
        window.addEventListener('touchstart', unlockAudio, { once: true });

        // --- Stage Transition Function ---
        function revealMainGateway() {
            const introCard = document.getElementById('intro-card');
            const paymentCard = document.getElementById('payment-card');

            // 1. Fade out Intro Card
            introCard.classList.remove('stage-visible');
            introCard.classList.add('stage-hidden');

            // 2. Soft reveal Main Payment Gateway
            setTimeout(() => {
                introCard.style.display = 'none';
                paymentCard.classList.remove('stage-hidden');
                paymentCard.classList.add('stage-visible');

                // 3. Start Timer & Status Polling ONLY after the user proceeds
                startCountdown();
                pollTimer = setTimeout(checkPaymentStatus, 2000);
            }, 300);
        }

        // 1. Timer Countdown
        function startCountdown() {
            countdownTimer = setInterval(() => {
                const minutes = Math.floor(timeInSeconds / 60);
                const seconds = timeInSeconds % 60;
                timerElement.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                if (timeInSeconds <= 0) {
                    stopPolling();
                    showPopup('timeout');
                    return;
                }
                timeInSeconds--;
            }, 1000);
        }

        function showPopup(type) {
            Object.values(popups).forEach(p => p.classList.add('hidden'));
            overlay.classList.remove('hidden');
            popups[type].classList.remove('hidden');
            if (type === 'success') playSuccess();
        }

        function stopPolling() {
            isPollingStopped = true;
            if (pollTimer) clearTimeout(pollTimer);
            if (countdownTimer) clearInterval(countdownTimer);
        }

        // Success Animation
        function playSuccess() {
            const out = document.getElementById('success-amount');
            const fmt = v => v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('redirect-bar').classList.add('run');

            if (reduceMotion) {
                out.textContent = fmt(AMOUNT);
                return;
            }

            const start = performance.now(), delay = 500, dur = 1000;
            (function tick(now) {
                const p = Math.min(Math.max((now - start - delay) / dur, 0), 1);
                out.textContent = fmt(AMOUNT * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(tick);
            })(start);

            const box = document.getElementById('confetti');
            const colors = ['#16a34a', '#4ade80', '#f59e0b', '#6366f1', '#ef4444'];
            for (let i = 0; i < 26; i++) {
                const b = document.createElement('span');
                b.className = 'bit';
                const a = (Math.PI * 2 * i / 26) + Math.random() * .4;
                const d = 90 + Math.random() * 110;
                b.style.background = colors[i % colors.length];
                b.style.setProperty('--x', Math.cos(a) * d + 'px');
                b.style.setProperty('--y', (Math.sin(a) * d * .8 + 60) + 'px');
                b.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
                b.style.setProperty('--t', (1.1 + Math.random() * .6) + 's');
                b.style.setProperty('--d', (.6 + Math.random() * .1) + 's');
                box.appendChild(b);
            }
        }

        // 2. Cross-origin Safe QR Download
        async function downloadQR() {
            const img = document.getElementById('qr-image');
            const fileName = `Payment_QR_${Date.now()}.png`;

            try {
                const response = await fetch(img.src);
                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(blobUrl);
            } catch (err) {
                const link = document.createElement('a');
                link.href = img.src;
                link.target = '_blank';
                link.download = fileName;
                link.click();
            }
        }

        // 3. Reliable Recursive Polling
        const checkPaymentStatus = async () => {
            if (isPollingStopped) return;

            try {
                const response = await fetch("/pay/status/<%=tid%>");
                const data = await response.json();

                if (data.status === true || data.state === "SUCCESS") {
                    stopPolling();
                    document.getElementById("utr").innerText = data.utr || "Verified";
                    showPopup("success");
                    speak("Payment recieved of ruppees <%=amount%> ");
                    doneSound.play().catch(() => {});

                    setTimeout(() => {
                        location.href = "<%=redirect%>";
                    }, 3000);
                    return;
                }

                if (data.state === "FAILED") {
                    stopPolling();
                    document.getElementById("failed-message").innerText = data.message || "Payment was rejected or cancelled.";
                    showPopup("failed");
                    return;
                }

            } catch (e) {
                console.warn("Polling network retry:", e);
            }

            if (!isPollingStopped) {
                pollTimer = setTimeout(checkPaymentStatus, 3000);
            }
        };
    </script>
</body>
</html>
