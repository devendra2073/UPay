<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UPay | Transaction & Audit Details</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            upay: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              accent: '#8b5cf6',
              emerald: '#10b981',
              dark: '#0b0f19',
              card: '#111827',
              border: '#1f293d',
            }
          }
        }
      }
    }
  </script>
  <style>
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0f19;
    }
    ::-webkit-scrollbar-thumb {
      background: #27354f;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3b4d6e;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background-color: white !important;
        color: black !important;
      }
      .print-border {
        border: 1px solid #e5e7eb !important;
      }
    }
  </style>
</head>
<body class="bg-[#090d16] text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Container -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-2.5 bg-slate-900/95 border border-indigo-500/40 text-slate-100 text-sm px-4 py-3 rounded-xl shadow-2xl backdrop-blur-md">
    <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
    <span id="toast-message" class="font-medium">Copied to clipboard</span>
  </div>

  <!-- Navigation Bar -->
  <header class="border-b border-slate-800/80 bg-[#0c1220]/70 backdrop-blur-xl sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Logo & Status -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a href="#" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 via-violet-600 to-emerald-400 p-[1.5px] shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform duration-200">
            <div class="w-full h-full bg-[#0d1322] rounded-[10px] flex items-center justify-center">
              <span class="text-transparent bg-clip-text bg-gradient-to-tr from-indigo-400 to-emerald-300 font-extrabold text-base tracking-tight">UP</span>
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <span class="text-base font-bold tracking-tight text-white">UPay</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded-full font-mono uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">Audit</span>
            </div>
            <span class="text-[10px] text-slate-400 -mt-1 hidden sm:inline">Transaction Telemetry</span>
          </div>
        </a>

        <div class="h-5 w-[1px] bg-slate-800 mx-1 hidden sm:block"></div>

        <div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="nav-payment-status">Payment Settled</span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3 no-print">
        <button onclick="copyCurrentUrl()" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 transition-all flex items-center gap-1.5" title="Share / Copy Link">
          <i data-lucide="share-2" class="w-3.5 h-3.5 text-slate-400"></i>
          <span class="hidden md:inline">Share</span>
        </button>

        <button onclick="window.print()" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 transition-all flex items-center gap-1.5" title="Print Receipt">
          <i data-lucide="printer" class="w-3.5 h-3.5 text-slate-400"></i>
          <span class="hidden md:inline">Print Receipt</span>
        </button>

        <button onclick="toggleJsonModal(true)" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-medium text-indigo-300 hover:text-white bg-indigo-950/40 hover:bg-indigo-900/50 border border-indigo-500/30 transition-all flex items-center gap-1.5">
          <i data-lucide="code-2" class="w-3.5 h-3.5 text-indigo-400"></i>
          <span class="hidden sm:inline">Raw Payload</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 flex-1 w-full">

    <!-- Top Banner: Transaction Summary Card -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-[#0e1628] to-[#12112b] border border-slate-800 p-5 sm:p-7 shadow-xl shadow-black/40">
      <div class="absolute -right-16 -top-16 w-56 h-56 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute right-1/3 -bottom-16 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 inline-flex items-center gap-1.5">
              <i data-lucide="check" class="w-3 h-3"></i> <span id="summary-status">Payment Successful</span>
            </span>
            <span class="text-xs text-slate-400 flex items-center gap-1 font-mono">
              <i data-lucide="calendar" class="w-3 h-3 text-slate-500"></i> <span id="summary-date">Loading...</span>
            </span>
          </div>

          <div class="flex items-baseline gap-3">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-sans" id="summary-amount">
              ₹0<span class="text-lg text-slate-400 font-normal">.00</span>
            </h1>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700" id="summary-currency">INR</span>
          </div>

          <p class="text-xs text-slate-400 mt-1 flex items-center gap-1">
            Order Reference: <span class="text-slate-200 font-mono font-medium" id="summary-order-id">ORD-XXXXXXXXXX</span>
            <button id="btn-copy-order-id" class="hover:text-indigo-400 ml-1" title="Copy Order ID">
              <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            </button>
          </p>
        </div>

        <!-- Badges & Quick Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 border-t md:border-t-0 md:border-l border-slate-800/80 pt-4 md:pt-0 md:pl-6 text-left">
          <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Payment Mode</p>
            <p class="text-sm font-semibold text-slate-100 flex items-center gap-1.5 mt-0.5">
              <i data-lucide="smartphone" class="w-4 h-4 text-indigo-400"></i> <span id="quick-payment-mode">UPI</span>
            </p>
          </div>
          <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Gateway Latency</p>
            <p class="text-sm font-semibold text-emerald-400 flex items-center gap-1.5 mt-0.5">
              <i data-lucide="zap" class="w-4 h-4 text-emerald-400"></i> <span id="quick-latency">184 ms</span>
            </p>
          </div>
          <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 col-span-2 sm:col-span-1">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Risk Score</p>
            <p class="text-sm font-semibold text-emerald-400 flex items-center gap-1.5 mt-0.5">
              <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i> <span id="quick-risk-score">99/100 (Safe)</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT COLUMN: Payment Info & Audit Timeline (7 cols) -->
      <div class="lg:col-span-7 space-y-6">

        <!-- Payment Info Section -->
        <section class="bg-slate-900/70 border border-slate-800/90 rounded-2xl p-5 sm:p-6 backdrop-blur-sm shadow-md">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-5">
            <div class="flex items-center gap-2.5">
              <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                <i data-lucide="credit-card" class="w-4 h-4"></i>
              </div>
              <h2 class="text-base font-semibold text-white">Payment Information</h2>
            </div>
            <span class="text-xs font-mono text-slate-400 bg-slate-800/70 px-2 py-1 rounded border border-slate-700/50" id="pg-id">PG_ID: UP-9921</span>
          </div>

          <!-- Key Identifiers Grid (UTR, Upay Txn ID) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-5">
            <!-- UTR -->
            <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-slate-700/80 transition-colors">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span>Bank UTR Number</span>
                <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-1.5 py-0.2 rounded font-mono">Verified</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-slate-100 select-all tracking-wide" id="val-utr">--</span>
                <button id="btn-copy-utr" class="p-1.5 text-slate-400 hover:text-indigo-400 hover:bg-slate-800 rounded-md transition-colors" title="Copy UTR">
                  <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <!-- Upay Transaction ID -->
            <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-slate-700/80 transition-colors">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span>UPay Transaction ID</span>
                <span class="text-[10px] text-indigo-400 bg-indigo-500/10 px-1.5 py-0.2 rounded font-mono">Unique</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-slate-100 select-all tracking-wide" id="val-upay-txn-id">--</span>
                <button id="btn-copy-upay-txn-id" class="p-1.5 text-slate-400 hover:text-indigo-400 hover:bg-slate-800 rounded-md transition-colors" title="Copy Upay ID">
                  <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Customer & Detailed Metadata list -->
          <div class="divide-y divide-slate-800/80 text-sm">
            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i> Customer Name
              </span>
              <span class="font-medium text-slate-100" id="val-customer-name">--</span>
            </div>

            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-500"></i> Email Address
              </span>
              <div class="flex items-center gap-1.5">
                <span class="font-medium text-slate-200 font-mono text-xs" id="val-customer-email">--</span>
                <button id="btn-copy-email" class="text-slate-400 hover:text-indigo-400">
                  <i data-lucide="copy" class="w-3 h-3"></i>
                </button>
              </div>
            </div>

            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-500"></i> Phone Number
              </span>
              <span class="font-mono text-slate-200 text-xs" id="val-customer-phone">--</span>
            </div>

            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="hash" class="w-3.5 h-3.5 text-slate-500"></i> Merchant Order ID
              </span>
              <span class="font-mono text-slate-200 text-xs" id="val-order-id">--</span>
            </div>

            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-500"></i> Payment Date & Time
              </span>
              <span class="text-slate-200 font-mono text-xs" id="val-payment-date">--</span>
            </div>

            <div class="py-3 flex items-center justify-between">
              <span class="text-slate-400 flex items-center gap-2">
                <i data-lucide="building" class="w-3.5 h-3.5 text-slate-500"></i> Settlement Destination
              </span>
              <span class="text-slate-200 text-xs flex items-center gap-1.5" id="val-settlement-dest">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span> HDFC Bank •••• 9104
              </span>
            </div>
          </div>
        </section>

        <!-- Audit & Processing Timeline Section -->
        <section class="bg-slate-900/70 border border-slate-800/90 rounded-2xl p-5 sm:p-6 backdrop-blur-sm shadow-md">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-5">
            <div class="flex items-center gap-2.5">
              <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <i data-lucide="git-commit" class="w-4 h-4"></i>
              </div>
              <h2 class="text-base font-semibold text-white">Audit & Lifecycle Logs</h2>
            </div>
            <span class="text-xs text-slate-400" id="val-timeline-count">4 Events</span>
          </div>

          <div id="timeline-container" class="relative pl-6 space-y-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-800">
            <!-- Timeline items rendered dynamically by JS -->
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: Client Telemetry & Geolocation (5 cols) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- Client & Device Section -->
        <section class="bg-slate-900/70 border border-slate-800/90 rounded-2xl p-5 sm:p-6 backdrop-blur-sm shadow-md">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-5">
            <div class="flex items-center gap-2.5">
              <div class="p-2 rounded-lg bg-violet-500/10 text-violet-400 border border-violet-500/20">
                <i data-lucide="cpu" class="w-4 h-4"></i>
              </div>
              <h2 class="text-base font-semibold text-white">Client & Device Telemetry</h2>
            </div>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-violet-500/10 text-violet-300 border border-violet-500/20" id="val-tls-badge">Verified TLS</span>
          </div>

          <!-- IP Badge Card -->
          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-slate-800/80 text-indigo-400">
                <i data-lucide="globe" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="text-[11px] text-slate-400 uppercase font-mono">IPv4 Address</p>
                <p class="text-sm font-semibold font-mono text-slate-100" id="val-client-ip">--</p>
              </div>
            </div>
            <button id="btn-copy-ip" class="p-1.5 text-slate-400 hover:text-indigo-400 hover:bg-slate-800 rounded-md transition-colors" title="Copy IP">
              <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <!-- Device Specs Grid -->
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="p-3 rounded-xl bg-slate-950/40 border border-slate-800/70">
              <span class="text-[11px] text-slate-400 flex items-center gap-1.5 mb-1">
                <i data-lucide="smartphone" class="w-3.5 h-3.5 text-slate-500"></i> Device
              </span>
              <p class="text-xs font-semibold text-slate-200" id="val-device-brand-model">--</p>
              <p class="text-[10px] text-slate-400 uppercase font-mono mt-0.5" id="val-device-type">Type: --</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-950/40 border border-slate-800/70">
              <span class="text-[11px] text-slate-400 flex items-center gap-1.5 mb-1">
                <i data-lucide="layers" class="w-3.5 h-3.5 text-slate-500"></i> Operating System
              </span>
              <p class="text-xs font-semibold text-slate-200" id="val-device-os">--</p>
              <p class="text-[10px] text-emerald-400 font-mono mt-0.5">Compatible</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-950/40 border border-slate-800/70">
              <span class="text-[11px] text-slate-400 flex items-center gap-1.5 mb-1">
                <i data-lucide="compass" class="w-3.5 h-3.5 text-slate-500"></i> Browser
              </span>
              <p class="text-xs font-semibold text-slate-200" id="val-browser-name">--</p>
              <p class="text-[10px] text-slate-400 font-mono truncate" id="val-browser-version" title="--">--</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-950/40 border border-slate-800/70">
              <span class="text-[11px] text-slate-400 flex items-center gap-1.5 mb-1">
                <i data-lucide="wifi" class="w-3.5 h-3.5 text-slate-500"></i> Network / ISP
              </span>
              <p class="text-xs font-semibold text-slate-200 truncate" id="val-isp-name" title="--">--</p>
              <p class="text-[10px] text-slate-400 font-mono mt-0.5" id="val-network-type">Cellular / Broadband</p>
            </div>
          </div>

          <!-- Extra Security telemetry -->
          <div class="border-t border-slate-800/80 pt-3 flex items-center justify-between text-xs text-slate-400">
            <span class="flex items-center gap-1.5">
              <i data-lucide="shield" class="w-3.5 h-3.5 text-emerald-400"></i> Device Fingerprint
            </span>
            <span class="font-mono text-slate-300" id="val-fingerprint">--</span>
          </div>
        </section>

        <!-- Location & Geolocation Section -->
        <section class="bg-slate-900/70 border border-slate-800/90 rounded-2xl p-5 sm:p-6 backdrop-blur-sm shadow-md">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-4">
            <div class="flex items-center gap-2.5">
              <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <i data-lucide="map-pin" class="w-4 h-4"></i>
              </div>
              <h2 class="text-base font-semibold text-white">Geolocation & Origin</h2>
            </div>
            <span class="text-xs font-mono text-slate-400" id="val-location-timezone-header">--</span>
          </div>

          <!-- Visual Map Pin Widget -->
          <div class="relative w-full h-36 rounded-xl overflow-hidden border border-slate-800 bg-[#090e18] mb-4 flex items-center justify-center group">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[size:16px_16px]"></div>
            <div class="absolute w-28 h-28 bg-indigo-500/20 rounded-full blur-xl pointer-events-none"></div>
            <div class="absolute w-20 h-20 rounded-full border border-indigo-500/20 animate-ping"></div>
            <div class="absolute w-12 h-12 rounded-full border border-emerald-500/30"></div>

            <div class="relative z-10 flex flex-col items-center">
              <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-600 to-emerald-400 p-0.5 shadow-lg shadow-indigo-500/40 flex items-center justify-center text-white">
                <i data-lucide="map-pin" class="w-4 h-4 fill-white"></i>
              </div>
              <div class="mt-1.5 px-2 py-0.5 rounded-full bg-slate-900/90 border border-slate-700 text-[10px] font-mono text-emerald-300 font-medium" id="val-map-badge">
                Pune, India
              </div>
            </div>

            <!-- Coordinate float badge -->
            <div class="absolute bottom-2 left-2 text-[10px] font-mono text-slate-400 bg-slate-900/80 px-2 py-0.5 rounded border border-slate-800" id="val-map-coords">
              0.0000° N, 0.0000° E
            </div>
            
            <!-- Google Maps External Link button -->
            <a id="link-external-map" href="#" target="_blank" rel="noopener noreferrer" class="absolute bottom-2 right-2 text-[10px] font-medium text-indigo-400 hover:text-indigo-300 bg-slate-900/90 hover:bg-slate-800 px-2 py-0.5 rounded border border-slate-800 flex items-center gap-1 transition-colors">
              Open Map <i data-lucide="external-link" class="w-2.5 h-2.5"></i>
            </a>
          </div>

          <!-- Geolocation Detailed Data -->
          <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-xs">
            <div>
              <span class="text-slate-400 block text-[11px]">City & Zipcode</span>
              <p class="font-medium text-slate-200 mt-0.5" id="val-location-city-zip">--</p>
            </div>

            <div>
              <span class="text-slate-400 block text-[11px]">Region & State</span>
              <p class="font-medium text-slate-200 mt-0.5" id="val-location-region">--</p>
            </div>

            <div>
              <span class="text-slate-400 block text-[11px]">Country</span>
              <p class="font-medium text-slate-200 mt-0.5 flex items-center gap-1.5" id="val-location-country">
                🇮🇳 India
              </p>
            </div>

            <div>
              <span class="text-slate-400 block text-[11px]">Timezone</span>
              <p class="font-mono text-slate-200 mt-0.5" id="val-location-timezone">--</p>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>

  <!-- Footer with Compliance & Support -->
  <footer class="border-t border-slate-800/80 bg-[#090d16] py-6 mt-8 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-200">UPay Payment Technologies</span>
        <span>•</span>
        <span>PCI-DSS Level 1 Certified</span>
        <span>•</span>
        <span>256-bit SSL Encrypted</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <button onclick="toggleJsonModal(true)" class="hover:text-indigo-400 transition-colors">Audit Payload</button>
        <a href="#" class="hover:text-indigo-400 transition-colors">Support & Dispute</a>
        <a href="#" class="hover:text-indigo-400 transition-colors">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <!-- Raw JSON Payload Modal -->
  <div id="jsonModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
        <div class="flex items-center gap-2">
          <i data-lucide="terminal" class="w-4 h-4 text-indigo-400"></i>
          <h3 class="text-sm font-semibold text-white font-mono">transaction_telemetry_payload.json</h3>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="copyRawJson()" class="px-2.5 py-1 text-xs font-mono text-indigo-300 bg-indigo-950/60 hover:bg-indigo-900/80 border border-indigo-500/30 rounded-md transition-colors flex items-center gap-1">
            <i data-lucide="copy" class="w-3 h-3"></i> Copy
          </button>
          <button onclick="toggleJsonModal(false)" class="p-1 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
      <div class="p-4 overflow-y-auto font-mono text-xs text-indigo-200 bg-[#070b13] flex-1">
        <pre id="jsonPayloadDisplay" class="whitespace-pre overflow-x-auto leading-relaxed"></pre>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT: DATA SOURCE & AUTO-POPULATION LOGIC -->
  <script>
    /**
     * ========================================================
     * 1. MASTER JSON DATA (सिर्फ यहाँ डेटा अपडेट करें)
     * ========================================================
     * आप चाहें तो इसे API fetch() रिस्पॉन्स से सीधे रिप्लेस कर सकते हैं।
     */
    const telemetryData = {
      transaction: {
        amount: <%=amount%>,
        currency: "INR",
        status: "Payment Recieved",
        status_subtext: "Payment Successful",
        utr: "<%=utr%>",
        upay_transaction_id: "<%=upaytr%>",
        order_id: "<%=order%>",
        payment_date: "<%=payment_date%>",
        payment_date_precise: "<%=payment_date%>",
        payment_mode: "UPI",
        vpa_provider: "Paytm",
        merchant_id: "<%=merchant%>",
        pg_id: "Unavailable",
        latency: "184 ms",
        settlement_destination: "<%=upi%>"
      },
      customer: {
        name: "<%=customerName%>",
        email: "<%=customerEmail%>",
        phone: "<%=customerPhone%>"
      },
      client: {
        ip: "<%=ip%>",
        device: {
          type: "<%=deviceType%>",
          brand: "<%=deviceBrand%>",
          model: "<%=deviceModel%>"
        },
        os: {
          name: "<%=osName%>",
          version: "<%=osVersion%>"
        },
        browser:{
          name: "<%=browserName%>",
          version: "<%=browserVersion%>"
        },
        isp: "<%=isp%>",
        network_type: "Cellular"
      },
      location: {
        country: "<%=country%>",
        country_flag: "🇮🇳",
        region: "<%=region%>",
        city: "<%=city%>",
        zip: "<%=zip%>",
        latitude: "<%=lat%>",
        longitude: "<%=longt%>",
        timezone: "<%=timezone%>"
      },
      security: {
        risk_score: 99,
        risk_label: "99/100 (Safe)",
        tls_version: "TLS 1.3",
        fingerprint: "dfp_92b8a74e1d3e"
      },
      timeline: [
        {
          title: "Webhook Delivered Successfully",
          time: "13:41:23.010 IST",
          description: "Dispatched HTTP 200 payload to merchant webhook endpoint.",
          color: "emerald"
        },
        {
          title: "Gateway Confirmed (UTR Issued)",
          time: "13:41:22.091 IST",
          description: "NPCI / Bank clearing authorized debit. UTR: 429281749201.",
          color: "emerald"
        },
        {
          title: "UPI Intent Prompted",
          time: "13:41:15.302 IST",
          description: "Redirected client app to PhonePe UPI handle via deep link.",
          color: "indigo"
        },
        {
          title: "Session & Order Created",
          time: "13:40:58.411 IST",
          description: "Client checkout session initialized from IP 223.228.42.108.",
          color: "slate"
        }
      ]
    };

    /**
     * ========================================================
     * 2. AUTOMATIC POPULATION FUNCTION
     * ========================================================
     */
    function populateDetails(data) {
      if (!data) return;

      // Top Header & Status
      document.getElementById('nav-payment-status').textContent = data.transaction?.status || "Success";
      document.getElementById('summary-status').textContent = data.transaction?.status_subtext || "Payment Successful";
      document.getElementById('summary-date').textContent = data.transaction?.payment_date || "--";

      // Amount with cents split
      const amount = data.transaction?.amount ?? 0;
      const formattedAmount = Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const [intPart, decimalPart] = formattedAmount.split('.');
      document.getElementById('summary-amount').innerHTML = `₹${intPart}<span class="text-lg text-slate-400 font-normal">.${decimalPart}</span>`;
      document.getElementById('summary-currency').textContent = data.transaction?.currency || "INR";

      // Order Reference
      const orderId = data.transaction?.order_id || "--";
      document.getElementById('summary-order-id').textContent = orderId;
      document.getElementById('btn-copy-order-id').onclick = () => copyToClipboard(orderId, 'Order Reference copied!');

      // Quick Badges
      document.getElementById('quick-payment-mode').textContent = data.transaction?.payment_mode || "UPI";
      document.getElementById('quick-latency').textContent = data.transaction?.latency || "--";
      document.getElementById('quick-risk-score').textContent = data.security?.risk_label || `${data.security?.risk_score || 0}/100`;

      // Payment Info Column
      document.getElementById('pg-id').textContent = `PG_ID: ${data.transaction?.pg_id || 'UP-XXXX'}`;
      
      const utr = data.transaction?.utr || "--";
      document.getElementById('val-utr').textContent = utr;
      document.getElementById('btn-copy-utr').onclick = () => copyToClipboard(utr, 'Bank UTR copied!');

      const upayTxnId = data.transaction?.upay_transaction_id || "--";
      document.getElementById('val-upay-txn-id').textContent = upayTxnId;
      document.getElementById('btn-copy-upay-txn-id').onclick = () => copyToClipboard(upayTxnId, 'UPay Transaction ID copied!');

      // Customer Details
      document.getElementById('val-customer-name').textContent = data.customer?.name || "--";
      
      const email = data.customer?.email || "--";
      document.getElementById('val-customer-email').textContent = email;
      document.getElementById('btn-copy-email').onclick = () => copyToClipboard(email, 'Customer Email copied!');

      document.getElementById('val-customer-phone').textContent = data.customer?.phone || "--";
      document.getElementById('val-order-id').textContent = orderId;
      document.getElementById('val-payment-date').textContent = data.transaction?.payment_date_precise || data.transaction?.payment_date || "--";
      document.getElementById('val-settlement-dest').innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> ${data.transaction?.settlement_destination || '--'}`;

      // Client & Device Telemetry
      const ip = data.client?.ip || "--";
      document.getElementById('val-client-ip').textContent = ip;
      document.getElementById('btn-copy-ip').onclick = () => copyToClipboard(ip, 'Client IP copied!');

      document.getElementById('val-tls-badge').textContent = `Verified ${data.security?.tls_version || 'TLS'}`;
      
      const brand = data.client?.device?.brand || "";
      const model = data.client?.device?.model || "";
      document.getElementById('val-device-brand-model').textContent = `${brand} ${model}`.trim() || "Unknown Device";
      document.getElementById('val-device-type').textContent = `Type: ${data.client?.device?.type || 'Desktop'}`;

      const osName = data.client?.os?.name || "Unknown OS";
      const osVer = data.client?.os?.version ? ` ${data.client?.os?.version}` : "";
      document.getElementById('val-device-os').textContent = `${osName}${osVer}`;

      document.getElementById('val-browser-name').textContent = data.client?.browser?.name || "Browser";
      const browserVer = data.client?.browser?.version || "";
      const browserVerElem = document.getElementById('val-browser-version');
      browserVerElem.textContent = browserVer;
      browserVerElem.setAttribute('title', browserVer);

      const isp = data.client?.isp || "--";
      const ispElem = document.getElementById('val-isp-name');
      ispElem.textContent = isp;
      ispElem.setAttribute('title', isp);
      document.getElementById('val-network-type').textContent = data.client?.network_type || "Network / ISP";

      document.getElementById('val-fingerprint').textContent = data.security?.fingerprint || "--";

      // Geolocation
      const city = data.location?.city || "--";
      const zip = data.location?.zip ? `, ${data.location.zip}` : "";
      document.getElementById('val-location-city-zip').textContent = `${city}${zip}`;
      document.getElementById('val-location-region').textContent = data.location?.region || "--";
      document.getElementById('val-location-country').innerHTML = `<span class="text-sm">${data.location?.country_flag || '🌐'}</span> ${data.location?.country || '--'}`;
      document.getElementById('val-location-timezone').textContent = data.location?.timezone || "--";
      document.getElementById('val-location-timezone-header').textContent = (data.location?.timezone || "UTC").split(' ')[0];

      // Map Widget details
      const lat = data.location?.latitude || 0;
      const lon = data.location?.longitude || 0;
      document.getElementById('val-map-badge').textContent = `${city}, ${data.location?.country || ''}`;
      document.getElementById('val-map-coords').textContent = `${lat.toFixed(4)}° N, ${lon.toFixed(4)}° E`;
      document.getElementById('link-external-map').href = `https://maps.google.com/?q=${lat},${lon}`;

      // Render Dynamic Timeline Logs
      const timelineContainer = document.getElementById('timeline-container');
      const timelineList = data.timeline || [];
      document.getElementById('val-timeline-count').textContent = `${timelineList.length} Events`;

      timelineContainer.innerHTML = timelineList.map(item => {
        let colorClass = "bg-slate-600";
        let ringClass = "";
        if (item.color === 'emerald') {
          colorClass = "bg-emerald-500";
          ringClass = "ring-2 ring-emerald-500/30";
        } else if (item.color === 'indigo') {
          colorClass = "bg-indigo-500";
        }

        return `
          <div class="relative">
            <div class="absolute -left-6 top-1 w-4 h-4 rounded-full ${colorClass} border-4 border-slate-900 ${ringClass}"></div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <p class="text-xs font-semibold text-slate-100">${item.title}</p>
              <time class="text-[11px] font-mono text-slate-400">${item.time}</time>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">${item.description}</p>
          </div>
        `;
      }).join('');

      // Update Raw JSON view
      document.getElementById('jsonPayloadDisplay').textContent = JSON.stringify(data, null, 2);

      // Re-trigger icons if new icons added
      if (window.lucide) {
        lucide.createIcons();
      }
    }

    // Initialize Page & Icons
    window.addEventListener('DOMContentLoaded', () => {
      populateDetails(telemetryData);
      lucide.createIcons();
    });

    /**
     * ========================================================
     * 3. UTILITY FUNCTIONS (Clipboard, Modal, Toast)
     * ========================================================
     */
    let toastTimeout;
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toast-message');
      
      toastMessage.textContent = message || "Copied to clipboard";
      toast.classList.remove('translate-y-16', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-16', 'opacity-0');
      }, 2500);
    }

    function copyToClipboard(text, customToastMsg) {
      if (!text || text === '--') return;
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast(customToastMsg || `Copied "${text}"`);
      } catch (err) {
        showToast("Failed to copy");
      }
      document.body.removeChild(textArea);
    }

    function copyCurrentUrl() {
      copyToClipboard(window.location.href, "Receipt URL link copied!");
    }

    function copyRawJson() {
      const jsonStr = JSON.stringify(telemetryData, null, 2);
      copyToClipboard(jsonStr, "Telemetry JSON copied!");
    }

    function toggleJsonModal(open) {
      const modal = document.getElementById('jsonModal');
      if (open) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    document.getElementById('jsonModal').addEventListener('click', function(e) {
      if (e.target === this) {
        toggleJsonModal(false);
      }
    });
  </script>
</body>
</html>
