<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo', {
        pageTitle: 'Verify Merchant OTP | UPay Business Security',
        pageDesc: 'Verify your 6-digit security code to activate your UPay Business UPI gateway account.',
        canonicalUrl: 'https://u-pay-seven.vercel.app/user/verify',
        robotsMeta: 'noindex, nofollow'
    }) %>
    <script src="/js/money-loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.6.1/toastify.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top center, #ede9fe 0%, #f5f0ff 55%, #f8fafc 100%);
        }
        .otp-input:focus { transform: translateY(-2px); border-color: #5f259f; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">

    <div class="max-w-md w-full">
        <div class="text-center mb-7">
            <div class="w-14 h-14 rounded-2xl bg-[#5f259f] text-white font-black text-2xl flex items-center justify-center mx-auto mb-3 shadow-lg shadow-purple-200">
                &#8377;
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Verify Your Identity</h1>
            <p class="text-slate-500 text-xs font-medium mt-1">Enter the 6-digit activation OTP sent to your registered email.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-8 border border-purple-100">
            <div class="grid grid-cols-6 gap-2 sm:gap-3 mb-7" id="otp-container">
                <% for(let i=0; i<6; i++) { %>
                <input type="text" maxlength="1" inputmode="numeric" class="otp-input w-full aspect-square text-center text-2xl font-extrabold border-2 border-slate-200 rounded-xl outline-none transition-all">
                <% } %>
            </div>

            <button onclick="verifyOTP()" id="verify-btn" class="w-full bg-gradient-to-r from-[#5f259f] to-[#7c3aed] text-white font-extrabold py-3.5 rounded-xl hover:opacity-95 transition shadow-lg shadow-purple-200 cursor-pointer text-sm">
                Verify & Activate Merchant Account
            </button>

            <div class="text-center mt-6">
                <p class="text-slate-500 text-xs font-semibold">
                    Didn't receive the OTP?
                    <button id="resend-btn" onclick="resendOTP()" class="text-[#5f259f] font-extrabold hover:underline disabled:text-slate-400 cursor-pointer ml-1">
                        Resend OTP
                    </button>
                    <span id="timer-text" class="text-slate-400 ml-1 hidden">(<span id="timer">60</span>s)</span>
                </p>
            </div>
        </div>
    </div>

    <script>
        const inputs = document.querySelectorAll('.otp-input');
        let timerInterval;
        const resendBtn = document.getElementById('resend-btn');
        const timerText = document.getElementById('timer-text');
        const timerDisplay = document.getElementById('timer');

        function startTimer(seconds = 60) {
            resendBtn.disabled = true;
            timerText.classList.remove('hidden');
            let timeLeft = seconds;
            timerDisplay.innerText = timeLeft;

            timerInterval = setInterval(() => {
                timeLeft--;
                timerDisplay.innerText = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerText.classList.add('hidden');
                }
            }, 1000);
        }

        async function resendOTP() {
            if (resendBtn.disabled) return;
            try {
                const resp = await fetch('/user/resend-otp', { method: 'POST' });
                const res = await resp.json();
                if (res.status) {
                    tst(res.message);
                    startTimer(60);
                    return;
                }
                tst(res.message || "Failed to resend code", true);
            } catch (err) {
                tst("Failed to resend code", true);
            }
        }

        window.onload = () => startTimer(30);

        function tst(text, isError = false) {
            Toastify({
                text,
                style: { background: isError ? "#e11d48" : "linear-gradient(135deg, #5f259f, #7c3aed)", borderRadius: "12px", fontSize: "12px", fontWeight: "700" }
            }).showToast();
        }

        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value && index < inputs.length - 1) inputs[index + 1].focus();
            });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) inputs[index - 1].focus();
            });
            input.addEventListener('paste', (e) => {
                const data = e.clipboardData.getData('text').slice(0, 6);
                if (/^\d+$/.test(data)) {
                    data.split('').forEach((char, i) => { if (inputs[i]) inputs[i].value = char; });
                    inputs[Math.min(data.length, 5)].focus();
                }
                e.preventDefault();
            });
        });

        async function verifyOTP() {
            const otp = Array.from(inputs).map(i => i.value).join('');
            if (otp.length < 6) return tst("Enter full 6-digit code", true);

            const btn = document.getElementById('verify-btn');
            btn.disabled = true;
            try {
                const response = await fetch('/user/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp })
                });
                const result = await response.json();
                if (result.status) {
                    tst("Verification Successful!");
                    location.href = "/user/dashboard";
                } else {
                    tst(result.message || "Invalid OTP", true);
                }
            } catch (err) {
                tst("Connection error", true);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
