<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo', {
        pageTitle: 'Reset Merchant Password | UPay Business',
        pageDesc: 'Recover access to your UPay Business merchant account with a secure email recovery link.',
        canonicalUrl: 'https://u-pay-seven.vercel.app/user/forgot-password'
    }) %>
    <script src="/js/money-loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top center, #ede9fe 0%, #f5f0ff 55%, #f8fafc 100%);
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-6 text-slate-900">

    <div class="bg-white w-full max-w-md p-8 rounded-3xl shadow-xl border border-purple-100">
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-[#5f259f] text-white font-black text-xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-purple-200">
                &#8377;
            </div>
            <h1 class="text-xl font-extrabold text-slate-900">Reset Your Password</h1>
            <p class="text-slate-500 mt-1 text-xs">Enter your registered merchant email to receive an instant recovery link.</p>
        </div>

        <form id="resetForm" class="space-y-5">
            <div>
                <label for="email" class="block text-xs font-extrabold text-slate-500 mb-1.5 uppercase tracking-wider">Merchant Email Address</label>
                <input type="email" name="email" id="email" required placeholder="merchant@company.com"
                    class="w-full bg-slate-50 border border-slate-200 focus:border-[#5f259f] rounded-xl py-3 px-4 text-sm font-semibold outline-none transition-all">
            </div>

            <div class="flex justify-center">
                <div class="g-recaptcha" data-sitekey="6Lcaq4csAAAAAJwVD8N3_NP8ToFWYBnrU7baLOnc"></div>
            </div>

            <div id="message" class="hidden text-xs font-bold p-3 rounded-xl text-center"></div>

            <button type="submit" id="submitBtn" class="w-full bg-gradient-to-r from-[#5f259f] to-[#7c3aed] text-white font-extrabold py-3.5 rounded-xl transition shadow-lg shadow-purple-200 text-sm cursor-pointer">
                <span id="btnText">Send Recovery Link</span>
            </button>
        </form>

        <div class="mt-6 text-center border-t border-slate-100 pt-5">
            <a href="/user/login" class="text-xs font-extrabold text-[#5f259f] hover:underline">
                &larr; Back to Merchant Sign In
            </a>
        </div>
    </div>

    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        const resetForm = document.getElementById('resetForm');
        const messageDiv = document.getElementById('message');

        resetForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const captchaResponse = typeof grecaptcha !== 'undefined' ? grecaptcha.getResponse() : '';
            if (!captchaResponse) {
                showMessage("Please complete the CAPTCHA", "error");
                return;
            }
            const formData = new FormData(resetForm);
            const data = {
                email: formData.get('email'),
                'g-recaptcha-response': captchaResponse
            };
            try {
                const response = await fetch('/user/forgot-password/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (response.ok && result.status) {
                    showMessage(result.message || "Recovery link sent! Check your email.", "success");
                    resetForm.reset();
                    if (typeof grecaptcha !== 'undefined') grecaptcha.reset();
                } else {
                    showMessage(result.message || "Something went wrong.", "error");
                    if (typeof grecaptcha !== 'undefined') grecaptcha.reset();
                }
            } catch (error) {
                showMessage("Network error. Please try again.", "error");
            }
        });

        function showMessage(text, type) {
            messageDiv.textContent = text;
            messageDiv.className = type === 'error'
                ? 'text-xs font-bold p-3 rounded-xl text-center bg-rose-50 text-rose-600 border border-rose-100'
                : 'text-xs font-bold p-3 rounded-xl text-center bg-emerald-50 text-emerald-700 border border-emerald-100';
        }
    </script>
</body>
</html>
