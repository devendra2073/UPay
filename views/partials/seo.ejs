<%
  const seoTitle = typeof pageTitle !== 'undefined' ? pageTitle : 'UPay — PhonePe-Grade Direct UPI Payment Gateway & Instant Merchant Checkout';
  const seoDesc = typeof pageDesc !== 'undefined' ? pageDesc : 'Accept 0% fee instant UPI payments directly into your bank account with PhonePe-inspired checkout themes, dynamic QR codes, signed HMAC webhooks, and real-time analytics.';
  const seoKeywords = typeof pageKeywords !== 'undefined' ? pageKeywords : 'UPay, UPI payment gateway, PhonePe checkout UI, zero fee payment gateway India, dynamic UPI QR code API, Paytm business webhook, instant settlement gateway, merchant dashboard';
  const seoUrl = typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://u-pay-seven.vercel.app/';
  const seoImage = typeof ogImage !== 'undefined' ? ogImage : 'https://u-pay-seven.vercel.app/upay.png';
  const seoRobots = typeof robotsMeta !== 'undefined' ? robotsMeta : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
%>
<!-- Primary Google SEO Meta Tags -->
<title><%= seoTitle %></title>
<meta name="title" content="<%= seoTitle %>">
<meta name="description" content="<%= seoDesc %>">
<meta name="keywords" content="<%= seoKeywords %>">
<meta name="author" content="UPay Fintech Technologies">
<meta name="robots" content="<%= seoRobots %>">
<meta name="googlebot" content="<%= seoRobots %>">
<meta name="theme-color" content="#5f259f">
<meta name="application-name" content="UPay">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="UPay">
<meta name="format-detection" content="telephone=no">
<link rel="canonical" href="<%= seoUrl %>">

<!-- Favicons & PWA Manifest -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Meta / Open Graph (Facebook, WhatsApp, Instagram, LinkedIn) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="UPay Payment Gateway">
<meta property="og:url" content="<%= seoUrl %>">
<meta property="og:title" content="<%= seoTitle %>">
<meta property="og:description" content="<%= seoDesc %>">
<meta property="og:image" content="<%= seoImage %>">
<meta property="og:image:alt" content="UPay Instant UPI Payment Gateway">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_IN">

<!-- Twitter / X Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content="<%= seoUrl %>">
<meta name="twitter:title" content="<%= seoTitle %>">
<meta name="twitter:description" content="<%= seoDesc %>">
<meta name="twitter:image" content="<%= seoImage %>">

<!-- Google Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FinancialService",
      "@id": "https://u-pay-seven.vercel.app/#organization",
      "name": "UPay",
      "url": "https://u-pay-seven.vercel.app/",
      "logo": "https://u-pay-seven.vercel.app/upay.png",
      "image": "https://u-pay-seven.vercel.app/upay.png",
      "description": "<%= seoDesc %>",
      "priceRange": "₹0 - Zero Transaction Fee",
      "areaServed": {
        "@type": "Country",
        "name": "India"
      },
      "currenciesAccepted": "INR",
      "paymentAccepted": "UPI, PhonePe, Google Pay, Paytm, BHIM"
    },
    {
      "@type": "SoftwareApplication",
      "name": "UPayUPI Gateway & Checkout Terminal",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web, Android, iOS",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "1480"
      }
    }
  ]
}
</script>
