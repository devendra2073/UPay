<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo', {
        pageTitle: 'UPI & Paytm Merchant Rail Configurator | UPay Business',
        pageDesc: 'Configure your Paytm Business MID and UPI VPA for direct-to-account settlements.',
        canonicalUrl: 'https://u-pay-seven.vercel.app/user/dashboard/paytm',
        robotsMeta: 'noindex, nofollow'
    }) %>
    <script src="/js/money-loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.6.1/toastify.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top center, #ede9fe 0%, #f5f0ff 55%, #f8fafc 100%);
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4 text-slate-900">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-purple-100 overflow-hidden relative">
        <a href="/user/dashboard" class="absolute top-6 left-6 px-3 py-1.5 rounded-xl bg-purple-50 text-[#5f259f] text-xs font-extrabold hover:bg-purple-100 transition">
            &larr; Dashboard
        </a>

        <div class="h-2 bg-gradient-to-r from-[#5f259f] to-[#7c3aed]"></div>
        <div class="p-8 pt-14">
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-purple-50 text-[#5f259f] rounded-2xl flex items-center justify-center mx-auto mb-3 font-black text-xl border border-purple-100">
                    UPI
                </div>
                <h1 class="text-xl font-extrabold text-slate-900">UPI Gateway Configurator</h1>
                <p class="text-slate-500 text-xs mt-1">Link your Paytm Business MID & UPI VPA to generate scannable QR terminals.</p>
            </div>

            <div class="space-y-4 mb-6">
                <div>
                    <label class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Primary Merchant UPI ID</label>
                    <input type="text" id="upiId" value="<%=paytm ? paytm.UPI : ''%>" placeholder="merchant@paytm"
                        class="w-full mt-1 bg-slate-50 border border-slate-200 focus:border-[#5f259f] rounded-xl py-3 px-4 outline-none mono text-sm font-semibold">
                </div>
                <div>
                    <label class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Merchant ID (MID)</label>
                    <input type="text" id="mid" value="<%=paytm ? paytm.MID : ''%>" placeholder="M-ID-XXXX-XXXX"
                        class="w-full mt-1 bg-slate-50 border border-slate-200 focus:border-[#5f259f] rounded-xl py-3 px-4 outline-none mono text-sm font-semibold">
                </div>
            </div>

            <button onclick="generateConfig()" id="verify-btn"
                class="w-full bg-gradient-to-r from-[#5f259f] to-[#7c3aed] text-white font-extrabold py-3.5 rounded-xl transition shadow-lg shadow-purple-200 text-xs uppercase tracking-wider cursor-pointer">
                Save & Generate Test Terminal QR
            </button>
        </div>
    </div>

    <div id="qrOverlay" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm hidden items-center justify-center p-6 z-50">
        <div class="bg-white rounded-3xl p-7 max-w-xs w-full text-center shadow-2xl border border-purple-100">
            <h3 class="text-slate-900 font-extrabold text-base mb-3">Terminal QR Verified</h3>
            <div class="bg-white p-3 rounded-2xl inline-block mb-3 border border-purple-100 shadow-inner">
                <img id="qr-code" src="" alt="QR Code" class="w-44 h-44 object-contain">
            </div>
            <p id="qrInfo" class="text-slate-600 text-xs mb-5 mono bg-purple-50 p-2 rounded-xl truncate"></p>
            <button onclick="closePopup()" class="w-full py-3 bg-[#5f259f] text-white rounded-xl font-extrabold text-xs uppercase cursor-pointer">
                Done
            </button>
        </div>
    </div>

    <script>
        function tst(text, isError = false) {
            Toastify({
                text,
                duration: 3000,
                gravity: "top",
                position: "center",
                style: {
                    background: isError ? "#e11d48" : "linear-gradient(135deg, #5f259f, #7c3aed)",
                    borderRadius: "12px",
                    fontSize: "12px",
                    fontWeight: "700"
                }
            }).showToast();
        }

        async function generateConfig() {
            const upi = document.getElementById('upiId').value;
            const mid = document.getElementById('mid').value;
            if (!upi || !mid) return tst("Please enter both UPI ID and MID", true);

            try {
                const response = await fetch("/user/dashboard/paytm", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ MID: mid, UPI: upi })
                });
                const data = await response.json();
                if (data.status) {
                    document.getElementById('qr-code').src = data.qrDataUrl || '';
                    document.getElementById('qrInfo').innerText = `UPI: ${upi}`;
                    document.getElementById('qrOverlay').classList.remove('hidden');
                    document.getElementById('qrOverlay').classList.add('flex');
                    tst(data.message);
                } else {
                    tst(data.message || "Configuration failed", true);
                }
            } catch (err) {
                tst("Network error", true);
            }
        }

        function closePopup() {
            document.getElementById('qrOverlay').classList.add('hidden');
            document.getElementById('qrOverlay').classList.remove('flex');
        }
    </script>
</body>
</html>
