<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>UPay Terminal | Minimal Enterprise Dashboard</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="/js/trig.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.6.1/toastify.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <!-- SocialBar_1 Integration -->
    <script src="https://pl31913225.profitableratecpmnetwork.com/a1/b6/f2/a1b6f2dc9974083b428c95f4211f6d72.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
        
        :root {
            --primary: #4f46e5;
            --primary-focus: rgba(79, 70, 229, 0.08);
            --surface: #ffffff;
            --subtle: #f8fafc;
            --border: #f1f5f9;
            --border-hover: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        body { 
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            background-color: #fafbfc;
            color: var(--text-dark);
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
        }

        .mono { font-family: 'JetBrains Mono', monospace; }

        /* Minimal Card Styling */
        .m-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1.25rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .m-card:hover {
            border-color: var(--border-hover);
        }

        /* Clean Inputs */
        .m-input {
            width: 100%;
            padding: 0.875rem 1.125rem;
            border-radius: 0.875rem;
            border: 1px solid var(--border-hover);
            background: #ffffff;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-dark);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .m-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-focus);
            outline: none;
        }

        /* Tabs & Animations */
        .tab-pane { display: none; opacity: 0; transform: translateY(6px); }
        .tab-pane.active { 
            display: block; 
            opacity: 1; 
            transform: translateY(0); 
            transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
        }

        .refresh-spin { animation: spin 0.75s cubic-bezier(0.4, 0, 0.2, 1); }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        .btn-press { transition: transform 0.15s ease, opacity 0.15s ease; }
        .btn-press:active { transform: scale(0.97); }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="overflow-hidden select-none">

    <div class="flex h-screen w-full">

        <!-- Minimal Desktop Sidebar -->
        <aside class="hidden lg:flex w-72 flex-col bg-white border-r border-slate-100 p-6">
            <!-- Brand -->
            <div class="flex items-center gap-3 px-3 mb-10">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-sm shadow-indigo-100">
                    <!-- Vector Lightning Logo -->
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-lg font-black tracking-tight text-slate-900">UPay</span>
                    <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-600 mono">PRO</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 space-y-1">
                <button onclick="Terminal.nav('overview')" data-nav="overview" class="nav-link active w-full flex items-center gap-3.5 px-4 py-3 rounded-xl bg-slate-50 text-indigo-600 font-semibold text-sm transition-all btn-press">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect></svg>
                    <span>Overview</span>
                </button>
                <button onclick="Terminal.nav('history')" data-nav="history" class="nav-link w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-50/80 font-semibold text-sm transition-all btn-press">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Ledger</span>
                </button>
                <button onclick="Terminal.nav('developer')" data-nav="developer" class="nav-link w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-50/80 font-semibold text-sm transition-all btn-press">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    <span>Integrations</span>
                </button>
                <button onclick="Terminal.nav('profile')" data-nav="profile" class="nav-link w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-50/80 font-semibold text-sm transition-all btn-press">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
                    <span>Settings</span>
                </button>
            </nav>

            <!-- Vector Art Card (Tier Box) -->
            <div class="mt-auto m-card p-4 bg-slate-50/70 border-slate-100 relative overflow-hidden">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-indigo-100/70 text-indigo-600 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs font-bold text-slate-800">Priority Tier</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        </div>
                        <p class="text-[11px] text-slate-400">99.98% Gateway SLA</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Body Area -->
        <main id="view-scroller" class="flex-1 overflow-y-auto no-scrollbar relative bg-[#fafbfc] pb-32 lg:pb-12">
            
            <!-- Sticky Header -->
            <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md px-6 lg:px-12 py-4 flex items-center justify-between border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="lg:hidden w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <div>
                        <h2 id="view-title" class="text-base font-bold text-slate-900 tracking-tight">Overview</h2>
                        <div class="flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-[11px] text-slate-400 font-medium">Node HK-442 • Connected</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5">
                    <button onclick="Terminal.simulateSync(this)" class="p-2 rounded-xl bg-white border border-slate-200/80 text-slate-500 hover:text-slate-800 hover:border-slate-300 transition-all btn-press shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>
                    
                    <div class="relative group cursor-pointer">
                        <img src="<%=(user.pic)?user.pic:`https://ui-avatars.com/api/?name=${user.firstname}+${user.lastname}&background=4f46e5&color=fff&bold=true`%>" class="w-9 h-9 rounded-xl border border-slate-200 object-cover" id="prfl">
                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></div>
                        <div id="menuc"></div>
                    </div>
                </div>
            </header>

            <div class="max-w-5xl mx-auto p-5 lg:p-10">

                <!-- 1. OVERVIEW VIEW -->
                <section id="view-overview" class="tab-pane active space-y-6">
                    
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
                        
                        <!-- Primary Balance Minimal Card -->
                        <div class="md:col-span-7 m-card p-7 bg-white relative overflow-hidden flex flex-col justify-between">
                            <!-- Background Vector Watermark -->
                            <svg class="absolute -right-8 -bottom-8 w-44 h-44 text-slate-50 pointer-events-none" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                            </svg>

                            <div class="relative z-10">
                                <div class="flex items-center justify-between text-slate-500">
                                    <span class="text-xs font-semibold uppercase tracking-wider">Settlement Balance</span>
                                    <button onclick="Terminal.refreshBalance(this)" class="p-1.5 hover:bg-slate-50 text-slate-400 hover:text-slate-700 rounded-lg transition-colors">
                                        <svg id="balance-refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                    </button>
                                </div>
                                <h3 id="stat-balance" class="text-4xl lg:text-5xl font-black mt-3 text-slate-900 tracking-tight tabular-nums">&#8377;<%=user.wallet%></h3>
                                
                                <div class="inline-flex items-center gap-1.5 mt-2 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                    <span>+12.5% vs last cycle</span>
                                </div>
                            </div>

                            <div class="flex items-center gap-3 mt-8 relative z-10">
                                <button onclick="Terminal.simulateSettlement()" class="flex-1 bg-slate-900 hover:bg-black text-white py-3 px-5 rounded-xl font-bold text-xs btn-press transition-colors shadow-2xs">
                                    Withdraw to Bank
                                </button>
                                <button onclick="openpop()" class="p-3 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200/80 rounded-xl btn-press transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Right Info Column -->
                        <div class="md:col-span-5 space-y-4">
                            <% if (user.bank.bank) { %>
                            <div class="m-card p-5 flex items-center justify-between">
                                <div class="space-y-1">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Settlement Route</p>
                                    <h4 class="text-sm font-bold text-slate-900"><%=user.bank.bank%></h4>
                                    <p class="mono text-xs text-slate-500">•••• <%=user.bank.account.slice(-4)%></p>
                                </div>
                                <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-1.5">
                                    <img src="<%=user.bank.logo%>" alt="<%=user.bank.bank%>" class="max-h-full max-w-full object-contain"/>
                                </div>
                            </div>
                            <% } %>

                            <div class="m-card p-5 flex items-center justify-between cursor-pointer hover:border-indigo-100" onclick="location.href='dashboard/paytm'">
                                <div class="space-y-1">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">UPI Rail Engine</p>
                                    <h4 class="text-sm font-bold text-slate-900"><%=user.provider || "Standard Provider"%></h4>
                                    <p class="mono text-xs text-slate-500"><%=user.paytm?.UPI ? user.paytm?.UPI : "UPI is not linked"%></p>
                                </div>
                                <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-2">
                                    <img src="/assets/<%=user.paytm?.UPI ? 'paytm' : 'not'%>.png" alt="Provider" class="max-h-full max-w-full object-contain"/>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="m-card p-4">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Success Rate</p>
                                    <p class="text-xl font-bold text-slate-900 mt-1">99.2%</p>
                                </div>
                                <div class="m-card p-4">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Throughput</p>
                                    <p class="text-xl font-bold text-slate-900 mt-1">120 tps</p>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Minimal Clean Chart -->
                    <div class="m-card p-6 lg:p-7">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h4 class="text-sm font-bold text-slate-900">Processing Volume</h4>
                                <p class="text-xs text-slate-400">Aggregated real-time settlement activity</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
                                <span class="text-xs font-semibold text-slate-600">Last 7 Days</span>
                            </div>
                        </div>
                        <div class="h-[240px] w-full">
                            <canvas id="mainChart"></canvas>
                        </div>
                    </div>

                    <!-- NativeBanner_1 Integration -->
                    <div class="m-card p-4 lg:p-5 overflow-hidden">
                        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Sponsored Insights</span>
                            <span class="text-[10px] font-semibold text-slate-400 mono">Ad</span>
                        </div>
                        <div class="w-full overflow-x-auto no-scrollbar">
                            <script async="async" data-cfasync="false" src="https://pl31913226.profitableratecpmnetwork.com/26343182bda53eead3e3e1300cb7c2a3/invoke.js"></script>
                            <div id="container-26343182bda53eead3e3e1300cb7c2a3"></div>
                        </div>
                    </div>
                </section>

                <!-- 2. LEDGER VIEW -->
                <section id="view-history" class="tab-pane">
                    <div class="m-card p-6 lg:p-8">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900 tracking-tight">Transaction Ledger</h3>
                                <p class="text-xs text-slate-400">Complete immutable record of all incoming UPI intents</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="relative">
                                    <input type="text" placeholder="Filter by UTR..." class="m-input !py-2 !pl-9 text-xs w-48 lg:w-60">
                                    <svg class="w-3.5 h-3.5 absolute left-3 top-3 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                </div>
                                <button onclick="Terminal.refreshHistory(this)" class="p-2.5 bg-slate-50 border border-slate-200 text-slate-700 hover:text-black rounded-xl btn-press">
                                    <svg id="history-refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                </button>
                            </div>
                        </div>

                        <div id="tx-container" class="divide-y divide-slate-100 min-h-[360px]">
                            <!-- Hydrated via Terminal.renderTransactions() -->
                        </div>

                        <div class="mt-8 pt-4 border-t border-slate-100 flex justify-center">
                            <button class="text-xs font-bold text-slate-500 hover:text-indigo-600 px-4 py-2 rounded-lg transition-colors">Load Historical Records</button>
                        </div>
                    </div>
                </section>

                <!-- 3. INTEGRATIONS / DEVELOPER VIEW -->
                <section id="view-developer" class="tab-pane max-w-2xl mx-auto space-y-5">
                    
                    <!-- API Keys Card -->
                    <div class="m-card p-6 lg:p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">API Credentials</h3>
                                <p class="text-xs text-slate-400">Used for authenticating server-side requests</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Secret Key</label>
                                <div class="mt-1 flex items-center justify-between bg-slate-50 border border-slate-200/80 p-3 rounded-xl mono text-xs text-slate-700">
                                    <span class="truncate mr-2"><%=user.api%></span>
                                    <button onclick="Terminal.copy('<%=user.api%>')" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 shrink-0">Copy</button>
                                </div>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Merchant Identifier (MID)</label>
                                <div class="mt-1 flex items-center justify-between bg-slate-50 border border-slate-200/80 p-3 rounded-xl mono text-xs text-slate-700">
                                    <span><%=user.MID%></span>
                                    <button onclick="Terminal.copy('<%=user.MID%>')" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 shrink-0">Copy</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Webhook Settings Card -->
                    <div class="m-card p-6 lg:p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">Webhook Handlers</h3>
                                <p class="text-xs text-slate-400">Receive instant transaction status events</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Success Callback URL</label>
                                <input type="text" id="callback" value="<%=user.callback%>" placeholder="https://api.yourdomain.com/v1/success" class="m-input mt-1">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">User Redirect URL</label>
                                <input type="text" id="redirect" value="<%=user.redirect%>" placeholder="https://yourdomain.com/thanks" class="m-input mt-1">
                            </div>
                            <div class="p-3 bg-amber-50/60 border border-amber-100 rounded-xl flex items-start gap-2.5 text-[11px] text-amber-800">
                                <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                <span>Endpoints must support HTTPS and return an immediate <code class="mono font-semibold">200 OK</code> acknowledgement within 3 seconds.</span>
                            </div>
                            <button onclick="Terminal.saveSettings(this)" class="w-full py-3 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl btn-press transition-colors shadow-2xs mt-2">
                                Deploy Endpoints
                            </button>
                        </div>
                    </div>
                </section>

                <!-- 4. SETTINGS / PROFILE VIEW -->
                <section id="view-profile" class="tab-pane max-w-2xl mx-auto">
                    <!-- Segmented Toggle -->
                    <div class="flex bg-slate-100/70 p-1 rounded-xl w-fit mb-6 border border-slate-200/40">
                        <button onclick="Terminal.subProfile('identity')" id="sub-nav-identity" class="sub-trigger px-5 py-2 rounded-lg font-bold text-xs bg-white shadow-2xs text-indigo-600 transition-all">Identity Profile</button>
                        <button onclick="Terminal.subProfile('banking')" id="sub-nav-banking" class="sub-trigger px-5 py-2 rounded-lg font-bold text-xs text-slate-500 hover:text-slate-800 transition-all">Banking Rails</button>
                    </div>

                    <!-- Sub-pane 1: Identity -->
                    <div id="sub-view-identity" class="sub-pane active m-card p-6 lg:p-8">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="relative">
                                <img src="<%=(user.pic)?user.pic:`https://ui-avatars.com/api/?name=${user.firstname}+${user.lastname}&background=4f46e5&color=fff&bold=true`%>" class="w-16 h-16 rounded-2xl object-cover border border-slate-200">
                                <div class="absolute -bottom-1 -right-1 bg-white p-1 rounded-lg border border-slate-200 shadow-2xs text-slate-500">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-slate-900"><%=user.firstname%> <%=user.lastname%></h3>
                                <p class="text-xs text-slate-400">Merchant Account Verification: Verified</p>
                            </div>
                        </div>

                        <form onsubmit="Terminal.saveProfile(event)" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">First Name</label>
                                    <input name="firstname" type="text" value="<%=user.firstname%>" class="m-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Last Name</label>
                                    <input name="lastname" type="text" value="<%=user.lastname%>" class="m-input mt-1">
                                </div>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Primary Email</label>
                                <input type="email" value="<%=user.email%>" class="m-input mt-1 bg-slate-50 text-slate-500" readonly>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Registered Business Entity</label>
                                <input type="text" name="company" value="<%=user.company || 'UPay PVT LTD'%>" class="m-input mt-1">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Direct Contact</label>
                                <input type="tel" value="+91 <%=user.mobile || '0000000000'%>" name="mobile" class="m-input mt-1">
                            </div>
                            <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-black text-white rounded-xl text-xs font-bold btn-press transition-colors shadow-2xs mt-4">
                                Update Legal Profile
                            </button>
                        </form>
                    </div>

                    <!-- Sub-pane 2: Banking -->
                    <div id="sub-view-banking" class="sub-pane m-card p-6 lg:p-8 hidden">
                        <div class="mb-6">
                            <h3 class="text-base font-bold text-slate-900">Settlement Account Configuration</h3>
                            <p class="text-xs text-slate-400 mt-0.5">Automated NEFT / IMPS daily settlement target</p>
                        </div>
                        
                        <form onsubmit="Terminal.saveBank(event)" class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Bank Name</label>
                                <select name="bank" class="m-input mt-1">
                                    <% list.forEach((val) => { %> 
                                        <option value="<%=val.name%>" <%=val.name == user.bank.bank ? 'selected' : ''%>><%=val.name%></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Account Holder Name</label>
                                <input type="text" name="holder" value="<%if (user.bank.bank){%><%=user.bank.holder%><% } %>" placeholder="UPay Enterprise LLC" class="m-input mt-1">
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Account Number</label>
                                    <input type="number" value="<%if (user.bank.bank){%><%=user.bank.account%><% } %>" name="account" placeholder="•••• •••• 9901" class="m-input mt-1 mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">IFSC Code</label>
                                    <input type="text" value="<%if (user.bank.bank){%><%=user.bank.ifsc%><% } %>" name="ifsc" placeholder="HDFC0001234" class="m-input mt-1 uppercase mono">
                                </div>
                            </div>
                            
                            <div class="p-4 bg-slate-50 border border-dashed border-slate-200 rounded-xl text-center">
                                <p class="text-[11px] text-slate-500">By saving, you authorize automatic daily batch settlements to the linked account.</p>
                            </div>
                            
                            <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold btn-press transition-colors shadow-2xs mt-2">
                                Save Settlement Rails
                            </button>
                        </form>
                    </div>
                </section>

            </div>
        </main>

        <!-- Minimal Mobile Navigation Bar -->
        <nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-md border-t border-slate-100 h-18 flex justify-around items-center px-4 z-50">
            <button onclick="Terminal.nav('overview')" data-mob="overview" class="mob-link text-indigo-600 flex flex-col items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect></svg>
                <span class="text-[10px] font-bold">Overview</span>
            </button>
            <button onclick="Terminal.nav('history')" data-mob="history" class="mob-link text-slate-400 flex flex-col items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span class="text-[10px] font-bold">Ledger</span>
            </button>
            <button onclick="Terminal.nav('developer')" data-mob="developer" class="mob-link text-slate-400 flex flex-col items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                <span class="text-[10px] font-bold">API</span>
            </button>
            <button onclick="Terminal.nav('profile')" data-mob="profile" class="mob-link text-slate-400 flex flex-col items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
                <span class="text-[10px] font-bold">Settings</span>
            </button>
        </nav>
    </div>

    <script src="/js/popup.js"></script>
    <script>
        /**
         * UPay Pro Minimalist Terminal Engine
         */
        const Terminal = {
            state: {
                balance: parseFloat(<%=user.wallet%> || 0),
                isRefreshing: false,
                chart: null,
                transactions: []
            },

            init() {
                this.renderTransactions();
                this.initChart();
                this.setupInterceptors();
            },

            nav(viewId) {
                document.getElementById('view-scroller').scrollTo({ top: 0, behavior: 'smooth' });
                
                document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
                const target = document.getElementById(`view-${viewId}`);
                if (target) target.classList.add('active');

                // Titles
                const titles = { overview: 'Overview', history: 'Ledger', developer: 'Integrations', profile: 'Settings' };
                document.getElementById('view-title').innerText = titles[viewId] || 'Dashboard';

                // Desktop Nav Active State
                document.querySelectorAll('.nav-link').forEach(el => {
                    el.classList.remove('bg-slate-50', 'text-indigo-600', 'active');
                    el.classList.add('text-slate-500');
                    const svg = el.querySelector('svg');
                    if(svg) svg.classList.replace('text-indigo-600', 'text-slate-400');
                });
                const activeNav = document.querySelector(`[data-nav="${viewId}"]`);
                if (activeNav) {
                    activeNav.classList.add('bg-slate-50', 'text-indigo-600', 'active');
                    activeNav.classList.remove('text-slate-500');
                    const svg = activeNav.querySelector('svg');
                    if(svg) svg.classList.replace('text-slate-400', 'text-indigo-600');
                }

                // Mobile Nav Active State
                document.querySelectorAll('.mob-link').forEach(el => {
                    el.classList.replace('text-indigo-600', 'text-slate-400');
                });
                const activeMob = document.querySelector(`[data-mob="${viewId}"]`);
                if (activeMob) activeMob.classList.replace('text-slate-400', 'text-indigo-600');

                if (viewId === 'overview') this.initChart();
            },

            subProfile(subId) {
                document.querySelectorAll('.sub-pane').forEach(el => el.classList.add('hidden'));
                const targetSub = document.getElementById(`sub-view-${subId}`);
                if (targetSub) targetSub.classList.remove('hidden');

                document.querySelectorAll('.sub-trigger').forEach(el => {
                    el.classList.remove('bg-white', 'shadow-2xs', 'text-indigo-600');
                    el.classList.add('text-slate-500');
                });
                const activeSubNav = document.getElementById(`sub-nav-${subId}`);
                if (activeSubNav) activeSubNav.classList.add('bg-white', 'shadow-2xs', 'text-indigo-600');
            },

            async refreshBalance(btn) {
                if (this.state.isRefreshing) return;
                this.state.isRefreshing = true;

                const icon = document.getElementById('balance-refresh-icon');
                if (icon) icon.classList.add('refresh-spin');

                try {
                    const res = await fetch("/user/dashboard/balance");
                    const data = await res.json();
                    this.state.balance = data.wallet || 0;
                    
                    gsap.to(this.state, {
                        balance: this.state.balance,
                        duration: 0.8,
                        ease: "power2.out",
                        onUpdate: () => {
                            document.getElementById('stat-balance').innerText = `₹${this.state.balance.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                        }
                    });

                    this.notify('Balance Synchronized');
                } catch(err) {
                    this.notify('Failed to sync balance', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                    this.state.isRefreshing = false;
                }
            },

            async refreshHistory(btn) {
                const icon = document.getElementById('history-refresh-icon');
                const container = document.getElementById('tx-container');
                
                if (icon) icon.classList.add('refresh-spin');
                if (container) container.style.opacity = '0.5';

                try {
                    const res = await fetch("/user/dashboard/transections");
                    this.state.transactions = await res.json();
                    this.renderTransactions();
                    this.notify('Ledger Refreshed');
                } catch(err) {
                    this.notify('Failed to update ledger', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                    if (container) container.style.opacity = '1';
                }
            },

            simulateSettlement() {
                this.notify('Settlement Request Dispatched');
            },

            async saveProfile(e) {
                e.preventDefault();
                const formdata = new FormData(e.target);
                const data = Object.fromEntries(formdata.entries());
                try {
                    const res = await fetch('/user/dashboard/profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    this.notify(result.message, result.status ? 'success' : 'warn');
                } catch(err) {
                    this.notify('Network error occurred', 'warn');
                }
            },

            async saveBank(e) {
                e.preventDefault();
                const formdata = new FormData(e.target);
                const data = Object.fromEntries(formdata.entries());
                try {
                    const res = await fetch('/user/dashboard/bank', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    this.notify(result.message, result.status ? 'success' : 'warn');
                } catch(err) {
                    this.notify('Network error occurred', 'warn');
                }
            },

            async saveSettings(btn) {
                btn.innerText = "Deploying...";
                btn.disabled = true;
                const callback = document.getElementById("callback").value;
                const redirect = document.getElementById("redirect").value;
                try {
                    const res = await fetch('/user/dashboard/callback', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ callback, redirect })
                    });
                    const result = await res.json();
                    this.notify(result.message, result.status ? 'success' : 'warn');
                } catch(err) {
                    this.notify('Failed to deploy endpoints', 'warn');
                } finally {
                    btn.disabled = false;
                    btn.innerText = "Deploy Endpoints";
                }
            },

            async renderTransactions() {
                try {
                    const resp = await fetch("/user/dashboard/transections");
                    this.state.transactions = await resp.json();
                } catch (e) {}

                const container = document.getElementById('tx-container');
                if (!container) return;

                if (!this.state.transactions || this.state.transactions.length === 0) {
                    container.innerHTML = `
                        <div class="py-12 text-center text-slate-400">
                            <svg class="w-8 h-8 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                            <p class="text-xs">No records available in this cycle</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = this.state.transactions.map(tx => `
                    <div href="/dashboard/transaction/${upaytr}" target="_blank" class="flex items-center justify-between py-3.5 hover:bg-slate-50/60 px-3 rounded-xl transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 ${tx.amount > 0 ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-600'}">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path d="${tx.amount > 0 ? 'M7 11l5-5m0 0l5 5m-5-5v12' : 'M17 13l-5 5m0 0l-5-5m5-5v12'}"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">${tx.mode || 'UPI Intent'}</p>  
                                <p class="mono text-[10px] text-slate-400">${tx.utr}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="mono text-xs font-bold ${tx.amount > 0 ? 'text-emerald-600' : 'text-slate-900'}">
                                ${tx.amount > 0 ? '+' : ''}${tx.amount.toLocaleString(undefined, {minimumFractionDigits: 2})}
                            </span>
                        </div>
                    </div>
                `).join('');
            },

            initChart() {
                const canvas = document.getElementById('mainChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                if (this.state.chart) this.state.chart.destroy();
                
                const gradient = ctx.createLinearGradient(0, 0, 0, 240);
                gradient.addColorStop(0, 'rgba(79, 70, 229, 0.08)');
                gradient.addColorStop(1, 'rgba(79, 70, 229, 0.00)');

                this.state.chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            data: [4200, 7800, 5600, 11200, 9800, 15400, 14250],
                            borderColor: '#4f46e5',
                            borderWidth: 2.5,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#4f46e5',
                            pointBorderWidth: 2,
                            pointRadius: 3,
                            pointHoverRadius: 5,
                            tension: 0.35,
                            fill: true,
                            backgroundColor: gradient
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { cornerRadius: 8, padding: 8 } },
                        scales: {
                            y: { display: false },
                            x: { 
                                grid: { display: false }, 
                                border: { display: false }, 
                                ticks: { font: { size: 11, family: 'Inter' }, color: '#94a3b8' } 
                            }
                        }
                    }
                });
            },

            notify(text, type = 'success') {
                Toastify({
                    text: text,
                    duration: 2500,
                    gravity: "top",
                    position: "center",
                    style: {
                        background: type === 'success' ? "#0f172a" : "#ea580c",
                        borderRadius: "8px",
                        fontSize: "12px",
                        fontWeight: "600",
                        boxShadow: "0 4px 6px -1px rgba(0,0,0,0.05)"
                    }
                }).showToast();
            },

            copy(text) {
                navigator.clipboard.writeText(text);
                this.notify('Copied to Clipboard');
            },

            simulateSync(btn) {
                this.notify('Syncing Cluster Nodes...');
                btn.classList.add('refresh-spin');
                setTimeout(() => btn.classList.remove('refresh-spin'), 750);
            },

            setupInterceptors() {
                document.body.addEventListener('touchmove', (e) => {
                    if (e.target.closest('#view-scroller')) return;
                    e.preventDefault();
                }, { passive: false });
            }
        };

        function openpop() {
            if (typeof UPayDeposit !== 'undefined') {
                const DepositPopup = new UPayDeposit();
                DepositPopup.open();
            }
        }

        window.onload = () => {
            Terminal.init();
            const myMenuItems = [
                { name: "Logout", link: "/user/logout", isLogout: true }
            ];
            if (typeof setupDynamicMenu === 'function') {
                setupDynamicMenu('prfl', 'menuc', myMenuItems);
            }
        };
    </script>
</body>
</html>
