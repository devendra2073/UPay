<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <%- include('partials/seo', {
        pageTitle: 'UPay 2.0 Business Admin | UPI Merchant Dashboard & Theme Studio',
        pageDesc: 'Manage instant UPI collections, customize checkout themes, create payment links, update merchant logo, resolve disputes with screenshots, and monitor webhooks on UPay 2.0.',
        canonicalUrl: 'https://u-pay-seven.vercel.app/user/dashboard',
        robotsMeta: 'noindex, nofollow'
    }) %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="/js/money-loader.js"></script>
    <script src="/js/trig.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.6.1/toastify.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

        :root {
            --pp-primary: #5f259f;
            --pp-primary-dark: #461878;
            --pp-accent: #7c3aed;
            --pp-bg: #f6f4fb;
            --pp-surface: #ffffff;
            --pp-border: #ece7f6;
            --pp-green: #00b970;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--pp-bg);
            color: #0f172a;
            -webkit-font-smoothing: antialiased;
        }

        .mono { font-family: 'JetBrains Mono', monospace; }

        .pp-card {
            background: var(--pp-surface);
            border: 1px solid var(--pp-border);
            border-radius: 1.35rem;
            box-shadow: 0 8px 26px -12px rgba(95, 37, 159, 0.08);
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .pp-card:hover {
            border-color: #d8c8f5;
            box-shadow: 0 12px 32px -12px rgba(95, 37, 159, 0.14);
        }

        .pp-hero-banner {
            background: linear-gradient(135deg, #431675 0%, #5f259f 52%, #7c3aed 100%);
            box-shadow: 0 20px 45px -15px rgba(95, 37, 159, 0.42);
        }

        .pp-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 0.875rem;
            border: 1.5px solid #e2dcf0;
            background: #ffffff;
            font-size: 0.85rem;
            font-weight: 600;
            color: #0f172a;
            transition: all 0.2s ease;
        }
        .pp-input:focus {
            border-color: var(--pp-primary);
            box-shadow: 0 0 0 4px rgba(95, 37, 159, 0.12);
            outline: none;
        }

        .pp-btn-primary {
            background: linear-gradient(135deg, #5f259f 0%, #7c3aed 100%);
            color: #ffffff;
            font-weight: 700;
            border-radius: 0.875rem;
            box-shadow: 0 8px 20px -6px rgba(95, 37, 159, 0.45);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .pp-btn-primary:hover {
            opacity: 0.96;
            transform: translateY(-1px);
        }
        .pp-btn-primary:active {
            transform: scale(0.98);
        }

        .tab-pane { display: none; opacity: 0; transform: translateY(6px); }
        .tab-pane.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
            transition: opacity 0.28s ease, transform 0.28s ease;
        }

        .nav-link.active {
            background: linear-gradient(135deg, #5f259f 0%, #7c3aed 100%);
            color: #ffffff !important;
            box-shadow: 0 8px 20px -6px rgba(95, 37, 159, 0.4);
        }
        .nav-link.active svg {
            color: #ffffff !important;
        }

        .refresh-spin { animation: spin 0.75s cubic-bezier(0.4, 0, 0.2, 1); }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="overflow-hidden select-none">

    <%
      const cfg = user.checkoutConfig || {};
      const customTheme = cfg.customTheme || { primary: '#5f259f', secondary: '#7c3aed', surface: '#ffffff', background: '#f5f0ff', text: '#0f172a', radius: '24px' };
      const sec = user.securityConfig || { maintenanceMode: false, ipWhitelist: '', minOrderAmount: 1, maxOrderAmount: 100000, autoSettleEnabled: false, autoSettleThreshold: 5000 };
      const curDefaultTheme = (cfg.defaultTheme === 'phonepe' || !cfg.defaultTheme) ? 'upay2' : cfg.defaultTheme;
    %>

    <div class="flex h-screen w-full">

        <!-- UPay 2.0 Desktop Sidebar -->
        <aside class="hidden lg:flex w-72 flex-col bg-white border-r border-purple-100 p-5 shrink-0">
            <!-- UPay 2.0 Brand Header -->
            <div class="flex items-center justify-between px-3 py-2 mb-6 rounded-2xl bg-purple-50/70 border border-purple-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-[#5f259f] flex items-center justify-center text-white font-black text-xl shadow-md shadow-purple-200 overflow-hidden">
                        <img id="sidebar-brand-logo" src="<%=(user.pic)?user.pic:`https://ui-avatars.com/api/?name=${encodeURIComponent(user.company || user.firstname)}&background=5f259f&color=fff&bold=true`%>" alt="Logo" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-base font-extrabold tracking-tight text-slate-900">UPay</span>
                            <span class="text-[9px] uppercase font-extrabold tracking-wider px-1.5 py-0.5 rounded-full bg-[#5f259f] text-white">2.0</span>
                        </div>
                        <p class="text-[11px] font-semibold text-purple-700 truncate max-w-[140px]"><%=user.company || 'Merchant Hub'%></p>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 space-y-1 overflow-y-auto no-scrollbar pr-1">
                <p class="px-3 text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1.5">Core Payments</p>
                <button onclick="Terminal.nav('overview')" data-nav="overview" class="nav-link active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect></svg>
                    <span>Home & Analytics</span>
                </button>
                <button onclick="Terminal.nav('history')" data-nav="history" class="nav-link w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <span class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Smart Ledger</span>
                    </span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-purple-100 text-[#5f259f] font-extrabold">Live</span>
                </button>
                <button onclick="Terminal.nav('links')" data-nav="links" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    <span>Payment Links & Details</span>
                </button>
                <button onclick="Terminal.nav('settlements')" data-nav="settlements" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <span>Settlements & Bank</span>
                </button>

                <p class="px-3 pt-4 text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1.5">Growth & Checkout</p>
                <button onclick="Terminal.nav('themes')" data-nav="themes" class="nav-link w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <span class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
                        <span>Theme Studio</span>
                    </span>
                    <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 font-extrabold">7+ Themes</span>
                </button>
                <button onclick="Terminal.nav('coupons')" data-nav="coupons" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                    <span>Offers & Coupons</span>
                </button>
                <button onclick="Terminal.nav('customers')" data-nav="customers" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <span>Customers & Ratings</span>
                </button>
                <button onclick="Terminal.nav('disputes')" data-nav="disputes" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    <span>Disputes & Screenshots</span>
                </button>

                <p class="px-3 pt-4 text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1.5">Developer & Brand</p>
                <button onclick="Terminal.nav('developer')" data-nav="developer" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    <span>API, Webhooks & Security</span>
                </button>
                <button onclick="Terminal.nav('profile')" data-nav="profile" class="nav-link w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-purple-50/70 font-bold text-xs transition-all cursor-pointer">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
                    <span>Logo, Profile & UPI Rails</span>
                </button>
            </nav>

            <!-- Quick Collect Action Button -->
            <div class="mt-4 pt-4 border-t border-purple-100">
                <button onclick="openpop()" class="w-full pp-btn-primary py-3 px-4 flex items-center justify-center gap-2 text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Instant Collect QR</span>
                </button>
            </div>
        </aside>

        <!-- Main Workspace Scroller -->
        <main id="view-scroller" class="flex-1 overflow-y-auto no-scrollbar relative pb-28 lg:pb-12">

            <!-- Sticky UPay 2.0 Top Bar -->
            <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md px-5 lg:px-10 py-3.5 flex items-center justify-between border-b border-purple-100">
                <div class="flex items-center gap-3">
                    <div class="lg:hidden w-9 h-9 rounded-xl bg-[#5f259f] text-white flex items-center justify-center font-black">
                        &#8377;
                    </div>
                    <div>
                        <h1 id="view-title" class="text-base font-extrabold text-slate-900 tracking-tight">Home & Analytics</h1>
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-[11px] text-slate-500 font-semibold">UPay 2.0 • MID: <span class="mono font-bold text-[#5f259f]"><%=user.MID%></span></span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5">
                    <button onclick="openpop()" class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-[#5f259f] font-extrabold text-xs transition cursor-pointer">
                        <span>+ Quick Collect</span>
                    </button>
                    <button onclick="Terminal.nav('profile')" class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-purple-200 text-slate-700 hover:border-[#5f259f] font-bold text-xs transition cursor-pointer">
                        <span>🖼️ Change Logo</span>
                    </button>
                    <button onclick="Terminal.refreshAll(this)" title="Sync Dashboard Data" class="p-2.5 rounded-xl bg-white border border-purple-100 text-slate-600 hover:text-[#5f259f] transition cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>

                    <div class="relative cursor-pointer">
                        <img src="<%=(user.pic)?user.pic:`https://ui-avatars.com/api/?name=${user.firstname}+${user.lastname}&background=5f259f&color=fff&bold=true`%>" alt="Merchant Avatar" class="w-9 h-9 rounded-xl border-2 border-purple-200 object-cover" id="prfl">
                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></div>
                        <div id="menuc"></div>
                    </div>
                </div>
            </header>

            <div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

                <!-- ========================================================= -->
                <!-- TAB 1: HOME & ANALYTICS OVERVIEW                          -->
                <!-- ========================================================= -->
                <section id="view-overview" class="tab-pane active space-y-6">

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                        <!-- UPay 2.0 Purple Hero Settlement Card -->
                        <div class="lg:col-span-7 pp-hero-banner rounded-3xl p-6 sm:p-8 text-white relative overflow-hidden flex flex-col justify-between">
                            <div class="absolute -right-10 -bottom-10 w-52 h-52 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
                            <div class="relative z-10">
                                <div class="flex items-center justify-between">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-[11px] font-extrabold uppercase tracking-wider">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                        UPay 2.0 Merchant Wallet
                                    </span>
                                    <button onclick="Terminal.refreshBalance(this)" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white transition cursor-pointer" title="Sync Wallet">
                                        <svg id="balance-refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                    </button>
                                </div>

                                <p class="text-purple-200 text-xs font-semibold uppercase tracking-widest mt-5">Available Settlement Balance</p>
                                <h2 id="stat-balance" class="text-4xl sm:text-5xl font-black mt-1 tracking-tight tabular-nums">&#8377;<%=Number(user.wallet || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})%></h2>

                                <div class="flex flex-wrap items-center gap-2 mt-3">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-400/20 text-emerald-200 text-xs font-bold">
                                        &#9650; 0% Commission Direct UPI
                                    </span>
                                    <span class="text-xs text-purple-200">• Active Theme: <strong id="badge-active-theme" class="uppercase text-white"><%=curDefaultTheme%></strong></span>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-3 mt-7 relative z-10">
                                <button onclick="Terminal.nav('settlements')" class="flex-1 bg-white text-[#5f259f] hover:bg-purple-50 py-3.5 px-5 rounded-2xl font-extrabold text-xs shadow-lg transition cursor-pointer">
                                    Instant Bank Payout &rarr;
                                </button>
                                <button onclick="openpop()" class="py-3.5 px-5 bg-white/15 hover:bg-white/25 text-white border border-white/25 rounded-2xl font-extrabold text-xs transition cursor-pointer flex items-center gap-1.5">
                                    <span>+ Collect Money</span>
                                </button>
                            </div>
                        </div>

                        <!-- Right Quick Rail & KPI Grid -->
                        <div class="lg:col-span-5 space-y-4">
                            <div class="pp-card p-5 flex items-center justify-between cursor-pointer" onclick="Terminal.nav('profile'); Terminal.subProfile('paytm')">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] font-extrabold text-[#5f259f] uppercase tracking-wider">Active UPay 2.0 UPI Rail</span>
                                        <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold <%=user.paytm?.UPI ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'%>">
                                            <%=user.paytm?.UPI ? 'VERIFIED' : 'SETUP NEEDED'%>
                                        </span>
                                    </div>
                                    <h4 class="text-sm font-extrabold text-slate-900" id="overview-upi-display"><%=user.paytm?.UPI || 'Click to link Merchant UPI'%></h4>
                                    <p class="mono text-xs text-slate-500">MID: <%=user.paytm?.MID || 'Not Configured'%></p>
                                </div>
                                <div class="w-11 h-11 rounded-2xl bg-purple-50 border border-purple-100 flex items-center justify-center text-[#5f259f] font-extrabold">
                                    UPI
                                </div>
                            </div>

                            <!-- 4 Mini KPI Cards -->
                            <div class="grid grid-cols-2 gap-3.5">
                                <div class="pp-card p-4">
                                    <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Conversion Rate</p>
                                    <p id="kpi-conversion" class="text-xl font-black text-emerald-600 mt-1">99.4%</p>
                                    <p class="text-[11px] text-slate-400 mt-0.5">Dynamic QR Checkout</p>
                                </div>
                                <div class="pp-card p-4">
                                    <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Avg Order Ticket</p>
                                    <p id="kpi-avg-ticket" class="text-xl font-black text-slate-900 mt-1">&#8377;840</p>
                                    <p class="text-[11px] text-slate-400 mt-0.5">Across UPI apps</p>
                                </div>
                                <div class="pp-card p-4 cursor-pointer" onclick="Terminal.nav('coupons')">
                                    <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Active Coupons</p>
                                    <p id="kpi-coupons-count" class="text-xl font-black text-[#5f259f] mt-1"><%=(user.coupons || []).length%></p>
                                    <p class="text-[11px] text-purple-600 font-semibold mt-0.5">Manage Offers &rarr;</p>
                                </div>
                                <div class="pp-card p-4 cursor-pointer" onclick="Terminal.nav('links')">
                                    <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Payment Links</p>
                                    <p id="kpi-links-count" class="text-xl font-black text-slate-900 mt-1"><%=(user.paymentLinks || []).length%></p>
                                    <p class="text-[11px] text-purple-600 font-semibold mt-0.5">Inspect Details &rarr;</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- UPay 2.0 Quick Actions Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                        <button onclick="openpop()" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-purple-100 text-[#5f259f] flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">&#8377;</div>
                            <p class="text-xs font-extrabold text-slate-900">Quick Collect</p>
                            <p class="text-[10px] text-slate-400">Redirects /pay/thanks</p>
                        </button>
                        <button onclick="Terminal.nav('profile')" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-pink-100 text-pink-700 flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">🖼️</div>
                            <p class="text-xs font-extrabold text-slate-900">Change Logo</p>
                            <p class="text-[10px] text-slate-400">Upload brand pic</p>
                        </button>
                        <button onclick="Terminal.nav('links')" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">🔗</div>
                            <p class="text-xs font-extrabold text-slate-900">Payment Links</p>
                            <p class="text-[10px] text-slate-400">View UTR & status</p>
                        </button>
                        <button onclick="Terminal.nav('themes')" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-fuchsia-100 text-fuchsia-700 flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">🎨</div>
                            <p class="text-xs font-extrabold text-slate-900">Theme Studio</p>
                            <p class="text-[10px] text-slate-400">7+ Themes & Custom</p>
                        </button>
                        <button onclick="Terminal.nav('disputes')" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">🛡️</div>
                            <p class="text-xs font-extrabold text-slate-900">Dispute Desk</p>
                            <p class="text-[10px] text-slate-400">Screenshots & UTRs</p>
                        </button>
                        <button onclick="Terminal.nav('developer')" class="pp-card p-4 text-left hover:bg-purple-50/40 cursor-pointer group">
                            <div class="w-9 h-9 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-black mb-2.5 group-hover:scale-105 transition">⚡</div>
                            <p class="text-xs font-extrabold text-slate-900">Webhook Test</p>
                            <p class="text-[10px] text-slate-400">HMAC simulator</p>
                        </button>
                    </div>

                    <!-- Interactive Volume Chart with Timeframe Switcher (7D / 30D / 90D via API) -->
                    <div class="pp-card p-6">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-900">UPay 2.0 Settlement Volume & Velocity</h3>
                                <p class="text-xs text-slate-400">Real-time UPI collection trend across all supported UPI apps</p>
                            </div>
                            <div class="flex items-center gap-1.5 bg-purple-50 p-1 rounded-xl border border-purple-100">
                                <button onclick="Terminal.loadAnalytics('7D', this)" class="range-btn px-3 py-1.5 rounded-lg text-xs font-extrabold bg-[#5f259f] text-white cursor-pointer">7D</button>
                                <button onclick="Terminal.loadAnalytics('30D', this)" class="range-btn px-3 py-1.5 rounded-lg text-xs font-extrabold text-slate-600 hover:text-[#5f259f] cursor-pointer">30D</button>
                                <button onclick="Terminal.loadAnalytics('90D', this)" class="range-btn px-3 py-1.5 rounded-lg text-xs font-extrabold text-slate-600 hover:text-[#5f259f] cursor-pointer">90D</button>
                            </div>
                        </div>
                        <div class="relative h-64 w-full">
                            <canvas id="mainChart"></canvas>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 2: SMART LEDGER + FILTERS + CSV EXPORT + SANDBOX SIM  -->
                <!-- ========================================================= -->
                <section id="view-history" class="tab-pane space-y-5">
                    <div class="pp-card p-6">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
                            <div>
                                <h3 class="text-lg font-extrabold text-slate-900">Smart Transaction Ledger</h3>
                                <p class="text-xs text-slate-500">Click any transaction to open the slide-over Telemetry & Geo-Audit Drawer</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <select id="ledger-status-filter" onchange="Terminal.refreshHistory()" class="pp-input !w-auto !py-2 text-xs">
                                    <option value="ALL_RECORDS">All Statuses</option>
                                    <option value="PAID">Paid Only</option>
                                    <option value="PENDING">Pending Only</option>
                                    <option value="DISPUTED">Disputed / Support</option>
                                </select>
                                <div class="relative">
                                    <input type="text" id="ledger-search" oninput="Terminal.filterLedgerLocal()" placeholder="Search UTR, Order, Name..." class="pp-input !py-2 !pl-8 text-xs w-48 sm:w-56">
                                    <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                </div>
                                <button onclick="Terminal.exportLedgerCSV()" class="px-3.5 py-2 rounded-xl bg-purple-50 text-[#5f259f] hover:bg-purple-100 font-extrabold text-xs transition cursor-pointer">
                                    Export CSV
                                </button>
                                <button onclick="Terminal.refreshHistory(this)" class="p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl cursor-pointer">
                                    <svg id="history-refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                </button>
                            </div>
                        </div>

                        <div id="tx-container" class="divide-y divide-purple-50 min-h-[340px]"></div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 3: PAYMENT PAGE THEME STUDIO (7 PRESETS + CUSTOM)     -->
                <!-- ========================================================= -->
                <section id="view-themes" class="tab-pane space-y-6">
                    <div class="pp-card p-6 sm:p-8">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-purple-100">
                            <div>
                                <span class="px-2.5 py-1 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase tracking-wider">UPay 2.0 Checkout Engine</span>
                                <h3 class="text-xl font-extrabold text-slate-900 mt-2">Payment Page Theme Studio</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Choose from 7 curated checkout themes or design your own custom brand theme. Changes apply immediately without page reload.</p>
                            </div>
                            <button onclick="Terminal.saveThemeStudio()" class="pp-btn-primary px-6 py-3 text-xs shrink-0">
                                Save Theme & Checkout Config
                            </button>
                        </div>

                        <!-- 7 Preset Themes Grid -->
                        <div class="mt-6">
                            <label class="text-xs font-extrabold uppercase tracking-wider text-slate-500 block mb-3">1. Select Default Payment Page Theme (7 Presets + Custom)</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5" id="admin-theme-grid">
                                <%
                                  const themePresets = [
                                    { id: 'upay2', name: 'UPay 2.0 Royal', colors: ['#5f259f', '#7c3aed', '#f5f0ff'], desc: 'Signature UPay 2.0 Purple' },
                                    { id: 'midnight', name: 'Midnight Dark', colors: ['#0f172a', '#6366f1', '#1e293b'], desc: 'Obsidian Neo-Bank Dark' },
                                    { id: 'emerald', name: 'Emerald Mint', colors: ['#059669', '#10b981', '#ecfdf5'], desc: 'Fresh Fintech Green' },
                                    { id: 'gold', name: 'Royal Gold', colors: ['#b45309', '#f59e0b', '#fffbeb'], desc: 'Warm Luxury Amber' },
                                    { id: 'ocean', name: 'Oceanic Cyan', colors: ['#0284c7', '#06b6d4', '#f0f9ff'], desc: 'Crisp Sky & Cyan' },
                                    { id: 'rose', name: 'Rose Sunset', colors: ['#e11d48', '#f43f5e', '#fff1f2'], desc: 'Vibrant Coral & Rose' },
                                    { id: 'monochrome', name: 'Minimal Slate', colors: ['#18181b', '#52525b', '#f4f4f5'], desc: 'High-Contrast Monochrome' },
                                    { id: 'custom', name: 'Custom Brand', colors: [customTheme.primary, customTheme.secondary, customTheme.background], desc: 'Your Custom Hex Palette' }
                                  ];
                                %>
                                <% themePresets.forEach(tp => { %>
                                <div onclick="Terminal.selectAdminTheme('<%=tp.id%>')" data-theme-card="<%=tp.id%>"
                                    class="theme-card-option p-4 rounded-2xl border-2 cursor-pointer transition-all <%=curDefaultTheme === tp.id ? 'border-[#5f259f] bg-purple-50/50 shadow-md' : 'border-slate-200 hover:border-purple-300 bg-white'%>">
                                    <div class="flex items-center gap-1.5 mb-2.5">
                                        <span class="w-5 h-5 rounded-full shadow-xs border border-black/10" style="background:<%=tp.colors[0]%>"></span>
                                        <span class="w-5 h-5 rounded-full shadow-xs border border-black/10" style="background:<%=tp.colors[1]%>"></span>
                                        <span class="w-5 h-5 rounded-full shadow-xs border border-black/10" style="background:<%=tp.colors[2]%>"></span>
                                    </div>
                                    <p class="text-xs font-extrabold text-slate-900"><%=tp.name%></p>
                                    <p class="text-[10px] text-slate-500 mt-0.5"><%=tp.desc%></p>
                                </div>
                                <% }) %>
                            </div>
                            <input type="hidden" id="cfg-default-theme" value="<%=curDefaultTheme%>">
                        </div>

                        <!-- Custom Theme Builder Controls -->
                        <div class="mt-8 p-5 rounded-2xl bg-purple-50/50 border border-purple-100 space-y-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h4 class="text-sm font-extrabold text-slate-900">2. Custom Brand Theme Palette Builder</h4>
                                    <p class="text-xs text-slate-500">Used when "Custom Brand" is active or when customers open the Customizer on the payment page</p>
                                </div>
                                <span class="text-[11px] font-mono font-bold text-[#5f259f]">Live CSS Variables</span>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Primary Brand</label>
                                    <input type="color" id="cust-primary" value="<%=customTheme.primary || '#5f259f'%>" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Accent Gradient</label>
                                    <input type="color" id="cust-secondary" value="<%=customTheme.secondary || '#7c3aed'%>" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Page Backdrop</label>
                                    <input type="color" id="cust-background" value="<%=customTheme.background || '#f5f0ff'%>" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Card Surface</label>
                                    <input type="color" id="cust-surface" value="<%=customTheme.surface || '#ffffff'%>" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Text Color</label>
                                    <input type="color" id="cust-text" value="<%=customTheme.text || '#0f172a'%>" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Card Radius</label>
                                    <select id="cust-radius" class="pp-input mt-1 !py-2">
                                        <option value="16px" <%=customTheme.radius === '16px' ? 'selected' : ''%>>Sharp (16px)</option>
                                        <option value="24px" <%=customTheme.radius === '24px' || !customTheme.radius ? 'selected' : ''%>>UPay 2.0 (24px)</option>
                                        <option value="32px" <%=customTheme.radius === '32px' ? 'selected' : ''%>>Ultra Pill (32px)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Customer Checkout Features & Fee Pass-Through Controls -->
                        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-4">
                                <h4 class="text-sm font-extrabold text-slate-900">3. Checkout Interactive Widgets</h4>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Merchant Checkout Tagline</label>
                                    <input type="text" id="cfg-tagline" value="<%=(cfg.tagline || 'UPay 2.0 • 100% Safe & Instant UPI Checkout').replace(/PhonePe/gi, 'UPay 2.0')%>" class="pp-input mt-1">
                                </div>
                                <div class="space-y-2.5 pt-2">
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                        <span class="text-xs font-bold text-slate-700">Allow Customers to Switch Themes (7+ Themes)</span>
                                        <input type="checkbox" id="cfg-allow-theme" <%=cfg.allowCustomerThemeChange !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                        <span class="text-xs font-bold text-slate-700">Allow Customer Custom Theme Builder</span>
                                        <input type="checkbox" id="cfg-allow-custom" <%=cfg.allowCustomTheme !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                        <span class="text-xs font-bold text-slate-700">Enable Promo Code / Discount Box on Checkout</span>
                                        <input type="checkbox" id="cfg-enable-coupons" <%=cfg.enableCoupons !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                        <span class="text-xs font-bold text-slate-700">Enable Customer Tip / Gratuity Selector</span>
                                        <input type="checkbox" id="cfg-enable-tips" <%=cfg.enableTips !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                        <span class="text-xs font-bold text-slate-700">Enable Split Bill Calculator on Checkout</span>
                                        <input type="checkbox" id="cfg-enable-split" <%=cfg.enableSplitBill !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                </div>
                            </div>

                            <div class="space-y-4">
                                <h4 class="text-sm font-extrabold text-slate-900">4. Fee Pass-Through & Customer Support</h4>
                                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                                    <label class="flex items-center justify-between cursor-pointer">
                                        <div>
                                            <p class="text-xs font-extrabold text-slate-800">Pass Convenience Fee to Customer</p>
                                            <p class="text-[11px] text-slate-500">Automatically adds a % processing surcharge to order total</p>
                                        </div>
                                        <input type="checkbox" id="cfg-pass-fee" <%=cfg.passFeeToCustomer ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                    </label>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 uppercase">Convenience Fee Percentage (%)</label>
                                        <input type="number" step="0.1" min="0" max="10" id="cfg-fee-percent" value="<%=cfg.convenienceFeePercent || 1.5%>" class="pp-input mt-1">
                                    </div>
                                </div>

                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Support Email (Shown on Payment Page)</label>
                                    <input type="email" id="cfg-support-email" value="<%=cfg.supportEmail || user.email%>" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Support WhatsApp Number</label>
                                    <input type="text" id="cfg-support-wa" value="<%=cfg.supportWhatsapp || user.mobile || '+919876543210'%>" class="pp-input mt-1">
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 4: PAYMENT LINKS & FULL LINK TELEMETRY DETAILS        -->
                <!-- ========================================================= -->
                <section id="view-links" class="tab-pane space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <div class="lg:col-span-4 pp-card p-6 space-y-4 h-fit">
                            <span class="px-2.5 py-1 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase">Manual Payment Link</span>
                            <h3 class="text-lg font-extrabold text-slate-900">Create Payment Link</h3>
                            <p class="text-xs text-slate-500">Manual payment links automatically redirect customers to <code class="mono font-bold text-[#5f259f]">/pay/thanks</code> after verification (API orders redirect to your configured webhook/redirect URL).</p>

                            <form onsubmit="Terminal.createPaymentLink(event)" class="space-y-3.5 pt-2">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Customer / Purpose Title</label>
                                    <input type="text" name="title" required placeholder="e.g. Premium Web Design Invoice #104" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Amount (&#8377; INR)</label>
                                    <input type="number" name="amount" required min="1" placeholder="1499" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Notes / Description</label>
                                    <input type="text" name="description" placeholder="Includes GST & instant activation" class="pp-input mt-1">
                                </div>
                                <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs">
                                    + Mint Payment Link (Redirects /pay/thanks)
                                </button>
                            </form>
                        </div>

                        <div class="lg:col-span-8 pp-card p-6">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h3 class="text-base font-extrabold text-slate-900">Payment Links & Complete Order Details</h3>
                                    <p class="text-xs text-slate-500">Displays live Payment Status, UTR, Payer details, Timestamps, and Redirect route for each link</p>
                                </div>
                                <button onclick="Terminal.loadPaymentLinks()" class="px-3.5 py-2 rounded-xl bg-purple-50 text-[#5f259f] font-extrabold text-xs cursor-pointer">
                                    Refresh Links
                                </button>
                            </div>
                            <div id="payment-links-list" class="space-y-3.5"></div>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 5: OFFERS & DISCOUNT COUPONS ENGINE                   -->
                <!-- ========================================================= -->
                <section id="view-coupons" class="tab-pane space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <div class="lg:col-span-5 pp-card p-6 space-y-4 h-fit">
                            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase">Checkout Conversion Booster</span>
                            <h3 class="text-lg font-extrabold text-slate-900">Create Promo Coupon</h3>
                            <p class="text-xs text-slate-500">Customers can apply these promo codes directly on the UPay 2.0 payment page to dynamically recalculate the QR amount.</p>

                            <form onsubmit="Terminal.createCoupon(event)" class="space-y-3.5 pt-2">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Promo Code</label>
                                    <input type="text" name="code" required placeholder="UPAY25" class="pp-input mt-1 uppercase mono">
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 uppercase">Discount Type</label>
                                        <select name="type" class="pp-input mt-1">
                                            <option value="PERCENT">Percentage (%)</option>
                                            <option value="FLAT">Flat Rupees (&#8377;)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 uppercase">Value</label>
                                        <input type="number" name="value" required min="1" placeholder="15" class="pp-input mt-1">
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 uppercase">Min Order (&#8377;)</label>
                                        <input type="number" name="minOrder" value="100" class="pp-input mt-1">
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 uppercase">Max Discount (&#8377;)</label>
                                        <input type="number" name="maxDiscount" value="250" class="pp-input mt-1">
                                    </div>
                                </div>
                                <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs">
                                    + Publish Promo Coupon
                                </button>
                            </form>
                        </div>

                        <div class="lg:col-span-7 pp-card p-6">
                            <h3 class="text-base font-extrabold text-slate-900 mb-4">Active & Paused Promo Codes</h3>
                            <div id="coupons-list" class="space-y-3"></div>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 6: SETTLEMENTS & INSTANT BANK PAYOUTS                 -->
                <!-- ========================================================= -->
                <section id="view-settlements" class="tab-pane space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <div class="lg:col-span-5 pp-card p-6 space-y-4 h-fit">
                            <span class="px-2.5 py-1 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase">Instant Liquidity</span>
                            <h3 class="text-lg font-extrabold text-slate-900">Withdraw to Settlement Bank</h3>
                            <p class="text-xs text-slate-500">Transfer collected wallet liquidity directly to your linked bank account via IMPS, NEFT, or RTGS.</p>

                            <div class="p-4 rounded-2xl bg-purple-50/70 border border-purple-100 flex items-center justify-between">
                                <div>
                                    <p class="text-[10px] font-bold text-slate-500 uppercase">Destination Bank</p>
                                    <p class="text-sm font-extrabold text-slate-900"><%=user.bank?.bank || 'No Bank Linked'%></p>
                                    <p class="text-xs mono text-slate-500"><%=user.bank?.account ? '•••• ' + user.bank.account.slice(-4) + ' (' + user.bank.ifsc + ')' : 'Configure in Logo, Profile & UPI Rails'%></p>
                                </div>
                                <button onclick="Terminal.nav('profile'); Terminal.subProfile('banking')" class="text-xs font-extrabold text-[#5f259f] hover:underline cursor-pointer">Edit</button>
                            </div>

                            <form onsubmit="Terminal.requestWithdrawal(event)" class="space-y-3.5">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Payout Amount (&#8377;)</label>
                                    <input type="number" id="withdraw-amount" required min="1" value="<%=user.wallet || 500%>" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Transfer Rail</label>
                                    <select id="withdraw-mode" class="pp-input mt-1">
                                        <option value="IMPS">IMPS (Instant 24x7 Settlement)</option>
                                        <option value="NEFT">NEFT (Zero Fee Batch)</option>
                                        <option value="RTGS">RTGS (High Value Priority)</option>
                                    </select>
                                </div>
                                <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs">
                                    Dispatch Instant Bank Payout
                                </button>
                            </form>
                        </div>

                        <div class="lg:col-span-7 pp-card p-6">
                            <h3 class="text-base font-extrabold text-slate-900 mb-4">Payout & Settlement History</h3>
                            <div id="withdrawals-list" class="space-y-3"></div>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 7: CUSTOMERS DIRECTORY & CHECKOUT RATINGS             -->
                <!-- ========================================================= -->
                <section id="view-customers" class="tab-pane space-y-6">
                    <div class="pp-card p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="text-lg font-extrabold text-slate-900">Customer Directory & Loyalty Insights</h3>
                                <p class="text-xs text-slate-500">Aggregated payer profiles, total volume, and checkout star ratings</p>
                            </div>
                            <button onclick="Terminal.loadCustomers()" class="px-4 py-2 rounded-xl bg-purple-50 text-[#5f259f] font-extrabold text-xs cursor-pointer">
                                Refresh CRM
                            </button>
                        </div>
                        <div id="customers-list" class="divide-y divide-purple-50"></div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 8: REFUNDS, SCREENSHOTS & DISPUTE RESOLUTION DESK     -->
                <!-- ========================================================= -->
                <section id="view-disputes" class="tab-pane space-y-6">
                    <div class="pp-card p-6">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                            <div>
                                <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 text-[10px] font-extrabold uppercase">Manual Admin Intervention Required</span>
                                <h3 class="text-lg font-extrabold text-slate-900 mt-1">Disputes, Customer Screenshots & UTR Verification Desk</h3>
                                <p class="text-xs text-slate-500">Customer disputes with uploaded screenshots and UTRs never resolve automatically — review the screenshot and UTR below to Approve, Refund, or Reject.</p>
                            </div>
                            <button onclick="Terminal.loadDisputes()" class="px-4 py-2 rounded-xl bg-purple-50 text-[#5f259f] font-extrabold text-xs cursor-pointer">
                                Sync Tickets
                            </button>
                        </div>
                        <div id="disputes-list" class="space-y-4"></div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 9: DEVELOPER API, WEBHOOK SIMULATOR & SECURITY        -->
                <!-- ========================================================= -->
                <section id="view-developer" class="tab-pane space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- API Credentials + 1-Click Key Rotation -->
                        <div class="lg:col-span-6 pp-card p-6 space-y-5">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h3 class="text-base font-extrabold text-slate-900">API Credentials & Key Rotation</h3>
                                    <p class="text-xs text-slate-500">Authenticate `/api/create-order` & verify HMAC signatures</p>
                                </div>
                                <a href="/documentation.html" target="_blank" class="text-xs font-extrabold text-[#5f259f] hover:underline">API Docs &nearr;</a>
                            </div>

                            <div class="space-y-3">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Secret API Key</label>
                                    <div class="mt-1 flex items-center justify-between bg-purple-50/60 border border-purple-100 p-3 rounded-xl mono text-xs text-slate-800">
                                        <span id="api-key-display" class="truncate mr-2"><%=user.api%></span>
                                        <div class="flex items-center gap-2 shrink-0">
                                            <button onclick="Terminal.copy(document.getElementById('api-key-display').innerText)" class="text-xs font-extrabold text-[#5f259f] cursor-pointer">Copy</button>
                                            <button onclick="Terminal.rotateKey()" class="text-xs font-extrabold text-rose-600 hover:underline cursor-pointer">Rotate Key</button>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Merchant Identifier (MID)</label>
                                    <div class="mt-1 flex items-center justify-between bg-purple-50/60 border border-purple-100 p-3 rounded-xl mono text-xs text-slate-800">
                                        <span><%=user.MID%></span>
                                        <button onclick="Terminal.copy('<%=user.MID%>')" class="text-xs font-extrabold text-[#5f259f] cursor-pointer">Copy</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Webhook Config & Live HMAC Simulator -->
                            <div class="pt-4 border-t border-purple-100 space-y-3">
                                <h4 class="text-sm font-extrabold text-slate-900">API Order Webhook & Redirect Endpoints</h4>
                                <p class="text-[11px] text-slate-500">Orders created via <code class="mono font-bold">/api/create-order</code> redirect users to the URL below. Manual Admin Payment Links always redirect to <code class="mono font-bold">/pay/thanks</code>.</p>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">HTTPS Webhook Callback URL</label>
                                    <input type="text" id="callback" value="<%=user.callback || ''%>" placeholder="https://api.yourdomain.com/webhook/upay" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">API Order Redirect URL</label>
                                    <input type="text" id="redirect" value="<%=user.redirect || '/pay/thanks'%>" placeholder="https://yourdomain.com/order-success" class="pp-input mt-1">
                                </div>
                                <div class="flex gap-2.5 pt-1">
                                    <button onclick="Terminal.saveSettings(this)" class="flex-1 pp-btn-primary py-3 text-xs">
                                        Save API Endpoints
                                    </button>
                                    <button onclick="Terminal.runWebhookSimulator()" class="px-4 py-3 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 font-extrabold text-xs hover:bg-emerald-100 transition cursor-pointer">
                                        Test HMAC Webhook
                                    </button>
                                </div>
                                <pre id="webhook-test-output" class="hidden p-3 rounded-xl bg-slate-950 text-emerald-400 mono text-[10px] overflow-x-auto"></pre>
                            </div>
                        </div>

                        <!-- Security, Maintenance Mode & Order Limits -->
                        <div class="lg:col-span-6 pp-card p-6 space-y-4">
                            <div>
                                <h3 class="text-base font-extrabold text-slate-900">Gateway Security & Risk Controls</h3>
                                <p class="text-xs text-slate-500">Configure order limits, IP whitelisting, and maintenance switches</p>
                            </div>

                            <label class="flex items-center justify-between p-3.5 rounded-2xl bg-rose-50/60 border border-rose-100 cursor-pointer">
                                <div>
                                    <p class="text-xs font-extrabold text-rose-900">Gateway Maintenance Mode</p>
                                    <p class="text-[11px] text-rose-600">Temporarily pause new order creation while performing maintenance</p>
                                </div>
                                <input type="checkbox" id="sec-maintenance" <%=sec.maintenanceMode ? 'checked' : ''%> class="accent-rose-600 w-4 h-4">
                            </label>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Min Order Amount (&#8377;)</label>
                                    <input type="number" id="sec-min-amt" value="<%=sec.minOrderAmount || 1%>" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Max Order Amount (&#8377;)</label>
                                    <input type="number" id="sec-max-amt" value="<%=sec.maxOrderAmount || 100000%>" class="pp-input mt-1">
                                </div>
                            </div>

                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Allowed Server IP Whitelist (Comma separated, optional)</label>
                                <input type="text" id="sec-ips" value="<%=sec.ipWhitelist || ''%>" placeholder="e.g. 103.21.244.0, 192.0.2.1 (Leave blank for all)" class="pp-input mt-1 mono">
                            </div>

                            <div class="p-3.5 rounded-2xl bg-purple-50/50 border border-purple-100 space-y-2.5">
                                <label class="flex items-center justify-between cursor-pointer">
                                    <span class="text-xs font-extrabold text-slate-800">Auto-Settlement Rule</span>
                                    <input type="checkbox" id="sec-autosettle" <%=sec.autoSettleEnabled ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                                </label>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Auto-Settle When Balance Exceeds (&#8377;)</label>
                                    <input type="number" id="sec-threshold" value="<%=sec.autoSettleThreshold || 5000%>" class="pp-input mt-1">
                                </div>
                            </div>

                            <button onclick="Terminal.saveSecurity()" class="w-full pp-btn-primary py-3.5 text-xs">
                                Update Security & Risk Policies
                            </button>
                        </div>
                    </div>
                </section>

                <!-- ========================================================= -->
                <!-- TAB 10: MERCHANT LOGO/PIC UPLOAD, PROFILE & UPI RAILS     -->
                <!-- ========================================================= -->
                <section id="view-profile" class="tab-pane max-w-3xl mx-auto">
                    <div class="flex flex-wrap bg-purple-100/70 p-1 rounded-2xl w-fit mb-6 border border-purple-200/50">
                        <button onclick="Terminal.subProfile('identity')" id="sub-nav-identity" class="sub-trigger px-4 py-2 rounded-xl font-extrabold text-xs bg-white shadow-xs text-[#5f259f] transition-all cursor-pointer">Logo & Merchant Identity</button>
                        <button onclick="Terminal.subProfile('banking')" id="sub-nav-banking" class="sub-trigger px-4 py-2 rounded-xl font-extrabold text-xs text-slate-600 hover:text-[#5f259f] transition-all cursor-pointer">Settlement Bank</button>
                        <button onclick="Terminal.subProfile('paytm')" id="sub-nav-paytm" class="sub-trigger px-4 py-2 rounded-xl font-extrabold text-xs text-slate-600 hover:text-[#5f259f] transition-all cursor-pointer">UPI & Paytm Rails</button>
                    </div>

                    <!-- Sub-pane 1: Logo Upload & Identity -->
                    <div id="sub-view-identity" class="sub-pane pp-card p-6 sm:p-8 space-y-6">
                        <!-- Merchant Logo / Profile Picture Uploader -->
                        <div class="p-5 rounded-2xl bg-purple-50/60 border border-purple-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="flex items-center gap-4">
                                <div class="relative group">
                                    <img id="profile-main-avatar" src="<%=(user.pic)?user.pic:`https://ui-avatars.com/api/?name=${user.firstname}+${user.lastname}&background=5f259f&color=fff&bold=true`%>" class="w-20 h-20 rounded-2xl object-cover border-2 border-purple-200 shadow-md bg-white">
                                    <label for="logo-file-input" class="absolute -bottom-1.5 -right-1.5 w-8 h-8 rounded-xl bg-[#5f259f] text-white flex items-center justify-center shadow cursor-pointer hover:scale-105 transition" title="Upload New Logo">
                                        📷
                                    </label>
                                </div>
                                <div>
                                    <span class="px-2 py-0.5 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase">Brand Identity</span>
                                    <h3 class="text-base font-extrabold text-slate-900 mt-1">Merchant Logo & Profile Picture</h3>
                                    <p class="text-xs text-slate-500">Displayed on your Admin Panel and all Customer Payment Pages</p>
                                </div>
                            </div>

                            <div class="flex flex-col gap-2 sm:w-64">
                                <input type="file" id="logo-file-input" accept="image/*" onchange="Terminal.handleLogoFileSelect(event)" class="text-xs file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-extrabold file:bg-[#5f259f] file:text-white cursor-pointer">
                                <div class="flex gap-1.5">
                                    <input type="url" id="logo-url-input" placeholder="Or paste Logo Image URL..." class="pp-input !py-1.5 !px-2.5 text-xs">
                                    <button type="button" onclick="Terminal.saveLogoFromUrl()" class="px-3 py-1.5 rounded-xl bg-slate-900 text-white text-xs font-extrabold cursor-pointer shrink-0">Save</button>
                                </div>
                            </div>
                        </div>

                        <form onsubmit="Terminal.saveProfile(event)" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">First Name</label>
                                    <input name="firstname" type="text" value="<%=user.firstname%>" class="pp-input mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Last Name</label>
                                    <input name="lastname" type="text" value="<%=user.lastname%>" class="pp-input mt-1">
                                </div>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Primary Email</label>
                                <input type="email" value="<%=user.email%>" class="pp-input mt-1 bg-slate-50 text-slate-500" readonly>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Business / Brand Name (Shown on Checkout)</label>
                                <input type="text" name="company" value="<%=user.company || 'UPay 2.0 Enterprise'%>" class="pp-input mt-1">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Merchant Mobile Number</label>
                                <input type="tel" value="<%=user.mobile || '9876543210'%>" name="mobile" class="pp-input mt-1">
                            </div>
                            <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs mt-2">
                                Save Merchant Profile
                            </button>
                        </form>
                    </div>

                    <!-- Sub-pane 2: Banking -->
                    <div id="sub-view-banking" class="sub-pane pp-card p-6 sm:p-8 hidden">
                        <div class="mb-6">
                            <h3 class="text-base font-extrabold text-slate-900">Settlement Bank Configuration</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Configure your target bank account for instant IMPS/NEFT payouts</p>
                        </div>

                        <form onsubmit="Terminal.saveBank(event)" class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Select Bank</label>
                                <select name="bank" class="pp-input mt-1">
                                    <% list.forEach((val) => { %>
                                        <option value="<%=val.name%>" <%=val.name == user.bank?.bank ? 'selected' : ''%>><%=val.name%></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Account Holder Name</label>
                                <input type="text" name="holder" value="<%=user.bank?.holder || ''%>" placeholder="Registered Business / Holder Name" class="pp-input mt-1">
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">Account Number</label>
                                    <input type="text" value="<%=user.bank?.account || ''%>" name="account" placeholder="0000111122223333" class="pp-input mt-1 mono">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">IFSC Code</label>
                                    <input type="text" value="<%=user.bank?.ifsc || ''%>" name="ifsc" placeholder="HDFC0001234" class="pp-input mt-1 uppercase mono">
                                </div>
                            </div>
                            <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs mt-2">
                                Save Settlement Bank Account
                            </button>
                        </form>
                    </div>

                    <!-- Sub-pane 3: Embedded UPI & Paytm Gateway Config (No Page Reload!) -->
                    <div id="sub-view-paytm" class="sub-pane pp-card p-6 sm:p-8 hidden">
                        <div class="mb-6">
                            <span class="px-2.5 py-1 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase">Direct-to-Account UPI</span>
                            <h3 class="text-base font-extrabold text-slate-900 mt-2">UPay 2.0 Multi-UPI Rail Configurator</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Update your Merchant ID, Primary VPA, and Fallback UPI ID without leaving the dashboard.</p>
                        </div>

                        <form onsubmit="Terminal.savePaytmRails(event)" class="space-y-4">
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Primary Merchant UPI ID (VPA)</label>
                                <input type="text" id="paytm-upi-input" value="<%=user.paytm?.UPI || ''%>" required placeholder="merchant@paytm" class="pp-input mt-1 mono">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Merchant ID (MID)</label>
                                <input type="text" id="paytm-mid-input" value="<%=user.paytm?.MID || ''%>" required placeholder="YOUR_MERCHANT_MID" class="pp-input mt-1 mono">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Secondary Fallback UPI ID (Optional)</label>
                                <input type="text" id="paytm-fallback-input" value="<%=user.paytm?.fallbackUPI || ''%>" placeholder="backupmerchant@ybl" class="pp-input mt-1 mono">
                            </div>
                            <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 cursor-pointer">
                                <span class="text-xs font-bold text-slate-700">Enable Automatic UPI Rail Failover</span>
                                <input type="checkbox" id="paytm-failover-input" <%=user.paytm?.autoFailover !== false ? 'checked' : ''%> class="accent-[#5f259f] w-4 h-4">
                            </label>
                            <button type="submit" class="w-full pp-btn-primary py-3.5 text-xs">
                                Verify & Save UPI Rails
                            </button>
                        </form>

                        <div id="paytm-qr-preview-box" class="hidden mt-6 p-5 rounded-2xl bg-purple-50 border border-purple-100 text-center">
                            <p class="text-xs font-extrabold text-[#5f259f] mb-2">Live Merchant Terminal QR Ready</p>
                            <img id="paytm-test-qr" src="" alt="Test QR" class="w-40 h-40 mx-auto rounded-xl bg-white p-2 border border-purple-200">
                        </div>
                    </div>
                </section>

            </div>
        </main>

        <!-- UPay 2.0 Mobile Bottom Navigation Bar -->
        <nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-purple-100 h-16 flex justify-around items-center px-2 z-50">
            <button onclick="Terminal.nav('overview')" data-mob="overview" class="mob-link text-[#5f259f] flex flex-col items-center gap-0.5 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect></svg>
                <span class="text-[10px] font-extrabold">Home</span>
