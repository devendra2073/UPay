                    ],
                    colors: ['#5f259f', '#00b970', '#ef4444'],
                    plotOptions: { bar: { borderRadius: 4, columnWidth: '62%' } },
                    dataLabels: { enabled: false },
                    xaxis: { categories: m.labels, labels: { style: { colors: '#64748b', fontSize: '10px', fontWeight: 600 } } },
                    yaxis: { labels: { formatter: (v) => `₹${Math.round(v).toLocaleString('en-IN')}`, style: { colors: '#64748b', fontSize: '10px' } } },
                    tooltip: { y: { formatter: (v) => `₹${Number(v || 0).toLocaleString('en-IN')}` } },
                    grid: { borderColor: '#f1f5f9', strokeDashArray: 4 },
                    legend: { position: 'top', fontSize: '11px', fontWeight: 700 },
                    noData: { text: 'No monthly history yet' }
                });
            },

            renderFailureChart(data) {
                const f = data.failureDiagnostics || { labels: [], counts: [] };
                this.mountChart('failure', 'chart-failure', {
                    chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'Plus Jakarta Sans, sans-serif' },
                    series: [{ name: 'Orders', data: f.counts }],
                    colors: ['#ef4444', '#f97316', '#f59e0b', '#ec4899', '#6366f1'],
                    plotOptions: { bar: { horizontal: true, distributed: true, borderRadius: 6, barHeight: '55%' } },
                    dataLabels: { enabled: true, style: { fontSize: '11px', fontWeight: 700, colors: ['#ffffff'] } },
                    xaxis: { categories: f.labels, labels: { formatter: (v) => Math.round(v), style: { colors: '#64748b', fontSize: '10px' } } },
                    yaxis: { labels: { style: { colors: '#334155', fontSize: '11px', fontWeight: 700 } } },
                    legend: { show: false },
                    grid: { borderColor: '#f1f5f9', strokeDashArray: 4 },
