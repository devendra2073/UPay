            <button onclick="Terminal.nav('history')" data-mob="history" class="mob-link text-slate-400 flex flex-col items-center gap-0.5 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span class="text-[10px] font-extrabold">Ledger</span>
