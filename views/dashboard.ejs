            async loadAnalytics() {
                try {
                    const range = this.state.analyticsRange || '30D';
                    const status = document.getElementById('chart-filter-status')?.value || 'ALL';
                    const mode = document.getElementById('chart-filter-mode')?.value || 'ALL';
                    const res = await fetch(`/user/dashboard/analytics?range=${encodeURIComponent(range)}&status=${encodeURIComponent(status)}&mode=${encodeURIComponent(mode)}`);
                    const data = await res.json();
                    if (!data.status) return;
                    this.state.analyticsData = data;

                    // Populate dynamic Payment Mode dropdown while keeping selection
                    const modeSelect = document.getElementById('chart-filter-mode');
                    if (modeSelect && data.filters?.availableModes) {
                        const prev = modeSelect.value;
                        const opts = ['<option value="ALL">All Payment Modes</option>']
                            .concat(data.filters.availableModes.map(m => `<option value="${m}">${m}</option>`));
                        modeSelect.innerHTML = opts.join('');
                        modeSelect.value = data.filters.availableModes.includes(prev) ? prev : 'ALL';
                    }

                    // Update real-time KPI cards
                    const k = data.kpis || {};
                    const fmtINR = (v) => `₹${Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    const elVol = document.getElementById('kpi-gross-volume');
                    const elPaid = document.getElementById('kpi-paid-orders');
                    const elConv = document.getElementById('kpi-conversion');
                    const elTot = document.getElementById('kpi-total-orders');
                    const elAvg = document.getElementById('kpi-avg-ticket');
                    const elTips = document.getElementById('kpi-tips-discounts');
                    const elFail = document.getElementById('kpi-failure-rate');
                    const elFailCnt = document.getElementById('kpi-failure-counts');

                    if (elVol) elVol.textContent = fmtINR(k.totalVolume);
                    if (elPaid) elPaid.textContent = `${k.paidCount || 0} paid orders`;
                    if (elConv) elConv.textContent = `${Number(k.conversionRate || 0).toFixed(1)}%`;
                    if (elTot) elTot.textContent = `${k.totalOrders || 0} total attempts`;
                    if (elAvg) elAvg.textContent = fmtINR(k.avgTicket);
                    if (elTips) elTips.textContent = `Tips ₹${Math.round(k.totalTips || 0)} • Disc ₹${Math.round(k.totalDiscounts || 0)}`;
                    if (elFail) elFail.textContent = `${Number(k.failureRate || 0).toFixed(1)}%`;
                    if (elFailCnt) elFailCnt.textContent = `${k.failedCount || 0} failed • ${k.pendingCount || 0} pending`;

                    this.renderAllCharts(data);
                } catch (err) {
                    console.error('Analytics load error:', err);
                }
            },

            async refreshAll(btn) {
                if (btn) btn.classList.add('refresh-spin');
                await Promise.all([this.refreshBalance(), this.refreshHistory(), this.loadPaymentLinks(), this.loadAnalytics()]);
                if (btn) setTimeout(() => btn.classList.remove('refresh-spin'), 600);
            },

            async refreshBalance() {
                if (this.state.isRefreshing) return;
                this.state.isRefreshing = true;
                const icon = document.getElementById('balance-refresh-icon');
                if (icon) icon.classList.add('refresh-spin');

                try {
                    const res = await fetch("/user/dashboard/balance");
                    const data = await res.json();
                    this.state.balance = data.wallet || 0;
                    document.getElementById('stat-balance').innerText = `₹${Number(this.state.balance).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                } catch (err) {
                    this.notify('Failed to sync balance', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                    this.state.isRefreshing = false;
                }
            },

            async refreshHistory() {
                const icon = document.getElementById('history-refresh-icon');
                if (icon) icon.classList.add('refresh-spin');
                const statusFilter = document.getElementById('ledger-status-filter')?.value || 'ALL_RECORDS';
                const query = statusFilter === 'ALL_RECORDS' ? '?all=1' : `?status=${statusFilter}`;

                try {
                    const res = await fetch(`/user/dashboard/transections${query}`);
                    this.state.transactions = await res.json();
                    this.filterLedgerLocal();
                } catch (err) {
                    this.notify('Failed to update ledger', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                }
            },

            filterLedgerLocal() {
                const q = (document.getElementById('ledger-search')?.value || '').toLowerCase().trim();
                this.state.filteredTransactions = (this.state.transactions || []).filter(tx => {
                    if (!q) return true;
                    return (
                        (tx.order || '').toLowerCase().includes(q) ||
                        (tx.utr || '').toLowerCase().includes(q) ||
                        (tx.customerName || '').toLowerCase().includes(q) ||
                        (tx.mode || '').toLowerCase().includes(q)
                    );
                });
                this.renderTransactions();
            },

            renderTransactions() {
                const container = document.getElementById('tx-container');
                if (!container) return;

                const list = this.state.filteredTransactions || [];
                if (!list.length) {
                    container.innerHTML = `
                        <div class="py-12 text-center text-slate-400">
                            <p class="text-xs font-bold">No transactions match the current filter.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(tx => `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3.5 hover:bg-purple-50/40 px-3 rounded-2xl transition-colors gap-2">
                        <div onclick="Terminal.openAuditDrawer('${tx.upaytr}')" class="flex items-center gap-3 cursor-pointer flex-1">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${tx.isPaid ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'} font-black text-xs">
                                ${tx.isPaid ? '✓' : '⏳'}
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <p class="text-xs font-extrabold text-slate-900">${tx.customerName || 'Guest'} • <span class="mono text-[#5f259f]">#${tx.order}</span></p>
                                    <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold ${tx.isPaid ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${tx.isPaid ? 'PAID' : 'PENDING'}</span>
                                </div>
                                <p class="mono text-[10px] text-slate-400">UTR: ${tx.utr || tx.submittedUtr || 'Awaiting Scan'} • Mode: ${tx.mode || 'UPI'} • Redirect: ${tx.redirect || '/pay/thanks'}</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-end gap-2.5">
                            ${!tx.isPaid ? `
                                <a href="/pay/${tx.order}" target="_blank" class="px-2.5 py-1 rounded-lg bg-purple-50 text-[#5f259f] text-[10px] font-extrabold">Checkout &nearr;</a>
                                <button onclick="Terminal.simulateOrderPaid('${tx.order}')" class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-extrabold cursor-pointer">Simulate Paid</button>
                            ` : ''}
                            <span onclick="Terminal.openAuditDrawer('${tx.upaytr}')" class="mono text-sm font-black ${tx.isPaid ? 'text-emerald-600' : 'text-slate-800'} cursor-pointer">
                                ${tx.isPaid ? '+' : ''}₹${Number(tx.amount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}
                            </span>
                        </div>
                    </div>
                `).join('');
            },

            async simulateOrderPaid(order) {
                const res = await fetch('/user/dashboard/simulate-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order })
                });
                const data = await res.json();
                if (data.status) {
                    this.notify(data.message);
                    this.refreshBalance();
                    this.refreshHistory();
                    this.loadPaymentLinks();
                    this.loadAnalytics();
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async openAuditDrawer(upaytr) {
                if (!upaytr) return;
                const res = await fetch(`/user/dashboard/api/transaction/${upaytr}`);
                const data = await res.json();
                if (!data.status) return this.notify(data.message || 'Could not load telemetry', 'warn');

                document.getElementById('drawer-order-id').textContent = `#${data.order}`;
                document.getElementById('drawer-amount').textContent = `₹${Number(data.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                document.getElementById('drawer-utr').textContent = data.utr;
                document.getElementById('drawer-status-badge').textContent = data.orderStatus;
                document.getElementById('drawer-full-audit-link').href = `/user/dashboard/transaction/${upaytr}`;

                const t = data.telemetry || {};
                const shot = data.dispute?.screenshot || '';
                document.getElementById('drawer-details-grid').innerHTML = `
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-slate-400">Order & Customer Metadata</p>
                        <p><strong>Mode:</strong> ${data.mode} | <strong>Redirect:</strong> <span class="mono">${data.redirect}</span></p>
                        <p><strong>Customer:</strong> ${data.customerName} (${data.customerEmail})</p>
                        <p><strong>Phone:</strong> ${data.customerPhone}</p>
                        <p><strong>Created:</strong> ${data.created_at} | <strong>Paid:</strong> ${data.payment_date}</p>
                        <p><strong>Base:</strong> ₹${data.baseAmount} | <strong>Discount:</strong> -₹${data.discountAmount} | <strong>Tip:</strong> +₹${data.tipAmount} | <strong>Fee:</strong> +₹${data.feeAmount}</p>
                        ${data.customerNote ? `<p><strong>Note:</strong> ${data.customerNote}</p>` : ''}
                    </div>
                    ${data.dispute?.raised ? `
                    <div class="p-3.5 rounded-xl bg-rose-50/70 border border-rose-200 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-rose-600">Dispute & Proof Details (${data.dispute.status})</p>
                        <p><strong>Submitted UTR:</strong> <span class="mono">${data.dispute.utr || data.submittedUtr}</span></p>
                        <p><strong>Customer Query:</strong> ${data.dispute.reason}</p>
                        ${shot ? `<img src="${shot}" onclick="Terminal.previewScreenshotModal('${shot}')" class="mt-2 max-h-36 rounded-xl border border-rose-200 cursor-pointer" title="Click to enlarge">` : ''}
                    </div>
                    ` : ''}
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-slate-400">Device & Network Telemetry</p>
                        <p><strong>Client IP:</strong> <span class="mono">${t.ip}</span> (${t.isp})</p>
                        <p><strong>Device:</strong> ${t.deviceBrand} ${t.deviceModel} (${t.deviceType})</p>
                        <p><strong>OS / Browser:</strong> ${t.osName} ${t.osVersion} • ${t.browserName}</p>
                        <p><strong>Geo Location:</strong> ${t.city}, ${t.region}, ${t.country} (${t.zip})</p>
                    </div>
                `;

                const overlay = document.getElementById('audit-drawer-overlay');
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
            },

            closeAuditDrawer() {
                const overlay = document.getElementById('audit-drawer-overlay');
                overlay.classList.add('hidden');
                overlay.classList.remove('flex');
            },

            exportLedgerCSV() {
                const rows = this.state.filteredTransactions || [];
                if (!rows.length) return this.notify('No transactions to export', 'warn');
                const headers = ['OrderID', 'Amount', 'Status', 'UTR', 'Mode', 'Redirect', 'CustomerName', 'CustomerEmail', 'CreatedAt'];
                const csv = [
                    headers.join(','),
                    ...rows.map(r => [
                        r.order,
                        r.amount,
                        r.isPaid ? 'PAID' : 'PENDING',
                        r.utr || r.submittedUtr || '',
                        r.mode || 'UPI',
                        r.redirect || '/pay/thanks',
                        `"${(r.customerName || '').replace(/"/g, '""')}"`,
                        r.customerEmail || '',
                        r.created_at || ''
                    ].join(','))
                ].join('\n');

                const blob = new Blob([csv], { type: 'text/csv' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `UPay2_Ledger_${Date.now()}.csv`;
                a.click();
                URL.revokeObjectURL(url);
                this.notify('CSV Ledger Exported!');
            },

            async saveProfile(e) {
                e.preventDefault();
                const data = Object.fromEntries(new FormData(e.target).entries());
                const res = await fetch('/user/dashboard/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            async saveBank(e) {
                e.preventDefault();
                const data = Object.fromEntries(new FormData(e.target).entries());
                const res = await fetch('/user/dashboard/bank', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            async saveSettings(btn) {
                const callback = document.getElementById("callback").value;
                const redirect = document.getElementById("redirect").value;
                const res = await fetch('/user/dashboard/callback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callback, redirect })
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            mountChart(key, elId, options) {
                const el = document.getElementById(elId);
                if (!el || typeof ApexCharts === 'undefined') return;
                if (this.state.charts[key]) {
                    this.state.charts[key].destroy();
                }
                const chart = new ApexCharts(el, options);
                chart.render();
                this.state.charts[key] = chart;
            },

            renderAllCharts(data) {
                this.renderDailyChart(data);
                this.renderDeliveryChart(data);
                this.renderMonthlyChart(data);
                this.renderFailureChart(data);
                this.renderModeChart(data);
                this.renderTicketChart(data);
                this.renderHourlyChart(data);
            },

            renderDailyChart(dataArg) {
                const data = dataArg || this.state.analyticsData;
                if (!data || !data.daily) return;
                const d = data.daily;
                const viewMode = document.getElementById('daily-metric-mode')?.value || 'COMBO';

                if (viewMode === 'COUNTS') {
                    this.mountChart('daily', 'chart-daily', {
                        chart: { type: 'bar', height: 290, stacked: true, toolbar: { show: true }, fontFamily: 'Plus Jakarta Sans, sans-serif' },
                        series: [
                            { name: 'Paid Orders', data: d.paidCount },
                            { name: 'Pending Orders', data: d.pendingCount },
                            { name: 'Failed Orders', data: d.failedCount }
                        ],
                        colors: ['#00b970', '#f59e0b', '#ef4444'],
                        plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
                        dataLabels: { enabled: false },
                        xaxis: { categories: d.labels, labels: { style: { colors: '#64748b', fontSize: '10px', fontWeight: 600 } } },
                        yaxis: { labels: { formatter: (v) => Math.round(v), style: { colors: '#64748b', fontSize: '10px' } } },
                        grid: { borderColor: '#f1f5f9', strokeDashArray: 4 },
                        legend: { position: 'top', fontSize: '11px', fontWeight: 700 },
                        noData: { text: 'No daily orders found for this filter' }
                    });
                    return;
                }

                this.mountChart('daily', 'chart-daily', {
                    chart: { type: 'line', height: 290, toolbar: { show: true }, fontFamily: 'Plus Jakarta Sans, sans-serif' },
                    series: [
                        { name: 'Paid Volume (₹)', type: 'area', data: d.volume },
                        { name: 'Paid Orders', type: 'column', data: d.paidCount }
                    ],
                    colors: ['#5f259f', '#00b970'],
                    stroke: { width: [3, 0], curve: 'smooth' },
                    fill: {
                        type: ['gradient', 'solid'],
                        gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.04, stops: [0, 95, 100] }
                    },
                    plotOptions: { bar: { borderRadius: 4, columnWidth: '45%' } },
                    dataLabels: { enabled: false },
                    xaxis: { categories: d.labels, labels: { style: { colors: '#64748b', fontSize: '10px', fontWeight: 600 } } },
                    yaxis: [
                        {
                            title: { text: 'Volume (₹)', style: { color: '#5f259f', fontSize: '10px', fontWeight: 700 } },
                            labels: { formatter: (v) => `₹${Math.round(v).toLocaleString('en-IN')}`, style: { colors: '#64748b', fontSize: '10px' } }
                        },
                        {
                            opposite: true,
                            title: { text: 'Orders', style: { color: '#00b970', fontSize: '10px', fontWeight: 700 } },
                            labels: { formatter: (v) => Math.round(v), style: { colors: '#64748b', fontSize: '10px' } }
                        }
                    ],
                    tooltip: { shared: true, intersect: false },
                    grid: { borderColor: '#f1f5f9', strokeDashArray: 4 },
                    legend: { position: 'top', fontSize: '11px', fontWeight: 700 },
                    noData: { text: 'No daily transactions found' }
                });
            },

            renderDeliveryChart(data) {
                const db = data.deliveryBreakdown || { labels: [], counts: [] };
                const hasData = (db.counts || []).some(c => c > 0);
                this.mountChart('delivery', 'chart-delivery', {
                    chart: { type: 'donut', height: 290, fontFamily: 'Plus Jakarta Sans, sans-serif' },
                    series: hasData ? db.counts : [],
                    labels: db.labels,
                    colors: ['#00b970', '#f59e0b', '#ef4444', '#6366f1'],
                    stroke: { width: 2, colors: ['#ffffff'] },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '68%',
                                labels: {
                                    show: true,
                                    total: {
                                        show: true,
                                        label: 'Total Orders',
                                        fontSize: '11px',
                                        fontWeight: 700,
                                        color: '#64748b',
                                        formatter: (w) => w.globals.seriesTotals.reduce((a, b) => a + b, 0)
                                    }
                                }
                            }
                        }
                    },
                    dataLabels: { enabled: true, style: { fontSize: '10px', fontWeight: 700 } },
                    legend: { position: 'bottom', fontSize: '11px', fontWeight: 700 },
                    noData: { text: 'No orders in selected filter', style: { color: '#94a3b8', fontSize: '12px' } }
                });
            },

            renderMonthlyChart(data) {
                const m = data.monthly || { labels: [], paidVolume: [], withdrawnVolume: [], refundedVolume: [] };
                this.mountChart('monthly', 'chart-monthly', {
                    chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'Plus Jakarta Sans, sans-serif' },
                    series: [
                        { name: 'Paid Collections (₹)', data: m.paidVolume },
                        { name: 'Bank Withdrawals (₹)', data: m.withdrawnVolume },
