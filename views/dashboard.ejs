                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"></path></svg>
                <span class="text-[10px] font-extrabold">Links</span>
            </button>
            <button onclick="Terminal.nav('disputes')" data-mob="disputes" class="mob-link text-slate-400 flex flex-col items-center gap-0.5 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944"></path></svg>
                <span class="text-[10px] font-extrabold">Disputes</span>
            </button>
            <button onclick="Terminal.nav('profile')" data-mob="profile" class="mob-link text-slate-400 flex flex-col items-center gap-0.5 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82"></path></svg>
                <span class="text-[10px] font-extrabold">Profile</span>
            </button>
        </nav>
    </div>

    <!-- ================================================================= -->
    <!-- IN-APP SLIDE-OVER TRANSACTION TELEMETRY DRAWER                    -->
    <!-- ================================================================= -->
    <div id="audit-drawer-overlay" class="fixed inset-0 z-[90] bg-slate-950/50 backdrop-blur-xs hidden justify-end">
        <div class="w-full max-w-lg bg-white h-full shadow-2xl border-l border-purple-100 flex flex-col justify-between overflow-y-auto p-6">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-purple-100">
                    <div>
                        <span class="px-2.5 py-0.5 rounded-full bg-purple-100 text-[#5f259f] text-[10px] font-extrabold uppercase">UPay 2.0 Transaction Telemetry</span>
                        <h3 id="drawer-order-id" class="text-base font-extrabold text-slate-900 mono mt-1">#ORDER</h3>
                    </div>
                    <button onclick="Terminal.closeAuditDrawer()" class="p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 cursor-pointer">&times;</button>
                </div>

                <div class="my-5 p-5 rounded-2xl bg-gradient-to-r from-[#5f259f] to-[#7c3aed] text-white">
                    <p class="text-[11px] uppercase tracking-wider text-purple-200 font-bold">Order Amount</p>
                    <p id="drawer-amount" class="text-3xl font-black mt-1">&#8377;0.00</p>
                    <div class="flex items-center justify-between text-xs text-purple-100 mt-3 pt-3 border-t border-white/15">
                        <span>UTR: <strong id="drawer-utr" class="mono text-white">N/A</strong></span>
                        <span id="drawer-status-badge" class="px-2 py-0.5 rounded bg-white/20 font-bold">PAID</span>
                    </div>
                </div>

                <div id="drawer-details-grid" class="space-y-3 text-xs"></div>
            </div>

            <div class="pt-4 border-t border-purple-100 flex gap-2.5 mt-6">
                <a id="drawer-full-audit-link" href="#" target="_blank" class="flex-1 py-3 rounded-xl bg-purple-50 text-[#5f259f] font-extrabold text-xs text-center hover:bg-purple-100 transition">
                    Open Full Audit Page &nearr;
                </a>
                <button onclick="Terminal.closeAuditDrawer()" class="px-5 py-3 rounded-xl bg-slate-900 text-white font-extrabold text-xs cursor-pointer">
                    Done
                </button>
            </div>
        </div>
    </div>

    <!-- Screenshot Lightbox Modal for Dispute Inspection -->
    <div id="screenshot-lightbox" onclick="this.classList.add('hidden'); this.classList.remove('flex')" class="fixed inset-0 z-[95] bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-6 cursor-pointer">
        <div class="max-w-xl w-full bg-white p-4 rounded-3xl shadow-2xl text-center" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-extrabold text-slate-800">Customer Uploaded Payment Screenshot</span>
                <button type="button" onclick="document.getElementById('screenshot-lightbox').classList.add('hidden'); document.getElementById('screenshot-lightbox').classList.remove('flex')" class="px-2.5 py-1 rounded-lg bg-slate-100 text-xs font-bold cursor-pointer">Close &times;</button>
            </div>
            <img id="lightbox-img" src="" alt="Dispute Screenshot" class="max-h-[70vh] mx-auto rounded-2xl object-contain border border-slate-200">
        </div>
    </div>

    <script src="/js/popup.js"></script>
    <script>
        const INITIAL_COUPONS = <%- JSON.stringify(user.coupons || []) %>;
        const INITIAL_LINKS = <%- JSON.stringify(user.paymentLinks || []) %>;
        const INITIAL_WITHDRAWALS = <%- JSON.stringify(user.withdrawals || []) %>;

        const Terminal = {
            state: {
                balance: parseFloat(<%=user.wallet || 0%>),
                isRefreshing: false,
                chart: null,
                transactions: [],
                filteredTransactions: [],
                coupons: INITIAL_COUPONS,
                paymentLinks: INITIAL_LINKS,
                withdrawals: INITIAL_WITHDRAWALS,
                customers: [],
                disputes: []
            },

            init() {
                this.refreshHistory();
                this.initChart();
                this.renderCoupons();
                this.loadPaymentLinks();
                this.renderWithdrawals();
            },

            nav(viewId) {
                document.getElementById('view-scroller').scrollTo({ top: 0, behavior: 'smooth' });
                document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
                const target = document.getElementById(`view-${viewId}`);
                if (target) target.classList.add('active');

                const titles = {
                    overview: 'Home & Analytics',
                    history: 'Smart Transaction Ledger',
                    themes: 'UPay 2.0 Theme Studio',
                    links: 'Payment Links & Complete Details',
                    coupons: 'Offers & Discount Coupons',
                    settlements: 'Settlements & Instant Bank Payouts',
                    customers: 'Customer Directory & Ratings',
                    disputes: 'Disputes, Screenshots & UTR Verification',
                    developer: 'API, Webhooks & Security Controls',
                    profile: 'Merchant Logo, Profile & UPI Rails'
                };
                document.getElementById('view-title').innerText = titles[viewId] || 'UPay 2.0 Business';

                document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
                const activeNav = document.querySelector(`[data-nav="${viewId}"]`);
                if (activeNav) activeNav.classList.add('active');

                document.querySelectorAll('.mob-link').forEach(el => el.classList.replace('text-[#5f259f]', 'text-slate-400'));
                const activeMob = document.querySelector(`[data-mob="${viewId}"]`);
                if (activeMob) activeMob.classList.replace('text-slate-400', 'text-[#5f259f]');

                if (viewId === 'overview') this.initChart();
                if (viewId === 'links') this.loadPaymentLinks();
                if (viewId === 'customers') this.loadCustomers();
                if (viewId === 'disputes') this.loadDisputes();
            },

            subProfile(subId) {
                document.querySelectorAll('.sub-pane').forEach(el => el.classList.add('hidden'));
                const targetSub = document.getElementById(`sub-view-${subId}`);
                if (targetSub) targetSub.classList.remove('hidden');

                document.querySelectorAll('.sub-trigger').forEach(el => {
                    el.classList.remove('bg-white', 'shadow-xs', 'text-[#5f259f]');
                    el.classList.add('text-slate-600');
                });
                const activeSubNav = document.getElementById(`sub-nav-${subId}`);
                if (activeSubNav) {
                    activeSubNav.classList.remove('text-slate-600');
                    activeSubNav.classList.add('bg-white', 'shadow-xs', 'text-[#5f259f]');
                }
            },

            // Admin Logo / Profile Pic Upload
            handleLogoFileSelect(event) {
                const file = event.target.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = async (e) => {
                    const base64Img = e.target.result;
                    await this.uploadLogoPayload(base64Img);
                };
                reader.readAsDataURL(file);
            },

            async saveLogoFromUrl() {
                const url = document.getElementById('logo-url-input').value.trim();
                if (!url) return this.notify('Please enter an image URL', 'warn');
                await this.uploadLogoPayload(url);
            },

            async uploadLogoPayload(imageStr) {
                const res = await fetch('/user/dashboard/logo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image: imageStr })
                });
                const data = await res.json();
                if (data.status) {
                    document.getElementById('prfl').src = data.pic;
                    document.getElementById('profile-main-avatar').src = data.pic;
                    document.getElementById('sidebar-brand-logo').src = data.pic;
                    this.notify(data.message);
                } else {
                    this.notify(data.message || 'Could not update logo', 'warn');
                }
            },

            selectAdminTheme(themeId) {
                document.getElementById('cfg-default-theme').value = themeId;
                document.querySelectorAll('.theme-card-option').forEach(el => {
                    if (el.getAttribute('data-theme-card') === themeId) {
                        el.className = 'theme-card-option p-4 rounded-2xl border-2 cursor-pointer transition-all border-[#5f259f] bg-purple-50/50 shadow-md';
                    } else {
                        el.className = 'theme-card-option p-4 rounded-2xl border-2 cursor-pointer transition-all border-slate-200 hover:border-purple-300 bg-white';
                    }
                });
            },

            async saveThemeStudio() {
                const payload = {
                    defaultTheme: document.getElementById('cfg-default-theme').value,
                    allowCustomerThemeChange: document.getElementById('cfg-allow-theme').checked,
                    allowCustomTheme: document.getElementById('cfg-allow-custom').checked,
                    tagline: document.getElementById('cfg-tagline').value,
                    enableCoupons: document.getElementById('cfg-enable-coupons').checked,
                    enableTips: document.getElementById('cfg-enable-tips').checked,
                    enableSplitBill: document.getElementById('cfg-enable-split').checked,
                    passFeeToCustomer: document.getElementById('cfg-pass-fee').checked,
                    convenienceFeePercent: document.getElementById('cfg-fee-percent').value,
                    supportEmail: document.getElementById('cfg-support-email').value,
                    supportWhatsapp: document.getElementById('cfg-support-wa').value,
                    customTheme: {
                        primary: document.getElementById('cust-primary').value,
                        secondary: document.getElementById('cust-secondary').value,
                        background: document.getElementById('cust-background').value,
                        surface: document.getElementById('cust-surface').value,
                        text: document.getElementById('cust-text').value,
                        radius: document.getElementById('cust-radius').value
                    }
                };
                const res = await fetch('/user/dashboard/theme-config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.status) {
                    const badge = document.getElementById('badge-active-theme');
                    if (badge) badge.textContent = payload.defaultTheme;
                    this.notify(data.message);
                } else {
                    this.notify(data.message || 'Error saving theme', 'warn');
                }
            },

            async createCoupon(e) {
                e.preventDefault();
                const fd = new FormData(e.target);
                const payload = Object.fromEntries(fd.entries());
                payload.action = 'CREATE';
                const res = await fetch('/user/dashboard/coupons', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.status) {
                    this.state.coupons = data.coupons || [];
                    this.renderCoupons();
                    e.target.reset();
                    this.notify(data.message);
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async toggleCoupon(code, action = 'TOGGLE') {
                const res = await fetch('/user/dashboard/coupons', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, code })
                });
                const data = await res.json();
                if (data.status) {
                    this.state.coupons = data.coupons || [];
                    this.renderCoupons();
                    this.notify(data.message);
                }
            },

            renderCoupons() {
                const countEl = document.getElementById('kpi-coupons-count');
                if (countEl) countEl.textContent = this.state.coupons.length;
                const box = document.getElementById('coupons-list');
                if (!box) return;
                if (!this.state.coupons.length) {
                    box.innerHTML = `<p class="text-xs text-slate-400 py-8 text-center">No promo codes created yet.</p>`;
                    return;
                }
                box.innerHTML = this.state.coupons.map(c => `
                    <div class="p-4 rounded-2xl border border-purple-100 bg-purple-50/30 flex items-center justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded-lg bg-[#5f259f] text-white mono text-xs font-extrabold">${c.code}</span>
                                <span class="text-xs font-extrabold text-slate-800">${c.type === 'PERCENT' ? c.value + '% OFF' : '₹' + c.value + ' FLAT OFF'}</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${c.active ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600'}">${c.active ? 'ACTIVE' : 'PAUSED'}</span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-1">Min Order: ₹${c.minOrder || 0} • Max Discount: ₹${c.maxDiscount || 500}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="Terminal.toggleCoupon('${c.code}', 'TOGGLE')" class="px-3 py-1.5 rounded-lg border border-purple-200 text-xs font-bold text-[#5f259f] cursor-pointer">${c.active ? 'Pause' : 'Activate'}</button>
                            <button onclick="Terminal.toggleCoupon('${c.code}', 'DELETE')" class="px-3 py-1.5 rounded-lg bg-rose-50 text-xs font-bold text-rose-600 cursor-pointer">Delete</button>
                        </div>
                    </div>
                `).join('');
            },

            async loadPaymentLinks() {
                try {
                    const res = await fetch('/user/dashboard/payment-links', { silent: true });
                    const data = await res.json();
                    if (data.status) {
                        this.state.paymentLinks = data.paymentLinks || [];
                        this.renderPaymentLinks();
                    }
                } catch (e) {
                    this.renderPaymentLinks();
                }
            },

            async createPaymentLink(e) {
                e.preventDefault();
                const fd = new FormData(e.target);
                const payload = Object.fromEntries(fd.entries());
                payload.action = 'CREATE';
                const res = await fetch('/user/dashboard/payment-links', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.status) {
                    this.state.paymentLinks = data.paymentLinks || [];
                    this.renderPaymentLinks();
                    e.target.reset();
                    this.notify(data.message);
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async deletePaymentLink(linkId) {
                const res = await fetch('/user/dashboard/payment-links', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'DELETE', linkId })
                });
                const data = await res.json();
                if (data.status) {
                    this.state.paymentLinks = data.paymentLinks || [];
                    this.renderPaymentLinks();
                    this.notify(data.message);
                }
            },

            renderPaymentLinks() {
                const countEl = document.getElementById('kpi-links-count');
                if (countEl) countEl.textContent = this.state.paymentLinks.length;
                const box = document.getElementById('payment-links-list');
                if (!box) return;
                if (!this.state.paymentLinks.length) {
                    box.innerHTML = `<p class="text-xs text-slate-400 py-8 text-center">No shareable payment links yet. Create one on the left!</p>`;
                    return;
                }
                box.innerHTML = this.state.paymentLinks.map(l => `
                    <div class="p-4 rounded-2xl border border-purple-100 bg-white space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="px-2 py-0.5 rounded-md bg-purple-100 text-[#5f259f] mono text-[10px] font-extrabold">${l.linkId}</span>
                                    <span class="text-sm font-extrabold text-slate-900">${l.title}</span>
                                    <span class="mono text-sm font-black text-[#5f259f]">₹${Number(l.finalAmount || l.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${l.isPaid ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">
                                        ${l.isPaid ? '✓ PAID' : '⏳ PENDING'}
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-500 mt-1">${l.description || 'Manual Payment Link'} • Order: <strong class="mono text-slate-700">#${l.orderId || 'N/A'}</strong></p>
                            </div>
                            <div class="flex flex-wrap items-center gap-1.5">
                                ${l.upaytr ? `<button onclick="Terminal.openAuditDrawer('${l.upaytr}')" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold text-xs cursor-pointer">Full Details</button>` : ''}
                                <button onclick="Terminal.copy('${window.location.origin}${l.url}')" class="px-3 py-1.5 rounded-xl bg-purple-50 text-[#5f259f] font-extrabold text-xs cursor-pointer">Copy Link</button>
                                <a href="${l.url}" target="_blank" class="px-3 py-1.5 rounded-xl bg-[#5f259f] text-white font-extrabold text-xs">Open &nearr;</a>
                                <button onclick="Terminal.deletePaymentLink('${l.linkId}')" class="px-2.5 py-1.5 rounded-xl bg-rose-50 text-rose-600 font-bold text-xs cursor-pointer">&times;</button>
                            </div>
                        </div>

                        <!-- Complete Payment Link Metadata Bar (UTR, Payer, Redirect, Timestamps) -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2.5 border-t border-slate-100 text-[11px]">
                            <div class="bg-slate-50 p-2 rounded-xl">
                                <span class="text-[9px] font-bold uppercase text-slate-400 block">Payment UTR</span>
                                <span class="mono font-bold text-slate-800">${l.utr || l.submittedUtr || 'Awaiting Payment'}</span>
                            </div>
                            <div class="bg-slate-50 p-2 rounded-xl">
                                <span class="text-[9px] font-bold uppercase text-slate-400 block">Payer Name & Contact</span>
                                <span class="font-bold text-slate-800 truncate block">${l.customerName || l.title} (${l.customerPhone || 'N/A'})</span>
                            </div>
                            <div class="bg-slate-50 p-2 rounded-xl">
                                <span class="text-[9px] font-bold uppercase text-slate-400 block">Redirect Route</span>
                                <span class="mono font-bold text-[#5f259f]">${l.redirect || '/pay/thanks'}</span>
                            </div>
                            <div class="bg-slate-50 p-2 rounded-xl">
                                <span class="text-[9px] font-bold uppercase text-slate-400 block">${l.isPaid ? 'Paid Timestamp' : 'Created Timestamp'}</span>
                                <span class="font-bold text-slate-700">${l.paymentDate || l.orderCreatedAt || 'Just now'}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            },

            async requestWithdrawal(e) {
                e.preventDefault();
                const amount = document.getElementById('withdraw-amount').value;
                const mode = document.getElementById('withdraw-mode').value;
                const res = await fetch('/user/dashboard/withdraw', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount, mode })
                });
                const data = await res.json();
                if (data.status) {
                    this.state.balance = data.wallet;
                    document.getElementById('stat-balance').innerText = `₹${Number(data.wallet).toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                    this.state.withdrawals = data.withdrawals || [];
                    this.renderWithdrawals();
                    this.notify(data.message);
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            renderWithdrawals() {
                const box = document.getElementById('withdrawals-list');
                if (!box) return;
                if (!this.state.withdrawals.length) {
                    box.innerHTML = `<p class="text-xs text-slate-400 py-8 text-center">No bank withdrawals initiated yet.</p>`;
                    return;
                }
                box.innerHTML = this.state.withdrawals.map(w => `
                    <div class="p-4 rounded-2xl border border-slate-100 bg-slate-50/70 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-extrabold text-slate-900">${w.bankName || 'Settlement Bank'} (••${w.accountLast4 || '0000'})</p>
                            <p class="text-[11px] text-slate-400 mono">${w.wid} • ${w.mode} • ${new Date(w.createdAt).toLocaleString()}</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-black text-emerald-600">₹${Number(w.amount).toLocaleString('en-IN')}</p>
                            <span class="text-[10px] font-extrabold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">${w.status}</span>
                        </div>
                    </div>
                `).join('');
            },

            async loadCustomers() {
                const res = await fetch('/user/dashboard/customers');
                const data = await res.json();
                const box = document.getElementById('customers-list');
                if (!box) return;
                const list = data.customers || [];
                if (!list.length) {
                    box.innerHTML = `<p class="text-xs text-slate-400 py-8 text-center">No customer records found yet.</p>`;
                    return;
                }
                box.innerHTML = list.map(c => `
                    <div class="py-3.5 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-purple-100 text-[#5f259f] font-extrabold text-xs flex items-center justify-center uppercase">
                                ${(c.name || 'G').slice(0, 2)}
                            </div>
                            <div>
                                <p class="text-xs font-extrabold text-slate-900">${c.name}</p>
                                <p class="text-[11px] text-slate-400">${c.email} • ${c.phone}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-black text-slate-900">₹${Number(c.totalSpend).toLocaleString('en-IN')} <span class="text-[10px] text-slate-400 font-semibold">(${c.paidCount}/${c.txCount} paid)</span></p>
                            <p class="text-[10px] text-amber-500 font-bold">${c.lastRating ? '★'.repeat(c.lastRating) + ' Rated' : 'Verified Payer'}</p>
                        </div>
                    </div>
                `).join('');
            },

            previewScreenshotModal(imgUrl) {
                if (!imgUrl) return;
                document.getElementById('lightbox-img').src = imgUrl;
                const lb = document.getElementById('screenshot-lightbox');
                lb.classList.remove('hidden');
                lb.classList.add('flex');
            },

            async loadDisputes() {
                const res = await fetch('/user/dashboard/refunds', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'LIST' })
                });
                const data = await res.json();
                const box = document.getElementById('disputes-list');
                if (!box) return;
                const items = data.items || [];
                if (!items.length) {
                    box.innerHTML = `<p class="text-xs text-slate-400 py-8 text-center">Zero active disputes or manual UTR claims! All transactions healthy.</p>`;
                    return;
                }
                box.innerHTML = items.map(item => {
                    const shot = item.dispute?.screenshot || '';
                    const dispUtr = item.dispute?.utr || item.submittedUtr || item.utr || 'N/A';
                    return `
                    <div class="p-5 rounded-2xl border border-purple-100 bg-white flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                            ${shot ? `
                                <div onclick="Terminal.previewScreenshotModal('${shot}')" class="w-20 h-20 rounded-xl border-2 border-purple-200 overflow-hidden shrink-0 cursor-pointer relative group bg-slate-100" title="Click to enlarge screenshot">
                                    <img src="${shot}" alt="Payment Proof" class="w-full h-full object-cover">
                                    <span class="absolute inset-0 bg-black/40 text-white text-[9px] font-extrabold flex items-center justify-center opacity-0 group-hover:opacity-100 transition">Zoom 🔍</span>
                                </div>
                            ` : `
                                <div class="w-20 h-20 rounded-xl border border-dashed border-slate-200 bg-slate-50 flex items-center justify-center text-[10px] text-slate-400 font-bold shrink-0 text-center p-2">
                                    No Image
                                </div>
                            `}
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="mono text-xs font-extrabold text-[#5f259f]">#${item.order}</span>
                                    <span class="text-sm font-black text-slate-900">₹${item.amount}</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">${item.dispute?.status || item.status}</span>
                                </div>
                                <p class="text-xs font-bold text-slate-800 mt-1">Query: "${item.dispute?.reason || 'Manual UTR verification requested'}"</p>
                                <p class="text-[11px] text-slate-500 mono mt-1">Customer: ${item.customerName} (${item.customerPhone || 'N/A'}) • Submitted UTR: <strong class="text-slate-900">${dispUtr}</strong></p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 shrink-0">
                            ${shot ? `<button onclick="Terminal.previewScreenshotModal('${shot}')" class="px-3 py-2 rounded-xl bg-purple-50 text-[#5f259f] text-xs font-extrabold cursor-pointer">View Proof</button>` : ''}
                            <button onclick="Terminal.resolveDispute('${item.order}', 'RESOLVE')" class="px-3.5 py-2 rounded-xl bg-emerald-600 text-white text-xs font-extrabold cursor-pointer">Approve & Verify UTR</button>
                            <button onclick="Terminal.resolveDispute('${item.order}', 'REFUND')" class="px-3.5 py-2 rounded-xl bg-amber-500 text-white text-xs font-extrabold cursor-pointer">Issue Refund</button>
                            <button onclick="Terminal.resolveDispute('${item.order}', 'REJECT')" class="px-3.5 py-2 rounded-xl bg-rose-50 text-rose-600 text-xs font-extrabold cursor-pointer">Reject</button>
                        </div>
                    </div>
                `}).join('');
            },

            async resolveDispute(order, action) {
                const res = await fetch('/user/dashboard/refunds', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order, action })
                });
                const data = await res.json();
                if (data.status) {
                    this.notify(data.message);
                    this.loadDisputes();
                    this.refreshBalance();
                    this.refreshHistory();
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async rotateKey() {
                const res = await fetch('/user/dashboard/rotate-api-key', { method: 'POST' });
                const data = await res.json();
                if (data.status) {
                    document.getElementById('api-key-display').innerText = data.api;
                    this.notify(data.message);
                }
            },

            async saveSecurity() {
                const payload = {
                    maintenanceMode: document.getElementById('sec-maintenance').checked,
                    minOrderAmount: document.getElementById('sec-min-amt').value,
                    maxOrderAmount: document.getElementById('sec-max-amt').value,
                    ipWhitelist: document.getElementById('sec-ips').value,
                    autoSettleEnabled: document.getElementById('sec-autosettle').checked,
                    autoSettleThreshold: document.getElementById('sec-threshold').value
                };
                const res = await fetch('/user/dashboard/security', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                this.notify(data.message, data.status ? 'success' : 'warn');
            },

            async runWebhookSimulator() {
                const callback = document.getElementById('callback').value;
                const res = await fetch('/user/dashboard/test-webhook', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callback, amount: 499 })
                });
                const data = await res.json();
                const out = document.getElementById('webhook-test-output');
                out.classList.remove('hidden');
                out.textContent = JSON.stringify(data.payload, null, 2);
                this.notify(data.message);
            },

            async savePaytmRails(e) {
                e.preventDefault();
                const UPI = document.getElementById('paytm-upi-input').value;
                const MID = document.getElementById('paytm-mid-input').value;
                const fallbackUPI = document.getElementById('paytm-fallback-input').value;
                const autoFailover = document.getElementById('paytm-failover-input').checked;

                const res = await fetch('/user/dashboard/paytm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UPI, MID, fallbackUPI, autoFailover })
                });
                const data = await res.json();
                if (data.status) {
                    document.getElementById('overview-upi-display').textContent = UPI;
                    if (data.qrDataUrl) {
                        document.getElementById('paytm-test-qr').src = data.qrDataUrl;
                        document.getElementById('paytm-qr-preview-box').classList.remove('hidden');
                    }
                    this.notify(data.message);
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async loadAnalytics(range, btn) {
                document.querySelectorAll('.range-btn').forEach(b => {
                    b.className = 'range-btn px-3 py-1.5 rounded-lg text-xs font-extrabold text-slate-600 hover:text-[#5f259f] cursor-pointer';
                });
                if (btn) btn.className = 'range-btn px-3 py-1.5 rounded-lg text-xs font-extrabold bg-[#5f259f] text-white cursor-pointer';

                const res = await fetch(`/user/dashboard/analytics?range=${range}`);
                const data = await res.json();
                if (data.status && this.state.chart) {
                    this.state.chart.data.labels = data.labels;
                    this.state.chart.data.datasets[0].data = data.series;
                    this.state.chart.update();
                    if (data.avgTicket) document.getElementById('kpi-avg-ticket').textContent = `₹${data.avgTicket}`;
                    if (data.conversionRate) document.getElementById('kpi-conversion').textContent = `${data.conversionRate}%`;
                }
            },

            async refreshAll(btn) {
                if (btn) btn.classList.add('refresh-spin');
                await Promise.all([this.refreshBalance(), this.refreshHistory(), this.loadPaymentLinks()]);
                if (btn) setTimeout(() => btn.classList.remove('refresh-spin'), 600);
            },

            async refreshBalance() {
                if (this.state.isRefreshing) return;
                this.state.isRefreshing = true;
                const icon = document.getElementById('balance-refresh-icon');
                if (icon) icon.classList.add('refresh-spin');

                try {
                    const res = await fetch("/user/dashboard/balance");
                    const data = await res.json();
                    this.state.balance = data.wallet || 0;
                    document.getElementById('stat-balance').innerText = `₹${Number(this.state.balance).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                } catch (err) {
                    this.notify('Failed to sync balance', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                    this.state.isRefreshing = false;
                }
            },

            async refreshHistory() {
                const icon = document.getElementById('history-refresh-icon');
                if (icon) icon.classList.add('refresh-spin');
                const statusFilter = document.getElementById('ledger-status-filter')?.value || 'ALL_RECORDS';
                const query = statusFilter === 'ALL_RECORDS' ? '?all=1' : `?status=${statusFilter}`;

                try {
                    const res = await fetch(`/user/dashboard/transections${query}`);
                    this.state.transactions = await res.json();
                    this.filterLedgerLocal();
                } catch (err) {
                    this.notify('Failed to update ledger', 'warn');
                } finally {
                    if (icon) icon.classList.remove('refresh-spin');
                }
            },

            filterLedgerLocal() {
                const q = (document.getElementById('ledger-search')?.value || '').toLowerCase().trim();
                this.state.filteredTransactions = (this.state.transactions || []).filter(tx => {
                    if (!q) return true;
                    return (
                        (tx.order || '').toLowerCase().includes(q) ||
                        (tx.utr || '').toLowerCase().includes(q) ||
                        (tx.customerName || '').toLowerCase().includes(q) ||
                        (tx.mode || '').toLowerCase().includes(q)
                    );
                });
                this.renderTransactions();
            },

            renderTransactions() {
                const container = document.getElementById('tx-container');
                if (!container) return;

                const list = this.state.filteredTransactions || [];
                if (!list.length) {
                    container.innerHTML = `
                        <div class="py-12 text-center text-slate-400">
                            <p class="text-xs font-bold">No transactions match the current filter.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(tx => `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3.5 hover:bg-purple-50/40 px-3 rounded-2xl transition-colors gap-2">
                        <div onclick="Terminal.openAuditDrawer('${tx.upaytr}')" class="flex items-center gap-3 cursor-pointer flex-1">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${tx.isPaid ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'} font-black text-xs">
                                ${tx.isPaid ? '✓' : '⏳'}
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <p class="text-xs font-extrabold text-slate-900">${tx.customerName || 'Guest'} • <span class="mono text-[#5f259f]">#${tx.order}</span></p>
                                    <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold ${tx.isPaid ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${tx.isPaid ? 'PAID' : 'PENDING'}</span>
                                </div>
                                <p class="mono text-[10px] text-slate-400">UTR: ${tx.utr || tx.submittedUtr || 'Awaiting Scan'} • Mode: ${tx.mode || 'UPI'} • Redirect: ${tx.redirect || '/pay/thanks'}</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-end gap-2.5">
                            ${!tx.isPaid ? `
                                <a href="/pay/${tx.order}" target="_blank" class="px-2.5 py-1 rounded-lg bg-purple-50 text-[#5f259f] text-[10px] font-extrabold">Checkout &nearr;</a>
                                <button onclick="Terminal.simulateOrderPaid('${tx.order}')" class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-extrabold cursor-pointer">Simulate Paid</button>
                            ` : ''}
                            <span onclick="Terminal.openAuditDrawer('${tx.upaytr}')" class="mono text-sm font-black ${tx.isPaid ? 'text-emerald-600' : 'text-slate-800'} cursor-pointer">
                                ${tx.isPaid ? '+' : ''}₹${Number(tx.amount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}
                            </span>
                        </div>
                    </div>
                `).join('');
            },

            async simulateOrderPaid(order) {
                const res = await fetch('/user/dashboard/simulate-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order })
                });
                const data = await res.json();
                if (data.status) {
                    this.notify(data.message);
                    this.refreshBalance();
                    this.refreshHistory();
                    this.loadPaymentLinks();
                } else {
                    this.notify(data.message, 'warn');
                }
            },

            async openAuditDrawer(upaytr) {
                if (!upaytr) return;
                const res = await fetch(`/user/dashboard/api/transaction/${upaytr}`);
                const data = await res.json();
                if (!data.status) return this.notify(data.message || 'Could not load telemetry', 'warn');

                document.getElementById('drawer-order-id').textContent = `#${data.order}`;
                document.getElementById('drawer-amount').textContent = `₹${Number(data.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
                document.getElementById('drawer-utr').textContent = data.utr;
                document.getElementById('drawer-status-badge').textContent = data.orderStatus;
                document.getElementById('drawer-full-audit-link').href = `/user/dashboard/transaction/${upaytr}`;

                const t = data.telemetry || {};
                const shot = data.dispute?.screenshot || '';
                document.getElementById('drawer-details-grid').innerHTML = `
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-slate-400">Order & Customer Metadata</p>
                        <p><strong>Mode:</strong> ${data.mode} | <strong>Redirect:</strong> <span class="mono">${data.redirect}</span></p>
                        <p><strong>Customer:</strong> ${data.customerName} (${data.customerEmail})</p>
                        <p><strong>Phone:</strong> ${data.customerPhone}</p>
                        <p><strong>Created:</strong> ${data.created_at} | <strong>Paid:</strong> ${data.payment_date}</p>
                        <p><strong>Base:</strong> ₹${data.baseAmount} | <strong>Discount:</strong> -₹${data.discountAmount} | <strong>Tip:</strong> +₹${data.tipAmount} | <strong>Fee:</strong> +₹${data.feeAmount}</p>
                        ${data.customerNote ? `<p><strong>Note:</strong> ${data.customerNote}</p>` : ''}
                    </div>
                    ${data.dispute?.raised ? `
                    <div class="p-3.5 rounded-xl bg-rose-50/70 border border-rose-200 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-rose-600">Dispute & Proof Details (${data.dispute.status})</p>
                        <p><strong>Submitted UTR:</strong> <span class="mono">${data.dispute.utr || data.submittedUtr}</span></p>
                        <p><strong>Customer Query:</strong> ${data.dispute.reason}</p>
                        ${shot ? `<img src="${shot}" onclick="Terminal.previewScreenshotModal('${shot}')" class="mt-2 max-h-36 rounded-xl border border-rose-200 cursor-pointer" title="Click to enlarge">` : ''}
                    </div>
                    ` : ''}
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1.5">
                        <p class="text-[10px] font-extrabold uppercase text-slate-400">Device & Network Telemetry</p>
                        <p><strong>Client IP:</strong> <span class="mono">${t.ip}</span> (${t.isp})</p>
                        <p><strong>Device:</strong> ${t.deviceBrand} ${t.deviceModel} (${t.deviceType})</p>
                        <p><strong>OS / Browser:</strong> ${t.osName} ${t.osVersion} • ${t.browserName}</p>
                        <p><strong>Geo Location:</strong> ${t.city}, ${t.region}, ${t.country} (${t.zip})</p>
                    </div>
                `;

                const overlay = document.getElementById('audit-drawer-overlay');
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
            },

            closeAuditDrawer() {
                const overlay = document.getElementById('audit-drawer-overlay');
                overlay.classList.add('hidden');
                overlay.classList.remove('flex');
            },

            exportLedgerCSV() {
                const rows = this.state.filteredTransactions || [];
                if (!rows.length) return this.notify('No transactions to export', 'warn');
                const headers = ['OrderID', 'Amount', 'Status', 'UTR', 'Mode', 'Redirect', 'CustomerName', 'CustomerEmail', 'CreatedAt'];
                const csv = [
                    headers.join(','),
                    ...rows.map(r => [
                        r.order,
                        r.amount,
                        r.isPaid ? 'PAID' : 'PENDING',
                        r.utr || r.submittedUtr || '',
                        r.mode || 'UPI',
                        r.redirect || '/pay/thanks',
                        `"${(r.customerName || '').replace(/"/g, '""')}"`,
                        r.customerEmail || '',
                        r.created_at || ''
                    ].join(','))
                ].join('\n');

                const blob = new Blob([csv], { type: 'text/csv' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `UPay2_Ledger_${Date.now()}.csv`;
                a.click();
                URL.revokeObjectURL(url);
                this.notify('CSV Ledger Exported!');
            },

            async saveProfile(e) {
                e.preventDefault();
                const data = Object.fromEntries(new FormData(e.target).entries());
                const res = await fetch('/user/dashboard/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            async saveBank(e) {
                e.preventDefault();
                const data = Object.fromEntries(new FormData(e.target).entries());
                const res = await fetch('/user/dashboard/bank', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            async saveSettings(btn) {
                const callback = document.getElementById("callback").value;
                const redirect = document.getElementById("redirect").value;
                const res = await fetch('/user/dashboard/callback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callback, redirect })
                });
                const result = await res.json();
                this.notify(result.message, result.status ? 'success' : 'warn');
            },

            initChart() {
                const canvas = document.getElementById('mainChart');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                if (this.state.chart) this.state.chart.destroy();

                const gradient = ctx.createLinearGradient(0, 0, 0, 240);
                gradient.addColorStop(0, 'rgba(95, 37, 159, 0.22)');
                gradient.addColorStop(1, 'rgba(95, 37, 159, 0.00)');

                this.state.chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            data: [4800, 8200, 6900, 12400, 10900, 16800, 19450],
                            borderColor: '#5f259f',
                            borderWidth: 3,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#5f259f',
                            pointBorderWidth: 2.5,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            tension: 0.38,
                            fill: true,
                            backgroundColor: gradient
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { cornerRadius: 10, padding: 10 } },
                        scales: {
                            y: { display: false },
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: { font: { size: 11, weight: 'bold' }, color: '#64748b' }
                            }
                        }
                    }
                });
            },

            notify(text, type = 'success') {
                Toastify({
                    text: text,
                    duration: 2800,
                    gravity: "top",
                    position: "center",
                    style: {
                        background: type === 'success' ? "linear-gradient(135deg, #5f259f, #7c3aed)" : "#e11d48",
                        borderRadius: "12px",
                        fontSize: "12px",
                        fontWeight: "700",
                        boxShadow: "0 10px 25px -5px rgba(95, 37, 159, 0.35)"
                    }
                }).showToast();
            },

            copy(text) {
                navigator.clipboard.writeText(text);
                this.notify('Copied to Clipboard');
            }
        };

        function openpop() {
            if (typeof UPayDeposit !== 'undefined') {
                const DepositPopup = new UPayDeposit();
                DepositPopup.open();
            }
        }

        window.onload = () => {
            Terminal.init();
            const myMenuItems = [
                { name: "Change Logo / Pic", link: "javascript:Terminal.nav('profile')", isLogout: false },
                { name: "Theme Studio", link: "javascript:Terminal.nav('themes')", isLogout: false },
                { name: "UPI Rails", link: "javascript:Terminal.nav('profile');Terminal.subProfile('paytm')", isLogout: false },
                { name: "Logout", link: "/user/logout", isLogout: true }
            ];
            if (typeof setupDynamicMenu === 'function') {
                setupDynamicMenu('prfl', 'menuc', myMenuItems);
            }
        };
    </script>
</body>
</html>
