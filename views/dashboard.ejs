            cropCaptchaScreenshot(dataUri) {
                if (!dataUri || !dataUri.startsWith('data:image/png')) return Promise.resolve(dataUri);
                return new Promise((resolve) => {
                    const img = new Image();
                    img.onload = () => {
                        try {
                            const w = img.naturalWidth, h = img.naturalHeight;
                            if (w < 250 && h < 120) return resolve(dataUri);
                            const c = document.createElement('canvas');
                            c.width = w; c.height = h;
                            const ctx = c.getContext('2d');
                            ctx.drawImage(img, 0, 0);
                            const { data } = ctx.getImageData(0, 0, w, h);
                            const margin = Math.min(20, Math.floor(Math.min(w, h) * 0.05));
                            const sampleIdx = (margin * w + margin) * 4;
                            const bgR = data[sampleIdx], bgG = data[sampleIdx + 1], bgB = data[sampleIdx + 2];
                            let minX = w, minY = h, maxX = -1, maxY = -1;
                            for (let y = margin; y < h - margin; y++) {
                                for (let x = margin; x < w - margin; x++) {
                                    const i = (y * w + x) * 4;
                                    if (Math.abs(data[i] - bgR) > 20 || Math.abs(data[i + 1] - bgG) > 20 || Math.abs(data[i + 2] - bgB) > 20) {
                                        if (x < minX) minX = x;
                                        if (x > maxX) maxX = x;
                                        if (y < minY) minY = y;
                                        if (y > maxY) maxY = y;
                                    }
                                }
                            }
                            if (maxX <= minX || maxY <= minY) return resolve(dataUri);
                            const pad = 4;
                            const sx = Math.max(0, minX - pad), sy = Math.max(0, minY - pad);
                            const sw = Math.min(w - sx, maxX - minX + 1 + pad * 2);
                            const sh = Math.min(h - sy, maxY - minY + 1 + pad * 2);
                            const out = document.createElement('canvas');
                            out.width = sw; out.height = sh;
                            out.getContext('2d').drawImage(c, sx, sy, sw, sh, 0, 0, sw, sh);
                            resolve(out.toDataURL('image/png'));
                        } catch (e) {
                            resolve(dataUri);
                        }
                    };
                    img.onerror = () => resolve(dataUri);
                    img.src = dataUri;
                });
            },

