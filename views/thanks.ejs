<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo', {
        pageTitle: `Payment Receipt ₹${Number(typeof amount !== 'undefined' ? amount : 1499).toLocaleString('en-IN')} | UPay 2.0 Verified`,
        pageDesc: `Official UPay 2.0 payment receipt for Order #${typeof ORDERID !== 'undefined' ? ORDERID : 'VERIFIED'}.`,
        canonicalUrl: 'https://u-pay-seven.vercel.app/pay/thanks',
        robotsMeta: 'noindex, nofollow'
    }) %>
    <script src="/js/money-loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top center, #ede9fe 0%, #f5f0ff 55%, #f8fafc 100%);
        }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        @media print {
            body { background: #fff !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col items-center justify-center p-4 sm:p-6">

    <main class="w-full max-w-md">
        <div class="bg-white rounded-3xl shadow-2xl border border-purple-100 overflow-hidden relative">
            <div class="bg-gradient-to-r from-[#5f259f] to-[#7c3aed] pt-8 pb-7 px-6 flex flex-col items-center text-center text-white">
                <div class="w-16 h-16 rounded-full bg-emerald-400 text-slate-950 font-black text-3xl flex items-center justify-center mb-3 shadow-lg">
                    ✓
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-extrabold bg-white/15 text-white border border-white/20">
                    UPay 2.0 Verified Receipt
                </span>
                <h1 class="text-2xl font-extrabold mt-2 tracking-tight">Payment Successful</h1>
                <div class="mt-4 flex items-baseline justify-center">
                    <span class="text-2xl font-bold mr-1 text-purple-200">&#8377;</span>
                    <span class="text-4xl sm:text-5xl font-black tracking-tight tabular-nums">
                        <%= Number(typeof amount !== 'undefined' ? amount : 1499).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    </span>
                </div>
            </div>

            <div class="px-7 py-6 bg-white space-y-3.5 text-sm">
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Order Reference</span>
                    <span class="text-slate-800 font-mono text-xs font-extrabold bg-purple-50 border border-purple-100 px-2.5 py-1 rounded-lg">
                        #<%= typeof ORDERID !== 'undefined' ? ORDERID : 'TXN_98421038' %>
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Amount Settled</span>
                    <span class="text-emerald-600 font-extrabold text-xs font-mono">
                        &#8377;<%= Number(typeof amount !== 'undefined' ? amount : 1499).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Payment Rail</span>
                    <span class="text-slate-800 font-extrabold text-xs">UPay 2.0 Instant UPI</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Timestamp</span>
                    <span id="timestamp" class="text-slate-700 font-semibold text-xs"></span>
                </div>
            </div>

            <div class="bg-purple-50/70 px-6 py-4 flex items-center justify-between border-t border-purple-100">
                <p class="text-xs text-[#5f259f] font-extrabold">UPay 2.0 • 256-Bit Verified</p>
                <button type="button" onclick="window.print()" class="no-print text-xs font-extrabold text-[#5f259f] hover:underline cursor-pointer">
                    Print Receipt
                </button>
            </div>
        </div>

        <div class="no-print mt-5">
            <a href="/" class="w-full flex items-center justify-center py-3.5 px-4 bg-[#5f259f] hover:bg-[#4c1d95] text-white text-xs font-extrabold rounded-2xl shadow-lg shadow-purple-200 transition">
                Return to Merchant Home
            </a>
        </div>
    </main>

    <script>
        document.getElementById('timestamp').textContent = new Date().toLocaleString('en-IN');
    </script>
</body>
</html>
